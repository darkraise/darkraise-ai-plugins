#!/usr/bin/env bash
# collect ARM RUN — after a launch: copy the run's session transcripts (with
# their subagents/) from the owner's project directory for the clone into
# out/transcripts/, run the usage-report core (the dforge copy) over that run
# alone, and write out/report.json and out/dispatches.json (the report's
# dispatch counts summed per family). Parameters: README.md.
# Exit: 0 written; 1 failed; 2 usage.
set -uo pipefail

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

usage() { wab_die 2 "usage: collect ARM RUN"; }
[ $# -eq 2 ] || usage
arm=$1 run=$2
wab_check_arm "$arm"
[[ $run =~ ^[A-Za-z0-9_-]+$ ]] || usage
wab_check_root
command -v jq >/dev/null 2>&1 || wab_die 1 "jq is required"
wab_settings_repair || wab_die 1 "cannot remove skipDangerousModePermissionPrompt left by an earlier launch"
command -v node >/dev/null 2>&1 || wab_die 1 "node is required"

dir=$(wab_run_dir "$arm" "$run")
clone="$dir/clone"
[ -f "$dir/arm.json" ] || wab_die 1 "$dir is not prepared: run prepare $arm $run first"
plan=$(jq -r .plan < "$dir/arm.json")
out="$dir/out"
tdir="$out/transcripts"
mkdir -p "$tdir" || wab_die 1 "cannot create $tdir"

# Claude names a project directory after the session's working directory,
# every character other than a letter or digit replaced by a dash.
proj="$WAB_CLAUDE_CONFIG/projects/$(printf '%s' "$clone" | tr -c 'A-Za-z0-9' '-')"
copied=0
while IFS= read -r sid; do
  [ -n "$sid" ] || continue
  if [ ! -f "$proj/$sid.jsonl" ]; then
    wab_log "no transcript for session $sid in $proj"
    continue
  fi
  cp -p "$proj/$sid.jsonl" "$tdir/" || wab_die 1 "cannot copy the transcript of $sid"
  if [ -d "$proj/$sid/subagents" ]; then
    mkdir -p "$tdir/$sid" && cp -Rp "$proj/$sid/subagents" "$tdir/$sid/" \
      || wab_die 1 "cannot copy the subagents of $sid"
  fi
  copied=$((copied + 1))
done < <(tr -d '\r' < "$dir/sessions" 2>/dev/null)
[ "$copied" -gt 0 ] || wab_die 1 "no session transcript of $dir/sessions is in $proj"

state="$clone/.$arm/sdd"
slug=$(basename "$plan" .md)
ledger="$state/$slug/progress.md"
if [ ! -f "$ledger" ]; then
  ledger=$(grep -lF -- "plan: $plan" "$state"/*/progress.md 2>/dev/null | head -n 1)
fi
args=(--transcripts "$tdir" --plan "$clone/$plan" --repo "$clone" --format json)
[ ! -f "$state/usage-markers.tsv" ] || args+=(--markers "$state/usage-markers.tsv")
[ -z "$ledger" ] || [ ! -f "$ledger" ] || args+=(--ledger "$ledger" --workspace "$(dirname "$ledger")")
spec=$(sed -n -E 's/^\*\*Spec:\*\*[ \t]*`?([^` \t]+).*/\1/p' "$clone/$plan" 2>/dev/null | head -n 1)
if [ -n "$spec" ]; then
  register=$(grep -lF -- "$(basename "$spec")" $(grep -l '^\*\*Covers:\*\*' "$clone/docs/$arm/registers"/*.md 2>/dev/null) /dev/null 2>/dev/null | head -n 1)
  [ -z "$register" ] || args+=(--register "$register")
fi
[ ! -f "$clone/docs/$arm/reviews/$slug.md" ] || args+=(--review-record "$clone/docs/$arm/reviews/$slug.md")

core="$WAB_PLUGINS/plugins/dforge/scripts/lib/usage-report.mjs"
node "$core" "${args[@]}" > "$out/report.json.tmp" && [ -s "$out/report.json.tmp" ] \
  || { rm -f "$out/report.json.tmp"; wab_die 1 "the usage report failed for $dir"; }
mv -f "$out/report.json.tmp" "$out/report.json"
jq '[.plans[].tasks[].dispatches // {} | to_entries[]] | group_by(.key)
  | map({key: .[0].key, value: (map(.value) | add)}) | from_entries' < "$out/report.json" > "$out/dispatches.json" \
  || wab_die 1 "cannot write $out/dispatches.json"
wab_log "collected $dir: $copied transcript(s), out/report.json, out/dispatches.json"
