{
  "description": "At session start, adds two lines naming the active plan and the next step, plus the task in progress after a compaction; before a compaction, tells the summary what a build in progress needs kept; at each stop, flushes the darkmem projection in the background.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/dflow\" hook session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/dflow\" hook pre-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/dflow\" hook stop",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ]
  }
}
