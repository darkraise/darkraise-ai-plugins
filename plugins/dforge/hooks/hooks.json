{
  "description": "Loads the cockpit mod, injects the dforge entry point at session start, and runs darkmem's reconcile and pull at session start and its push at each stop for a repository mapped to darkmem; after an edit to a UI file it returns UI lint findings and names the ui-ux skill once per session, and it holds a stop once when a turn leaves UI changes without a passing UI proof.",
  "modules": [
    "./cockpit/register.tsx"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"",
            "shell": "bash",
            "async": false,
            "timeout": 300
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/turn-start.sh\"",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/ui-edit-hook.sh\"",
            "shell": "bash",
            "async": false,
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/darkmem-stop-push.sh\"",
            "shell": "bash",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/ui-turn-end.sh\"",
            "shell": "bash",
            "async": false,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
