#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context. The brief ends with the plan header's
# Global Constraints and Contracts, so every reader of the brief sees the
# cross-task names it uses. --header writes the whole header instead.
# Amendments in <workspace>/amendments.md are applied first.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
#        task-brief --header PLAN_FILE [OUTFILE]
# Default OUTFILE: <repo-root>/.dforge/sdd/<plan-basename>/task-<N>-brief.md
# or .../plan-header.md (per plan and per worktree; concurrent runs of the SAME
# plan in the same working tree share it).
# Exit: 0 ok; 2 usage; 3 no such task; 4 an amendment does not apply.
# Last output line: the session budget line from scripts/context-size.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/plan.sh"

header=0
if [ "${1:-}" = "--header" ]; then header=1; shift; fi
if { [ "$header" -eq 1 ] && { [ $# -lt 1 ] || [ $# -gt 2 ]; }; } \
   || { [ "$header" -eq 0 ] && { [ $# -lt 2 ] || [ $# -gt 3 ]; }; }; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE] | task-brief --header PLAN_FILE [OUTFILE]" >&2
  exit 2
fi

plan=$(plan_locate "$1")
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
dforge_stores_init "$(_plan_ctx "$plan")"
if [ "$header" -eq 1 ]; then n="" given=${2:-}; else n=$2 given=${3:-}; fi

if [ -n "$given" ]; then
  out=$given
else
  dir=$(bash "$HERE/sdd-workspace" "$plan")
  if [ "$header" -eq 1 ]; then out="$dir/plan-header.md"; else out="$dir/task-${n}-brief.md"; fi
fi

src=$(mktemp)
trap 'rm -f "$src" "$src.err"' EXIT
if ! plan_apply_amendments "$plan" "$(plan_amendments_file "$plan")" > "$src" 2> "$src.err"; then
  cat "$src.err" >&2
  exit 4
fi

# Mixed mode: an inline plan delegates the tasks plan_delegated names - heavy
# tasks and tasks carrying an Executor line. The kind is interpolated, so a new
# row kind needs no change here. The lines are computed here so an executing
# session never re-scores a task.
dispatch=0
if ! grep -qE '^(\*\*)?Host:(\*\*)?[ \t]+codex[ \t]*$' <<<"$(plan_header "$src")" \
   && grep -qE '^\*\*Execution:\*\*[ \t]*`?inline' <<<"$(plan_header_line "$src" Execution)"; then
  dispatch=1
fi
delegated=""
[ "$dispatch" -eq 0 ] || delegated=$(plan_delegated "$src")

if [ "$header" -eq 1 ]; then
  plan_header "$src" > "$out"
  if [ -n "$delegated" ]; then
    printf '**Dispatch:** delegated — %s\n' \
      "$(awk -F'\t' '{ printf "%sTask %s (%s)", (NR > 1 ? ", " : ""), $1, $2 }' <<<"$delegated")" >> "$out"
  fi
else
  if ! plan_task_text "$src" "$n" > "$out"; then
    echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
    exit 3
  fi
  # Captured, not piped: grep -q exits at its first match, and under pipefail the
  # writer's SIGPIPE would decide the if.
  if [ -n "$delegated" ] && grep -qxF "$n" <<<"$(cut -f1 <<<"$delegated")"; then
    row=$(plan_scores "$src" | awk -F'\t' -v n="$n" '$1 == n')
    t=$(cut -f2 <<<"$row") r=$(cut -f3 <<<"$row")
    awk -v d="**Dispatch:** delegated — total $t, risk $r" 'NR == 1 { print; print d; next } { print }' "$out" > "$out.tmp"
    mv "$out.tmp" "$out"
  fi
  excerpt=$(plan_header "$src" | awk "$_PLAN_AWK"'in_fence($0) { if (on) print; next } /^## / { h = $0; sub(/[ \t]+$/, "", h); on = (h == "## Global Constraints" || h == "## Contracts") } on { print }')
  if [ -n "$excerpt" ]; then
    printf '\n## Plan header excerpt\n\n%s\n' "$excerpt" >> "$out"
  fi
  # dforge:ui-ux — a UI task's brief carries the contract items it delivers,
  # verbatim from the spec, so the implementer builds the states and
  # behaviour, not only the layout.
  ui_line=$(plan_task_text "$src" "$n" | plan_lines 'UI/UX' | head -n 1)
  if [ -n "$ui_line" ]; then
    . "$HERE/lib/ui-ux.sh"
    ui_spec=$(plan_header_line "$src" Spec | sed -E 's/^\*\*Spec:\*\*[ \t]*(`([^`]+)`|([^ \t]+)).*/\2\3/')
    ui_file=$(dforge_resolve "$ui_spec" "$(_plan_ctx "$plan")")
    ui_ids=$( { grep -oE '(UI|UX|OP)-[0-9]+' <<<"$ui_line" || true; } | tr '\n' ' ')
    ui_items=""
    # shellcheck disable=SC2086
    [ ! -f "$ui_file" ] || ui_items=$(uiux_items "$ui_file" "UI/UX contract" $ui_ids)
    printf '\n## UI/UX contract items\n\nFrom `%s`, verbatim. Build every state, behaviour and promise below, render the result through the project UI profile'"'"'s harness before you report, and map each ID to its evidence (a screenshot path or a test name) in your report.\n\n%s\n' \
      "$ui_spec" "${ui_items:-(the spec defines none of: $ui_ids)}" >> "$out"
  fi
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"

# The budget line rides on a call the controller already makes before every
# task, so checking the session budget costs no extra request. It must never
# fail the brief.
# --header mode has no task number; --observations ignores the header rows.
# Before one of the plan's last tasks the line says so (context-size --tail):
# finishing a short tail here costs less than a fresh session's baseline and
# reload. Remaining tasks are the plan's tasks with no complete line in this
# checkout's ledger, the briefed one included.
budget_mode=()
if [ -n "$n" ]; then
  . "$HERE/lib/context.sh"
  read -r -a budget_mode <<<"$(ctx_plan_mode "$src" "$(dforge_ledger_dir "$(basename "$plan" .md)")/progress.md")"
fi
DFORGE_BUDGET_CALLER="task-brief:${n:-header}" bash "$HERE/context-size" ${budget_mode[@]+"${budget_mode[@]}"} 2>/dev/null || true
