#!/usr/bin/env bash
# Run the local commands of a plan's **CI:** line through suite-run, from the
# checkout's top level, so the final review sees the CI commands' verdicts at
# this HEAD and a later gate with the same command reuses the pass.
#
# Usage: ci-mirror PLAN_FILE
# Output: for `**CI:** none`, the one line "ci: none". Otherwise one line per
#         local command, in order,
#           ci: <cmd> — <the suite-run verdict line without its "suite: " prefix>
#         then "uncovered: <platforms or none>". A failed command's whole
#         suite-run output, the log path included, goes to stderr.
# Exit: 0 when every command passed or reused a pass (and for none); 1 when any
# command failed or could not launch, its line then reading
# "ci: <cmd> — FAIL (exit <code>)"; 2 on a usage error, an unreadable plan, a
# missing or malformed **CI:** line, or commands to run outside a git checkout.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/plan.sh"

die() { printf 'ci-mirror: %s\n' "$1" >&2; exit 2; }

[ $# -eq 1 ] || { printf 'usage: ci-mirror PLAN_FILE\n' >&2; exit 2; }
plan=$1
[ -f "$plan" ] && [ -r "$plan" ] || die "cannot read $plan"

line=$(plan_header_line "$plan" CI)
line=${line%$'\r'}
[ -n "$line" ] || die "no **CI:** line in $plan"

trim() { # trim TEXT
  local t=$1
  t=${t#"${t%%[![:space:]]*}"}
  t=${t%"${t##*[![:space:]]}"}
  printf '%s' "$t"
}

malformed() { die "malformed **CI:** line"; }

text=$(trim "${line#'**CI:**'}")
if [ "$text" = none ]; then
  printf 'ci: none\n'
  exit 0
fi

# The grammar, in order: `<workflow files>` — platforms: <list> —
# local: `<cmd>`; `<cmd>` — uncovered: <platforms or none>. The local spans are
# read one at a time rather than split on separators, so a command may itself
# hold " — " or "; ".
rest=$text
[ "${rest:0:1}" = '`' ] || malformed
rest=${rest:1}
case $rest in *'`'*) ;; *) malformed ;; esac
[ -n "${rest%%'`'*}" ] || malformed
rest=${rest#*'`'}

case $rest in ' — platforms: '*) ;; *) malformed ;; esac
rest=${rest#' — platforms: '}
case $rest in *' — local: '*) ;; *) malformed ;; esac
[ -n "$(trim "${rest%%' — local: '*}")" ] || malformed
rest=${rest#*' — local: '}

cmds=()
while :; do
  [ "${rest:0:1}" = '`' ] || malformed
  rest=${rest:1}
  case $rest in *'`'*) ;; *) malformed ;; esac
  cmd=${rest%%'`'*}
  [ -n "$cmd" ] || malformed
  cmds+=("$cmd")
  rest=${rest#*'`'}
  case $rest in
    '; '*) rest=${rest#'; '} ;;
    ' — uncovered: '*) rest=${rest#' — uncovered: '}; break ;;
    *) malformed ;;
  esac
done
uncovered=$(trim "$rest")
[ -n "$uncovered" ] || malformed

top=$(git rev-parse --show-toplevel 2>/dev/null | tr -d '\r')
[ -n "$top" ] || die "not in a git checkout"
cd "$top" || die "cannot enter $top"

status=0
for cmd in "${cmds[@]}"; do
  out=$(bash "$HERE/suite-run" -- bash -c "$cmd" 2>&1)
  code=$?
  verdict=$(printf '%s\n' "$out" | tr -d '\r' | sed -n 's/^suite: //p' | head -n 1)
  # No verdict line means suite-run stopped before running the command.
  if [ -z "$verdict" ]; then
    verdict="FAIL (exit $code)"
  elif [ "$code" -ne 0 ]; then
    case $verdict in FAIL*) ;; *) verdict="FAIL (exit $code)" ;; esac
  fi
  printf 'ci: %s — %s\n' "$cmd" "$verdict"
  case $verdict in
    FAIL*)
      printf '%s\n' "$out" >&2
      status=1 ;;
  esac
done

printf 'uncovered: %s\n' "$uncovered"
exit "$status"
