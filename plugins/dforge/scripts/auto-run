#!/usr/bin/env bash
# An auto run's state (reference/auto-run.md).
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/context.sh"
. "$HERE/lib/auto-run.sh"

usage() {
  cat >&2 <<'EOF'
usage: auto-run [--session ID] start --spec P [--register R] [--force]
       auto-run [--session ID] status | pending | task-complete | resumed | switch | stalled
       auto-run [--session ID] compacted [--switch]
       auto-run [--session ID] attach --plan P
       auto-run [--session ID] phase spec|plan|execute|final|finish
       auto-run [--session ID] clear [--phase]
       auto-run [--session ID] rebind --to ID
       auto-run [--session ID] failure [--reason TEXT]
       auto-run [--session ID] decision add --id ID --question Q [--options O] [--opus-reason R] [--task N]
       auto-run [--session ID] decision list | decision clear [--id ID]
       auto-run [--session ID] ruling add TEXT | ruling list
       auto-run [--session ID] stop [--reason TEXT]
       auto-run [--session ID] verdict --tokens T --budget B --window W [--wave N]
       auto-run [--session ID] after-compact
pending prints compact, after-compact, handoff, clear, resume, switch, switch-resume or none.
clear --phase is the switch from inline to subagent mode and never a self-resume; a plain
      clear is one, and the third in a row stops the run (exit 5).
Exit: 0 done; 1 failed (no handoff file, or jq or mktemp failed); 2 usage; 3 no run bound to this session;
      4 refused; 5 the run stopped, or handoff; 6 compact.
EOF
  exit 2
}

command -v "${DFORGE_JQ:-jq}" >/dev/null 2>&1 || { echo "auto-run: jq is required" >&2; exit 2; }

AR_SESSION=${CLAUDE_CODE_SESSION_ID:-}
if [ "${1:-}" = --session ]; then
  [ $# -ge 2 ] && [ -n "$2" ] || usage
  AR_SESSION=$2
  shift 2
fi
export AR_SESSION
[ $# -ge 1 ] || usage
cmd=$1
shift

bound() { ar_bound || { echo "auto-run: no auto run is bound to this session" >&2; exit 3; }; }
reason_arg() { # sets reason from [--reason TEXT]
  reason=""
  if [ "${1:-}" = --reason ]; then
    [ $# -eq 2 ] || usage
    reason=$2
  else
    [ $# -eq 0 ] || usage
  fi
}

case $cmd in
  start)
    spec="" register="" force=0
    while [ $# -gt 0 ]; do
      case $1 in
        --spec) [ $# -ge 2 ] || usage; spec=$2; shift 2 ;;
        --register) [ $# -ge 2 ] || usage; register=$2; shift 2 ;;
        --force) force=1; shift ;;
        *) usage ;;
      esac
    done
    [ -n "$spec" ] || usage
    [ -n "$AR_SESSION" ] || { echo "auto-run: no session id; CLAUDE_CODE_SESSION_ID is unset and no --session was given" >&2; exit 2; }
    ar_start "$spec" "$register" "$force"
    ;;
  status) [ $# -eq 0 ] || usage; bound; ar_status ;;
  pending) [ $# -eq 0 ] || usage; bound; ar_pending ;;
  attach)
    [ $# -eq 2 ] && [ "$1" = --plan ] && [ -n "$2" ] || usage
    bound; ar_update '.plan = $p' --arg p "$2"
    ;;
  phase)
    [ $# -eq 1 ] || usage
    case $1 in spec|plan|execute|final|finish) ;; *) usage ;; esac
    bound; ar_set_phase "$1"
    ;;
  task-complete) [ $# -eq 0 ] || usage; bound; ar_task_complete ;;
  stalled) [ $# -eq 0 ] || usage; bound; ar_stalled ;;
  clear)
    case "$#:${1:-}" in
      0:) bound; ar_clear 0 ;;
      1:--phase) bound; ar_clear 1 ;;
      *) usage ;;
    esac
    ;;
  rebind)
    [ $# -eq 2 ] && [ "$1" = --to ] && [ -n "$2" ] || usage
    ar_rebind "$2"
    ;;
  resumed) [ $# -eq 0 ] || usage; bound; ar_resumed ;;
  compacted)
    case "$#:${1:-}" in
      0:) bound; ar_compacted ;;
      1:--switch) bound; ar_compacted --switch ;;
      *) usage ;;
    esac
    ;;
  switch) [ $# -eq 0 ] || usage; bound; ar_switch ;;
  failure) reason_arg "$@"; bound; ar_failure "$reason" ;;
  decision)
    [ $# -ge 1 ] || usage
    sub=$1
    shift
    case $sub in
      add)
        id="" question="" options="" opus="" task=""
        while [ $# -gt 0 ]; do
          [ $# -ge 2 ] || usage
          case $1 in
            --id) id=$2 ;;
            --question) question=$2 ;;
            --options) options=$2 ;;
            --opus-reason) opus=$2 ;;
            --task) task=$2 ;;
            *) usage ;;
          esac
          shift 2
        done
        [ -n "$id" ] && [ -n "$question" ] || usage
        bound; ar_decision_add "$id" "$question" "$options" "$opus" "$task"
        ;;
      list) [ $# -eq 0 ] || usage; bound; ar_decision_list ;;
      clear)
        case "$#:${1:-}" in
          0:) bound; ar_decision_clear ;;
          2:--id) bound; ar_decision_clear "$2" ;;
          *) usage ;;
        esac
        ;;
      *) usage ;;
    esac
    ;;
  ruling)
    case "$#:${1:-}" in
      2:add) [ -n "$2" ] || usage; bound; ar_ruling_add "$2" ;;
      1:list) bound; ar_ruling_list ;;
      *) usage ;;
    esac
    ;;
  verdict)
    tokens="" budget="" window="" n=1
    while [ $# -gt 0 ]; do
      [ $# -ge 2 ] || usage
      case $1 in
        --tokens) tokens=$2 ;;
        --budget) budget=$2 ;;
        --window) window=$2 ;;
        --wave) n=$2 ;;
        *) usage ;;
      esac
      shift 2
    done
    for v in "$tokens" "$budget" "$window" "$n"; do [[ $v =~ ^[0-9]+$ ]] || usage; done
    [ "$n" -ge 1 ] || usage
    bound
    out=$(ar_verdict "$tokens" "$budget" "$window" "$n") || exit $?
    echo "$out"
    case ${out%% *} in compact) exit 6 ;; handoff) exit 5 ;; esac
    ;;
  after-compact)
    [ $# -eq 0 ] || usage
    bound
    pending=$(ar_get pending)
    case $pending in
      clear | handoff)
        echo "handoff — a $pending is already in progress; follow reference/auto-run.md §Clears"
        exit 5
        ;;
    esac
    # Measure the session the run is bound to, whatever the environment says.
    export CLAUDE_CODE_SESSION_ID=$AR_SESSION
    model="" tokens=""
    if ctx_have_jq && ctx_find_transcript; then
      model=$(ctx_model "$CTX_TRANSCRIPT")
      tokens=$(ctx_measure "$CTX_TRANSCRIPT") || tokens=""
    fi
    budget=$(ctx_pinned_budget)
    [ -n "$budget" ] || budget=$(ctx_budget "$model")
    window=$(ctx_window "$model")
    due=""
    [ "$(ar_get setupDue)" != true ] || due="; setup due: begin at the execution skill's Setup, worktree first"
    if [ -z "$tokens" ]; then
      [ "$pending" != after-compact ] || ar_update '.pending = null' || exit $?
      echo "continue — the size after compaction is unknown; record that with auto-run ruling add, and Claude Code's own compaction stays the backstop$due"
      exit 0
    fi
    # Only a booked compaction is settled into the run; any other pending
    # action (a resume, a stale call) is measured and left as it is.
    if [ "$pending" = after-compact ]; then
      result=$(ar_settle "$tokens" "$budget" "$window") || exit $?
      regime=$(ar_get regime)
    else
      regime=$(ar_after "$tokens" "$budget" "$window")
      if [ "$regime" = handoff ] && ! ar_holds_session; then result=handoff regime=$(ar_get regime)
      else
        result=continue
        [ "$regime" != handoff ] || regime=$(ar_get regime)
      fi
    fi
    [ "$result" = continue ] || due=""
    echo "$result — $(( (tokens + 500) / 1000 ))k after compaction; regime $regime$due"
    [ "$result" = continue ] || exit 5
    ;;
  stop) reason_arg "$@"; bound; ar_stop "$reason" ;;
  *) usage ;;
esac
