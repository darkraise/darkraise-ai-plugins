#!/usr/bin/env bash
# An auto run's state (reference/auto-run.md).
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"

# With no state file there is no run to answer for, so pending (every Stop)
# and status (every task-close) say so before the libraries load. The path is
# ar_path's: the primary checkout's state directory.
fast_cmd=${1:-} fast_n=$#
if [ "$fast_cmd" = --session ] && [ $# -ge 3 ] && [ -n "$2" ]; then fast_cmd=$3 fast_n=$(($# - 2)); fi
# A caller with a binding may have its run in another checkout, and outside
# a repository only the binding can find it.
case "$fast_cmd:$fast_n" in
  pending:1 | status:1)
    . "$HERE/lib/dforge-dir.sh"
    fast_sid=${CLAUDE_CODE_SESSION_ID:-}
    [ "${1:-}" != --session ] || fast_sid=${2:-}
    if fast_common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null | tr -d '\r') \
       && fast_primary=$(git -C "$(dirname "$fast_common")" rev-parse --show-toplevel 2>/dev/null | tr -d '\r') \
       && [ -n "$fast_primary" ] && [ ! -f "$(dforge_dir state "$fast_primary")/sdd/auto-run.json" ] \
       && { [ "${AR_RESOLVE:-}" = local ] || [ -z "$fast_sid" ] \
            || [ ! -f "${HOME:-}/.claude/dforge/sessions/run/$(printf '%s' "$fast_sid" | tr -c 'A-Za-z0-9' '-').json" ]; }; then
      echo "auto-run: no auto run is bound to this session" >&2
      exit 3
    fi
    ;;
esac

. "$HERE/lib/context.sh"
. "$HERE/lib/auto-run.sh"
. "$HERE/lib/usage-marker.sh"

usage() {
  cat >&2 <<'EOF'
usage: auto-run [--session ID] start --spec P [--register R] [--isolation worktree|in-place] [--force]
       auto-run [--session ID] resume
       auto-run [--session ID] status | pending | task-complete | resumed | switch | stalled | carried
       auto-run [--session ID] cd-prefix [--dir DIR]
       auto-run [--session ID] setup-branch NAME
       auto-run [--session ID] compacted [--seconds N]
       auto-run [--session ID] attach --plan P
       auto-run [--session ID] phase spec|plan|execute|final|finish
       auto-run [--session ID] clear [--phase]
       auto-run [--session ID] rebind --to ID
       auto-run [--session ID] failure [--reason TEXT]
       auto-run [--session ID] decision add --id ID --question Q [--options O] [--opus-reason R] [--task N]
       auto-run [--session ID] decision list | decision clear [--id ID]
       auto-run [--session ID] ruling add TEXT | ruling list
       auto-run [--session ID] stop [--reason TEXT] | stop --stale
       auto-run [--session ID] after-compact
       auto-run [--session ID] review-skip FAMILY [--until EPOCH] | review-skipped FAMILY
       auto-run [--session ID] api-error [--clear]
       auto-run [--session ID] total compactionSeconds|holds|stalls|apiErrors|reconcilePrompts|panelFailures
       auto-run [--session ID] counters | log
       auto-run preflight --isolation worktree|in-place
pending prints compact, after-compact, handoff, clear, resume, switch or none.
clear --phase is for a phase transition (the switch or finishing) and never a
      self-resume; a plain clear is one, and the third in a row stops the run
      (exit 5).
stop --stale stops a run whose owner session is gone, from any session, and
      prints its pending decisions and rulings; exit 3 while the owner lives.
api-error counts a turn that ended on an API error; the tenth in a row stops
      the run (exit 5). --clear and task-complete reset the count.
total adds one to a run total of an active run, bound or not (hooks book
      them); counters prints the totals, bound or not; log prints the run
      log of this checkout, bound or not (exit 3 when there is none).
cd-prefix prints "cd '<checkout>' && " when the run's checkout (or DIR) is
      outside the directory this session started in, and nothing otherwise.
task-complete, phase execute|final|finish, setup-branch, clear and switch
      change nothing outside the run's repository: they exit 7 and print the
      command to run instead.
preflight prints what would stop an unattended run (free space below
      DFORGE_PREFLIGHT_FREE percent, default 15; a refused git write; with
      --isolation worktree a refused scratch worktree), or preflight: ok, then
      one line per review family; it needs no run and exits 0.
review-skipped exits 0 while the review family is skipped after a quota
      failure (review-skip records one), 1 when it is not.
Exit: 0 done; 1 failed (no handoff file, or jq or mktemp failed); 2 usage; 3 no run bound to this session;
      4 refused; 5 the run stopped, or handoff; 6 compact; 7 run from another checkout: run the printed command.
EOF
  exit 2
}

command -v "${DFORGE_JQ:-jq}" >/dev/null 2>&1 || { echo "auto-run: jq is required" >&2; exit 2; }

AR_SESSION=${CLAUDE_CODE_SESSION_ID:-}
if [ "${1:-}" = --session ]; then
  [ $# -ge 2 ] && [ -n "$2" ] || usage
  AR_SESSION=$2
  shift 2
fi
export AR_SESSION
[ $# -ge 1 ] || usage
cmd=$1
shift
# These act on the working directory's run, never on one a binding names.
case "$cmd:${1:-}" in start:* | resume:* | stop:--stale) export AR_RESOLVE=local ;; esac

# Needs no run: it runs before the spec review that starts one.
if [ "$cmd" = preflight ]; then
  [ $# -eq 2 ] && [ "$1" = --isolation ] && { [ "$2" = worktree ] || [ "$2" = in-place ]; } \
    || { echo "auto-run: --isolation must be worktree or in-place" >&2; exit 2; }
  . "$HERE/lib/preflight.sh"
  preflight_run "$2"
  exit 0
fi

case $cmd in start | stop | resume) ;; *) ar_version_check ;; esac

bound() { ar_bound || { echo "auto-run: no auto run is bound to this session" >&2; exit 3; }; }
# api_rungs — "api rungs: off" when the Decisions API is off and every API
# budget cap is 0, so a ruling's rungs 1 and 2 have nothing to call. Settings
# that cannot be read print nothing, and the session runs the rungs as before.
api_rungs() {
  local json
  if [ -n "${DFORGE_NO_SETTINGS:-}" ]; then echo "api rungs: off"; return 0; fi
  json=$(bash "$HERE/dforge-config" get --json 2>/dev/null) || return 0
  ar_jq -e '(.decisionApi // "off") == "off"
    and ([.apiBudgetAnthropic, .apiBudgetOpenai, .apiBudgetAgentRouter]
      | map(((. // 0) | tonumber?) // 0) | all(. == 0))' <<<"$json" >/dev/null 2>&1 || return 0
  echo "api rungs: off"
}
reason_arg() { # sets reason from [--reason TEXT]
  reason=""
  if [ "${1:-}" = --reason ]; then
    [ $# -eq 2 ] || usage
    reason=$2
  else
    [ $# -eq 0 ] || usage
  fi
}

case $cmd in
  start)
    spec="" register="" force=0 isolation=worktree
    while [ $# -gt 0 ]; do
      case $1 in
        --spec) [ $# -ge 2 ] || usage; spec=$2; shift 2 ;;
        --register) [ $# -ge 2 ] || usage; register=$2; shift 2 ;;
        --isolation) [ $# -ge 2 ] || usage; isolation=$2; shift 2 ;;
        --force) force=1; shift ;;
        *) usage ;;
      esac
    done
    [ -n "$spec" ] || usage
    case $isolation in
      worktree | in-place) ;;
      *) echo "auto-run: --isolation must be worktree or in-place" >&2; exit 2 ;;
    esac
    [ -n "$AR_SESSION" ] || { echo "auto-run: no session id; CLAUDE_CODE_SESSION_ID is unset and no --session was given" >&2; exit 2; }
    ar_start "$spec" "$register" "$force" "$isolation"
    ;;
  resume)
    [ $# -eq 0 ] || usage
    [ -n "$AR_SESSION" ] || { echo "auto-run: no session id; CLAUDE_CODE_SESSION_ID is unset and no --session was given" >&2; exit 2; }
    ar_resume
    ;;
  status) [ $# -eq 0 ] || usage; bound; ar_status && api_rungs ;;
  pending) [ $# -eq 0 ] || usage; bound; ar_pending ;;
  attach)
    [ $# -eq 2 ] && [ "$1" = --plan ] && [ -n "$2" ] || usage
    bound; ar_update '.plan = $p' --arg p "$2"
    ;;
  phase)
    [ $# -eq 1 ] || usage
    case $1 in spec|plan|execute|final|finish) ;; *) usage ;; esac
    bound
    case $1 in execute | final | finish) ar_require_checkout || exit 7 ;; esac
    ar_set_phase "$1"
    ;;
  task-complete) [ $# -eq 0 ] || usage; bound; ar_require_checkout || exit 7; ar_task_complete ;;
  cd-prefix)
    [ $# -eq 0 ] || { [ $# -eq 2 ] && [ "$1" = --dir ] && [ -n "$2" ]; } || usage
    bound; ar_cd_prefix "${2:-}"
    ;;
  review-skip)
    [ $# -ge 1 ] && [ -n "$1" ] || usage
    family=$1 until=""
    shift
    if [ $# -gt 0 ]; then
      [ $# -eq 2 ] && [ "$1" = --until ] && [[ $2 =~ ^[0-9]+$ ]] || usage
      until=$2
    fi
    bound; ar_review_skip "$family" "$until"
    ;;
  review-skipped) [ $# -eq 1 ] && [ -n "$1" ] || usage; bound; ar_review_skipped "$1" ;;
  setup-branch) [ $# -eq 1 ] && [ -n "$1" ] || usage; bound; ar_require_checkout || exit 7; ar_setup_branch "$1" ;;
  carried) [ $# -eq 0 ] || usage; bound; ar_carried ;;
  stalled) [ $# -eq 0 ] || usage; bound; ar_stalled ;;
  api-error)
    case "$#:${1:-}" in
      0:) bound; ar_api_error ;;
      1:--clear) bound; ar_api_error --clear ;;
      *) usage ;;
    esac
    ;;
  clear)
    case "$#:${1:-}" in
      0:) bound; ar_require_checkout || exit 7; ar_clear 0 ;;
      1:--phase) bound; ar_require_checkout || exit 7; ar_clear 1 ;;
      *) usage ;;
    esac
    ;;
  rebind)
    [ $# -eq 2 ] && [ "$1" = --to ] && [ -n "$2" ] || usage
    ar_rebind "$2"
    ;;
  resumed) [ $# -eq 0 ] || usage; bound; ar_resumed ;;
  compacted)
    case "$#:${1:-}" in
      0:) bound; ar_compacted ;;
      2:--seconds) [[ $2 =~ ^[0-9]+$ ]] || usage; bound; ar_compacted --seconds "$2" ;;
      *) usage ;;
    esac
    ;;
  total)
    [ $# -eq 1 ] || usage
    case $1 in compactionSeconds | holds | stalls | apiErrors | reconcilePrompts | panelFailures) ;; *) usage ;; esac
    ar_total "$1" || { echo "auto-run: no auto run in this checkout" >&2; exit 3; }
    ;;
  counters) [ $# -eq 0 ] || usage; ar_counters || { echo "auto-run: no auto run in this checkout" >&2; exit 3; } ;;
  log)
    [ $# -eq 0 ] || usage
    log=$(ar_path 2>/dev/null) && log="$(dirname "$log")/auto-run-log.tsv" && [ -f "$log" ] \
      || { echo "auto-run: no run log in this checkout" >&2; exit 3; }
    tr -d '\r' < "$log"
    ;;
  switch) [ $# -eq 0 ] || usage; bound; ar_require_checkout || exit 7; ar_switch ;;
  failure) reason_arg "$@"; bound; ar_failure "$reason" ;;
  decision)
    [ $# -ge 1 ] || usage
    sub=$1
    shift
    case $sub in
      add)
        id="" question="" options="" opus="" task=""
        while [ $# -gt 0 ]; do
          [ $# -ge 2 ] || usage
          case $1 in
            --id) id=$2 ;;
            --question) question=$2 ;;
            --options) options=$2 ;;
            --opus-reason) opus=$2 ;;
            --task) task=$2 ;;
            *) usage ;;
          esac
          shift 2
        done
        [ -n "$id" ] && [ -n "$question" ] || usage
        bound; ar_decision_add "$id" "$question" "$options" "$opus" "$task"
        ;;
      list) [ $# -eq 0 ] || usage; bound; ar_decision_list ;;
      clear)
        case "$#:${1:-}" in
          0:) bound; ar_decision_clear ;;
          2:--id) bound; ar_decision_clear "$2" ;;
          *) usage ;;
        esac
        ;;
      *) usage ;;
    esac
    ;;
  ruling)
    case "$#:${1:-}" in
      2:add) [ -n "$2" ] || usage; bound; ar_ruling_add "$2" ;;
      1:list) bound; ar_ruling_list ;;
      *) usage ;;
    esac
    ;;
  after-compact)
    [ $# -eq 0 ] || usage
    bound
    pending=$(ar_get pending)
    case $pending in
      clear | handoff)
        echo "handoff — a $pending is already in progress; follow reference/auto-run.md §Clears"
        exit 5
        ;;
    esac
    # Measure the session the run is bound to, whatever the environment says.
    export CLAUDE_CODE_SESSION_ID=$AR_SESSION
    model="" tokens=""
    if ctx_have_jq && ctx_find_transcript; then
      model=$(ctx_model "$CTX_TRANSCRIPT")
      tokens=$(ctx_measure "$CTX_TRANSCRIPT") || tokens=""
    fi
    ctx_window_prime "$model"
    window=$(ctx_window "$model") || window=""
    due=""
    [ "$(ar_get setupDue)" != true ] || due="; setup due: begin at the execution skill's Setup, workspace first"
    if [ -z "$tokens" ]; then
      [ "$pending" != after-compact ] || ar_update '.pending = null' || exit $?
      echo "continue — the size after compaction is unknown; record that with auto-run ruling add, and Claude Code's own compaction stays the backstop$due"
      exit 0
    fi
    if [ -z "$window" ]; then
      [ "$pending" != after-compact ] || ar_update '.pending = null' || exit $?
      echo "continue — the model's window is unknown, so no size-based handoff applies; Claude Code's own compaction stays the backstop$due"
      exit 0
    fi
    budget=$(ctx_pinned_budget)
    [ -n "$budget" ] || budget=$(ctx_budget "$model")
    # Only a booked compaction is settled into the run; any other pending
    # action (a resume, a stale call) is measured and left as it is.
    if [ "$pending" = after-compact ]; then
      result=$(ar_settle "$tokens" "$budget" "$window") || exit $?
      regime=$(ar_get regime)
    else
      regime=$(ar_after "$tokens" "$budget" "$window")
      if [ "$regime" = handoff ] && ! ar_holds_session; then result=handoff regime=$(ar_get regime)
      else
        result=continue
        [ "$regime" != handoff ] || regime=$(ar_get regime)
      fi
    fi
    [ "$result" = continue ] || due=""
    echo "$result — $(( (tokens + 500) / 1000 ))k after compaction; regime $regime$due"
    [ "$result" = continue ] || exit 5
    ;;
  stop)
    if [ "${1:-}" = --stale ]; then
      [ $# -eq 1 ] || usage
      ar_stop_stale
    else
      reason_arg "$@"; bound; ar_stop "$reason"
    fi
    ;;
  *) usage ;;
esac
