#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
# Default OUTFILE: <repo-root>/.dforge/sdd/<plan-basename>/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
# Last output line: the session budget line from scripts/context-size.
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/lib/plan.sh"

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$(plan_locate "$1")
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
plan_require_same_project "$plan"

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$(bash "$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

top=$(git rev-parse --show-toplevel)
docs_name=$(dforge_name "$(dforge_docs_root "$top")" "$top")
own_dirs=()
excludes=()
while IFS= read -r spelling; do
  for kind in specs plans registers; do
    own_dirs+=("$spelling/$kind")
    excludes+=(":(exclude)$spelling/$kind")
  done
done < <(dforge_name_spellings "$docs_name")

left=$(MSYS_NO_PATHCONV=1 git -C "$top" diff --name-only "${base}..${head}" -- "${own_dirs[@]}" | tr -d '\r')
kept=$(MSYS_NO_PATHCONV=1 git -C "$top" diff --name-only "${base}..${head}" -- . "${excludes[@]}" | tr -d '\r')

# A range that is only documents keeps its diff: the documents are the change.
pathspec=()
left_out=
if [ -n "$left" ] && [ -n "$kept" ]; then
  pathspec=(-- . "${excludes[@]}")
  left_out="Left out: ${left//$'\n'/, } — the seat has the spec and plan by path, or the brief"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  MSYS_NO_PATHCONV=1 git -C "$top" diff --stat "${base}..${head}" ${pathspec[@]+"${pathspec[@]}"}
  if [ -n "$left_out" ]; then echo "$left_out"; fi
  echo
  echo "## Diff"
  MSYS_NO_PATHCONV=1 git -C "$top" diff -U10 "${base}..${head}" ${pathspec[@]+"${pathspec[@]}"}
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"

# The budget line rides on a call the controller already makes before every
# review, so checking the session budget costs no extra request. It must never
# fail the package. Inside the plan's tail or final phase it says so, as the
# brief does, so a final review never reads a task budget's handoff.
here=$(cd "$(dirname "$0")" && pwd)
budget_mode=()
if . "$here/lib/context.sh" 2>/dev/null; then
  read -r -a budget_mode <<<"$(ctx_plan_mode "$plan" "$(dforge_ledger_dir "$(basename "$plan" .md)")/progress.md" 2>/dev/null)" || budget_mode=()
fi
DFORGE_BUDGET_CALLER=review-package bash "$here/context-size" ${budget_mode[@]+"${budget_mode[@]}"} 2>/dev/null || true
