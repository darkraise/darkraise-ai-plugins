#!/usr/bin/env bash
# List the background work this session started that is still running: shells
# and agents with no finished notification, and agents that sent their report
# but left work of their own running (Claude Code still lists those). Run it
# before a handoff, the finishing menu, or a claim that the work is done;
# scripts/next-step runs it before printing a block.
#
# Each launch prints as "<agent|shell|monitor> <task id> <started HH:MM> <idle Nm|idle -> <what>",
# with " (service)" or " (timer)" after a service or a bare sleep timer: the
# start is the launch's local time, and the idle age is the minutes since the
# launch's output file (an agent's own transcript when its result names none)
# last changed; "-" where there is no such time or file. The second line names
# the source: the cockpit's session file when it can be trusted, else the
# transcript (scripts/lib/in-flight.sh inflight_list).
#
# Usage: in-flight
# Exit: 0 nothing running, or only services (listed on stdout); 1 work or a
#       timer still running (listed on stdout);
#       3 no transcript for this session (Codex, or no session record), or
#       one that could not be scanned: check by hand; 2 usage.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/context.sh"
. "$HERE/lib/in-flight.sh"

[ $# -eq 0 ] || { echo "usage: in-flight" >&2; exit 2; }

if ! ctx_have_jq || ! ctx_find_transcript || [ "$CTX_SOURCE" != record ]; then
  echo "in-flight: unknown — no transcript recorded for this session; list your background shells and agents by hand"
  exit 3
fi
# Claude Code names a transcript by its session id.
sid=${CLAUDE_CODE_SESSION_ID:-$(basename "$CTX_TRANSCRIPT" .jsonl)}
if ! running=$(inflight_list "$CTX_TRANSCRIPT" "$(inflight_since "$sid")" "$sid"); then
  echo "in-flight: unknown — the transcript could not be scanned; list your background shells and agents by hand"
  exit 3
fi
source=$(inflight_source "$sid")
if [ -z "$running" ]; then
  echo "in-flight: nothing this session started is still running"
  echo "in-flight: source $source"
  exit 0
fi
# A service runs until stopped, so waiting on it never ends: only work and
# timers hold the session.
if [ -z "$(awk -F '\t' '$6 != "service"' <<<"$running")" ]; then
  echo "in-flight: only services are running:"
  echo "in-flight: source $source"
  inflight_text <<<"$running" | sed 's/^/- /'
  exit 0
fi
printf 'in-flight: %s background launch(es) still running:\n' "$(grep -c . <<<"$running")"
echo "in-flight: source $source"
inflight_text <<<"$running" | sed 's/^/- /'
cat <<'EOF'
For each one: wait for it (end the turn; its notification starts the next one),
or stop it with TaskStop <id>. An agent that already sent its report is still
listed while work it started runs; stop it the same way, which clears it. If a
stopped launch's result is not in hand, record a Ruling line in the ledger for
the task it served. Then run this again.
EOF
if [ "$(awk -F '\t' '$6 == "timer"' <<<"$running")" != "" ]; then
  echo 'A launch marked (timer) is a bare sleep that bounds a dispatch: leave it running.'
fi
exit 1
