#!/usr/bin/env bash
# Mechanics of a parallel wave (reference/parallel-waves.md): the waves a plan
# declares, the ref each parallel task commits to, the checked merge of a
# reviewed task into the feature branch, and the clean-up once a wave is merged.
# Nothing here dispatches an agent or decides a review; the controller does.
#
# Usage:
#   wave list   PLAN_FILE              one "wave K: Tasks A-B" line per wave, or
#                                      "sequential" for a plan without waves
#   wave ref    PLAN_FILE N            the branch parallel Task N commits to
#   wave enter  PLAN_FILE N START      in a task's worktree: detach at START and
#                                      mark the worktree as Task N's
#   wave status PLAN_FILE K BASE       per task of wave K: ref, commits since
#                                      BASE, merged or not, its worktree
#   wave merge  PLAN_FILE N BASE       merge Task N's ref into the checked-out
#                                      branch with --no-ff, refusing when its
#                                      files overlap what the branch gained
#                                      since the task forked
#   wave clean  PLAN_FILE K BASE       remove the worktrees and refs of wave K's
#                                      merged tasks; never forces
#   wave check-due PLAN_FILE K   which check closes wave K: full, wave-check or none
# Exit: 0 done; 1 refused (overlap, conflict, not merged); 2 usage or missing
# input; 3 the checkout is not clean; 4 the plan's waves do not parse.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/plan.sh"

usage() {
  echo "usage: wave list PLAN_FILE | ref PLAN_FILE N | enter PLAN_FILE N START | status PLAN_FILE K BASE | merge PLAN_FILE N BASE | clean PLAN_FILE K BASE | check-due PLAN_FILE K" >&2
  exit 2
}
die() { echo "wave: $2" >&2; exit "$1"; }

[ $# -ge 2 ] || usage
cmd=$1 plan=$(plan_locate "$2")
shift 2
[ -f "$plan" ] || die 2 "no such plan file: $plan"

slug=$(basename "$plan" .md)
task_ref() { # task_ref N — the branch name, checked by git's own rules
  local ref="sdd/$slug/task-$1"
  git check-ref-format --branch "$ref" >/dev/null 2>&1 || die 2 "cannot name a branch for Task $1 of $slug"
  printf '%s\n' "$ref"
}
is_num() { [[ "$1" =~ ^[0-9]+$ ]]; }
waves() {
  local w
  w=$(plan_waves "$plan") || die 4 "the **Parallelism:** waves line of $plan does not parse"
  printf '%s' "$w"
}
wave_range() { # wave_range K — "A B", or exit 2 (4 when the waves do not parse)
  local w r
  w=$(waves) || exit $?
  r=$(awk -F'\t' -v k="$1" '$1 == k { print $2, $3 }' <<<"$w")
  [ -n "$r" ] || die 2 "the plan has no wave $1"
  printf '%s\n' "$r"
}
need_commit() { git rev-parse --verify --quiet "$1^{commit}" >/dev/null || die 2 "not a commit: $1"; }
# wave_mark [DIR] — the file in DIR's worktree git directory naming the task
# ref that worktree was entered for.
wave_mark() {
  local gitdir
  gitdir=$(git -C "${1:-.}" rev-parse --absolute-git-dir 2>/dev/null) || return 1
  printf '%s/dforge/wave-task\n' "$gitdir"
}
# worktrees_holding A B — "<path>" of every detached worktree entered for ref B
# (wave enter) whose HEAD lies in A..B (an ancestor of B, not of A): the
# worktrees a parallel task's implementers committed in. Ancestry alone is not
# ownership: a user's own detached worktree can sit on a task's commit.
worktrees_holding() {
  local path="" head="" detached=0 line mark
  while IFS= read -r line; do
    case $line in
      'worktree '*) path=${line#worktree } head="" detached=0 ;;
      'HEAD '*) head=${line#HEAD } ;;
      detached) detached=1 ;;
      '')
        if [ -n "$path" ] && [ "$detached" -eq 1 ] && [ -n "$head" ] \
           && mark=$(wave_mark "$path") && [ "$(cat "$mark" 2>/dev/null)" = "${2#refs/heads/}" ] \
           && git merge-base --is-ancestor "$head" "$2" 2>/dev/null \
           && ! git merge-base --is-ancestor "$head" "$1" 2>/dev/null; then
          printf '%s\n' "$path"
        fi
        path="" ;;
    esac
  done < <(git worktree list --porcelain; echo)
}

case $cmd in
  list)
    [ $# -eq 0 ] || usage
    [ "$(plan_parallelism "$plan")" != bad ] || die 4 "the **Parallelism:** line of $plan does not parse"
    if [ "$(plan_parallelism "$plan")" = sequential ]; then echo sequential; exit 0; fi
    waves | awk -F'\t' '{ printf "wave %s: Tasks %s%s\n", $1, $2, ($3 == $2 ? "" : "-" $3) }'
    ;;

  ref)
    [ $# -eq 1 ] && is_num "$1" || usage
    task_ref "$1"
    ;;

  enter)
    [ $# -eq 2 ] && is_num "$1" || usage
    ref=$(task_ref "$1") || exit $?
    need_commit "$2"
    [ "$(git rev-parse --absolute-git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ] \
      || die 2 "not a linked worktree; a parallel task runs in a worktree of its own"
    # The mark is written first: a worktree detached without one is skipped by
    # `wave clean` without a word.
    mark=$(wave_mark) && mkdir -p "$(dirname "$mark")" || die 2 "cannot mark this worktree as Task $1's"
    previous=""
    [ ! -f "$mark" ] || previous=$(cat "$mark")
    printf '%s\n' "$ref" > "$mark" || die 2 "cannot mark this worktree as Task $1's"
    if ! git switch -q --detach "$2"; then
      if [ -n "$previous" ]; then printf '%s\n' "$previous" > "$mark"; else rm -f "$mark"; fi
      die 1 "cannot detach at $2"
    fi
    echo "entered Task $1 at $(git rev-parse --short HEAD)"
    ;;

  status)
    [ $# -eq 2 ] && is_num "$1" || usage
    range=$(wave_range "$1") || exit $?
    read -r a b <<<"$range"
    base=$2; need_commit "$base"
    for n in $(seq "$a" "$b"); do
      ref=$(task_ref "$n") || exit $?
      if ! git rev-parse --verify --quiet "refs/heads/$ref" >/dev/null; then
        printf 'Task %s: ref none\n' "$n"; continue
      fi
      sha=$(git rev-parse --short "refs/heads/$ref")
      count=$(git rev-list --count "$base..refs/heads/$ref")
      merged=no
      git merge-base --is-ancestor "refs/heads/$ref" HEAD && merged=yes
      wt=$(worktrees_holding "$base" "refs/heads/$ref" | paste -sd ' ' -)
      printf 'Task %s: ref %s %s; commits %s; merged %s; worktree %s\n' \
        "$n" "$ref" "$sha" "$count" "$merged" "${wt:-none}"
    done
    ;;

  merge)
    [ $# -eq 2 ] && is_num "$1" || usage
    n=$1 base=$2
    need_commit "$base"
    ref=$(task_ref "$n") || exit $?
    git rev-parse --verify --quiet "refs/heads/$ref" >/dev/null || die 2 "Task $n has no ref $ref"
    [ -z "$(git status --porcelain --untracked-files=no)" ] || die 3 "the checkout is not clean; commit or clear it before merging"
    git merge-base --is-ancestor "$base" "refs/heads/$ref" || die 1 "Task $n's ref does not descend from the wave base $base"
    git merge-base --is-ancestor "$base" HEAD || die 1 "the checked-out branch does not descend from the wave base $base"
    if git merge-base --is-ancestor "refs/heads/$ref" HEAD; then
      echo "already merged: Task $n ($(git rev-parse --short "refs/heads/$ref"))"; exit 0
    fi
    fork=$(git merge-base HEAD "refs/heads/$ref")
    mine=$(git diff --no-renames --name-only "$fork" "refs/heads/$ref" | sort -u)
    theirs=$(git diff --no-renames --name-only "$fork" HEAD | sort -u)
    overlap=$(comm -12 <(printf '%s\n' "$mine") <(printf '%s\n' "$theirs") | grep . || true)
    files=$(grep -c . <<<"$mine" || true)
    if [ -n "$overlap" ]; then
      echo "overlap: Task $n changes files the branch already changed since $(git rev-parse --short "$fork"):"
      sed 's/^/  /' <<<"$overlap"
      exit 1
    fi
    title=$(plan_tasks "$plan" | awk -F'\t' -v n="$n" '$1 == n { print $2 }')
    if ! git merge --no-ff --no-edit -m "Merge Task $n: ${title:-task $n}" "refs/heads/$ref" >/dev/null 2>&1; then
      git merge --abort >/dev/null 2>&1 || true
      die 1 "Task $n did not merge cleanly; the merge was aborted"
    fi
    echo "merged Task $n: $(git rev-parse --short HEAD) ($files files from $ref)"
    # Files outside the task's plan list are not refused here (the task review
    # judged scope), but the controller should see them.
    listed=$(plan_task_text "$plan" "$n" 2>/dev/null | plan_task_paths)
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      grep -qxF "$f" <<<"$listed" || echo "note: $f is not in Task $n's **Files:**"
    done <<<"$mine"
    ;;

  clean)
    [ $# -eq 2 ] && is_num "$1" || usage
    range=$(wave_range "$1") || exit $?
    read -r a b <<<"$range"
    base=$2; need_commit "$base"
    seen=$'\n'
    for n in $(seq "$a" "$b"); do
      ref=$(task_ref "$n") || exit $?
      git rev-parse --verify --quiet "refs/heads/$ref" >/dev/null || continue
      if ! git merge-base --is-ancestor "refs/heads/$ref" HEAD; then
        echo "kept $ref: not merged"; continue
      fi
      while IFS= read -r wt; do
        [ -n "$wt" ] || continue
        # A later task forked from a merged sibling holds that sibling's
        # commits too, so one worktree can fall in several tasks' ranges.
        [[ "$seen" != *$'\n'"$wt"$'\n'* ]] || continue
        seen="$seen$wt"$'\n'
        if [ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]; then
          echo "kept $wt: uncommitted changes"
        elif git worktree remove "$wt" >/dev/null 2>&1; then
          echo "removed $wt"
        else
          echo "kept $wt: git worktree remove refused (locked or in use)"
        fi
      done < <(worktrees_holding "$base" "refs/heads/$ref")
      if git branch -d "$ref" >/dev/null 2>&1; then echo "deleted $ref"; else echo "kept $ref: git branch -d refused"; fi
    done
    git worktree prune >/dev/null 2>&1 || true
    ;;

  check-due)
    [ $# -eq 1 ] && is_num "$1" && [ "$((10#$1))" -ge 1 ] || usage
    k=$((10#$1))
    src=$(mktemp) || die 2 "cannot create a temporary file"
    trap 'rm -f "$src"' EXIT
    plan_apply_amendments "$plan" "$(plan_amendments_file "$plan")" > "$src" 2>/dev/null \
      || die 2 "an amendment does not apply; run plan-lint"
    case $(plan_parallelism "$src") in
      bad) die 4 "the **Parallelism:** line of $plan does not parse" ;;
      sequential) die 2 "the plan has no waves **Parallelism:** line" ;;
    esac
    w=$(plan_waves "$src") || die 4 "the **Parallelism:** waves line of $plan does not parse"
    range=$(awk -F'\t' -v k="$k" '$1 == k { print $2, $3 }' <<<"$w")
    [ -n "$range" ] || die 2 "the plan has no wave $k"
    read -r a b <<<"$range"
    last=$(grep -c . <<<"$w")
    scores=$(plan_scores "$src")
    risk3=$(awk -F'\t' -v a="$a" -v b="$b" '$1 >= a && $1 <= b && $3 == "3" { print $1 }' <<<"$scores")
    if [ $((k % 3)) -eq 0 ] || [ "$k" -eq "$last" ] || [ -n "$risk3" ]; then echo full; exit 0; fi
    check=$(plan_header "$src" | awk "$_PLAN_AWK"'
      stop { next }
      in_fence($0) { next }
      index($0, "**Wave check:**") == 1 { print substr($0, 16); stop = 1 }')
    if [ -n "$(tr -d ' \t' <<<"$check")" ]; then echo wave-check; else echo none; fi
    ;;

  *) usage ;;
esac
