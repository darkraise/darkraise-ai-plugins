#!/usr/bin/env bash
# forge-migrate [DIR] — move a repository from the pre-3.0 names to dforge
# 3.0's, which reads only the new ones. For the repository at DIR (default:
# the working directory), its primary checkout and every linked worktree:
#   .superpowers/          -> .forge/            (plain rename)
#   docs/superpowers/      -> docs/forge/        (git mv when tracked)
#   <git dir>/dr-superpowers/ -> <git dir>/dforge/
# then, once every move has succeeded, the lines of .gitignore, .gitattributes
# and the shared info/exclude that name .superpowers or docs/superpowers. No
# other file's content changes: historical plans and specs keep the citations
# dforge translates when it reads them. Last, scripts/lib/darkmem-migrate.mjs
# moves the home (~/.dr-superpowers/ -> ~/.dforge/) when it is installed.
#
# A checkout holding both .superpowers/ and .forge/ is merged file by file: a
# file only the old one has moves, an identical one is dropped, and a file that
# differs is refused and left. A checkout holding both docs trees, or a
# docs/superpowers/ with uncommitted changes, is refused and left as it is.
# The rest still moves, and a second run finishes the job once the refusal is
# resolved. A checkout that was refused keeps its old ignore lines and gains
# the new ones beside them, so a moved directory is never left un-ignored.
#
# Exit: 0 done or nothing to do; 1 something was refused; 2 usage or not
# inside a git repository.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/lib/native-path.sh"

[ $# -le 1 ] || { echo "usage: forge-migrate [DIR]" >&2; exit 2; }
dir=${1:-$PWD}

if command -v timeout >/dev/null 2>&1; then g() { timeout 60 git "$@"; }; else g() { git "$@"; }; fi

root=$(g -C "$dir" rev-parse --show-toplevel 2>/dev/null) \
  || { echo "forge-migrate: $dir is not inside a git repository" >&2; exit 2; }
common=$(g -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
  || { echo "forge-migrate: cannot read the git directory of $root" >&2; exit 2; }

refused=0 moved=0 checkout_refused=0
checkouts=()
clean=()
commit_notes=()

refuse() { printf 'forge-migrate: refused: %s\n' "$1" >&2; refused=1; checkout_refused=1; }
done_move() { printf 'moved %s -> %s\n' "$1" "$2"; moved=1; }

# same_entry A B — whether two files, or two symlinks, hold the same thing.
same_entry() {
  if [ -L "$1" ] || [ -L "$2" ]; then
    [ -L "$1" ] && [ -L "$2" ] && [ "$(readlink -- "$1")" = "$(readlink -- "$2")" ]
  else
    [ -f "$1" ] && [ -f "$2" ] && cmp -s -- "$1" "$2"
  fi
}

# merge_into FROM TO — FROM's files into the existing directory TO: a file TO
# lacks moves, an identical one is dropped, a differing one is refused and left.
merge_into() {
  local from=$1 to=$2 file rel conflicts=0 touched=0
  while IFS= read -r -d '' file; do
    rel=${file#"$from"/}
    if [ ! -e "$to/$rel" ] && [ ! -L "$to/$rel" ]; then
      if mkdir -p -- "$(dirname -- "$to/$rel")" && mv -- "$file" "$to/$rel"; then touched=1
      else refuse "could not move $file into $to"; conflicts=1; fi
    elif same_entry "$file" "$to/$rel"; then
      rm -f -- "$file" && touched=1
    else
      refuse "$file differs from $to/$rel; keep one by hand, then run forge-migrate again"
      conflicts=1
    fi
  done < <(find "$from" \( -type f -o -type l \) -print0)
  find "$from" -depth -type d -empty -delete 2>/dev/null
  if [ "$conflicts" -eq 0 ] && [ -e "$from" ]; then refuse "$from still holds entries that are not files; move them by hand, then run forge-migrate again"; fi
  if [ ! -e "$from" ]; then done_move "$from" "$to"; elif [ "$touched" -eq 1 ]; then moved=1; fi
}

# mv_plain FROM TO — the rename; merged file by file when both exist.
mv_plain() {
  [ -e "$1" ] || return 0
  if [ -e "$2" ]; then
    if [ -d "$1" ] && [ -d "$2" ]; then merge_into "$1" "$2"; else refuse "$1 and $2 both exist and are not both directories; merge them by hand, then run forge-migrate again"; fi
    return 0
  fi
  if mv -- "$1" "$2"; then done_move "$1" "$2"; else refuse "could not rename $1"; fi
}

migrate_docs() { # CHECKOUT
  local wt=$1 old="$1/docs/superpowers" new="$1/docs/forge"
  [ -e "$old" ] || return 0
  if [ -e "$new" ]; then refuse "$old and $new both exist; merge them by hand, then run forge-migrate again"; return 0; fi
  if [ -z "$(g -C "$wt" ls-files -- docs/superpowers | head -n 1)" ]; then mv_plain "$old" "$new"; return 0; fi
  if [ -n "$(g -C "$wt" status --porcelain --untracked-files=all -- docs/superpowers)" ]; then
    refuse "$old has uncommitted changes; commit or stash them, then run forge-migrate again"
    return 0
  fi
  if g -C "$wt" mv docs/superpowers docs/forge; then
    done_move "$old" "$new"
    commit_notes+=("$wt: the staged rename docs/superpowers/ -> docs/forge/")
  else
    refuse "git mv docs/superpowers docs/forge failed in $wt"
  fi
}

# rewrite_names FILE MODE — the ignore and attribute lines that name a
# pre-3.0 directory. MODE replace renames them in place, dropping a renamed
# line the file already holds; MODE add keeps each line and puts the renamed
# one after it, skipping comments and lines already present.
rewrite_names() {
  local file=$1 mode=$2 renamed tmp
  [ -f "$file" ] || return 1
  grep -qE '(^|[^A-Za-z0-9_-])\.superpowers([/[:space:]*]|$)|docs/superpowers([/[:space:]*]|$)' "$file" || return 1
  renamed="$file.forge-migrate.$$.renamed"
  tmp="$file.forge-migrate.$$"
  sed -E -e 's#(^|[^A-Za-z0-9_-])\.superpowers([/[:space:]*]|$)#\1.forge\2#g' \
         -e 's#docs/superpowers([/[:space:]*]|$)#docs/forge\1#g' "$file" > "$renamed" \
    && awk -v mode="$mode" '
      NR == FNR { old[FNR] = $0; have[$0] = 1; n = FNR; next }
      { new[FNR] = $0 }
      END {
        for (i = 1; i <= n; i++) {
          if (old[i] == new[i]) { print old[i]; continue }
          if (mode == "add") {
            print old[i]
            if (old[i] !~ /^[[:space:]]*#/ && !(new[i] in have)) { print new[i]; have[new[i]] = 1 }
          } else if (!(new[i] in have)) { print new[i]; have[new[i]] = 1 }
        }
      }' "$file" "$renamed" > "$tmp" \
    && ! cmp -s -- "$tmp" "$file" \
    && cat "$tmp" > "$file" \
    || { rm -f -- "$tmp" "$renamed"; return 1; }
  rm -f -- "$tmp" "$renamed"
  printf 'rewrote the pre-3.0 names in %s\n' "$file"
  moved=1
}

while IFS= read -r wt; do
  [ -n "$wt" ] && [ -d "$wt" ] && checkouts+=("$wt")
done < <(g -C "$root" worktree list --porcelain 2>/dev/null | tr -d '\r' | sed -n 's/^worktree //p')
[ ${#checkouts[@]} -gt 0 ] || checkouts=("$root")

for wt in "${checkouts[@]}"; do
  checkout_refused=0
  if [ -e "$wt/.superpowers" ] && [ -n "$(g -C "$wt" ls-files -- .superpowers | head -n 1)" ]; then
    commit_notes+=("$wt: the rename .superpowers/ -> .forge/ (git add -A .superpowers .forge)")
  fi
  mv_plain "$wt/.superpowers" "$wt/.forge"
  migrate_docs "$wt"
  if gitdir=$(g -C "$wt" rev-parse --absolute-git-dir 2>/dev/null); then
    mv_plain "$gitdir/dr-superpowers" "$gitdir/dforge"
  else
    refuse "cannot read the git directory of $wt"
  fi
  clean+=("$checkout_refused")
done

# A checkout that moved completely has its lines renamed; one that was refused
# keeps the old line and gains the new one, so nothing it moved is exposed.
# The shared info/exclude is renamed only when every checkout moved.
for i in "${!checkouts[@]}"; do
  wt=${checkouts[$i]} mode=replace
  [ "${clean[$i]}" -eq 0 ] || mode=add
  for name in .gitignore .gitattributes; do
    if rewrite_names "$wt/$name" "$mode" && g -C "$wt" ls-files --error-unmatch -- "$name" >/dev/null 2>&1; then
      commit_notes+=("$wt: $name")
    fi
  done
done
mode=replace
[ "$refused" -eq 0 ] || mode=add
rewrite_names "$common/info/exclude" "$mode" || true

if [ -f "$HERE/lib/darkmem-migrate.mjs" ]; then
  if ! command -v node >/dev/null 2>&1; then
    if [ -e "${HOME:-}/.dr-superpowers" ]; then refuse "node is not on PATH, so the home (~/.dr-superpowers/) was not migrated"; fi
  else
    home_out=$(cd "$root" && node "$(dr_native_path "$HERE/lib/darkmem-migrate.mjs")")
    home_status=$?
    if [ -n "$home_out" ]; then printf '%s\n' "$home_out"; moved=1; fi
    [ "$home_status" -eq 0 ] || refuse "scripts/lib/darkmem-migrate.mjs did not finish; see its output above"
  fi
fi

for note in "${commit_notes[@]+"${commit_notes[@]}"}"; do printf 'commit: %s\n' "$note"; done
[ "$moved" -eq 1 ] || [ "$refused" -eq 1 ] || echo "forge-migrate: nothing to migrate in $root"
exit "$refused"
