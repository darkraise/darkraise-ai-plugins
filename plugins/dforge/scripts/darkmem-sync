#!/usr/bin/env bash
# Keep this repository's dforge documents and progress in darkmem.
#
# With darkmemEnabled on, a repository mapped in ~/.dforge/config.json
# syncs a mirror at ~/.dforge/mirror/<project>/: forge/ (specs, plans,
# registers, notes) while its documents are applied darkmem,
# work/sdd/<plan>/{progress.md,handoff.md} and work/handoff/latest.md while its
# progress is. ~/.dforge/stores.json records the applied stores;
# documentStore and progressSource choose them. reconcile moves each family
# whose configured store differs from its applied store, or prints a line
# saying where it stays and why it was refused; a move back to the repository
# copies the mirror as it stands when darkmem cannot be asked. push archives a
# document deleted from the mirror under forge/archive/<stamp>/; restore
# brings back the newest archived copy of a document name; revision prints
# NAME@r<id>, the darkmem revision a synced, unchanged document cites. A
# disabled or unmapped repository is local mode: every command except import
# prints one line and does nothing, and only reconcile and status act while a
# family is still in the mirror.
#
# Usage: darkmem-sync status | pull | push [--workstream KEY] | import [--replace] | restore NAME | revision NAME | reconcile
# Exit: 0 done, or no family applied darkmem; 1 conflicts, refused or failed
#       items, a refused restore, revision or reconcile move, or another sync
#       holds the mirror; 2 usage, a malformed config, stores or state file, or import in
#       local mode; 3 darkmem unreachable, the API key unset (pull, push,
#       import, restore, revision), or an answer that stopped the command; 4 an
#       unexpected error (a bug)
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
command -v node >/dev/null 2>&1 || { echo "darkmem-sync: node is required but not on PATH" >&2; exit 2; }
exec node "$HERE/lib/darkmem-sync.mjs" "$@"
