#!/usr/bin/env bash
# Print the one next action — for a plan: start, resume, final review,
# finishing, next program sub-project or roadmap epic, a milestone audit, or
# nothing; for a design draft: its
# next step — as a "## Next session" block, and write the same block into the
# handoff of the checkout the next session works in (T): the plan's worktree
# for a plan in flight, the primary once it is complete, else this checkout.
#
# Sessions end by pasting this block verbatim, so what comes next is computed
# here rather than remembered by the model: small executors reliably forget to
# say it, and a hand-written handoff goes stale the moment work moves on.
#
# Usage: next-step [--host claude|codex] [--print|--target] [--notes FILE] [--complete|--kept] PLAN_FILE
#        next-step [--host claude|codex] [--print|--target] [--notes FILE] --draft DRAFT_FILE --next ACTION
#        next-step [--host claude|codex] [--print|--target] [--notes FILE] [--key KEY] --adhoc --phase design|build --next ACTION
#        next-step [--host claude|codex] [--print|--target] [--notes FILE] [--key KEY] --project
#        next-step [--host claude|codex] --print --handoff FILE | --latest
# The handoff is <checkout>/<state>/handoff/<key>.md (scripts/lib/roots.sh
# dforge_handoff_file): the key is the plan's or the draft's basename, and for
# --adhoc and --project adhoc-<the first 8 characters of
# CLAUDE_CODE_SESSION_ID>.
#   --print     compute and print the block only: write, create and delete
#               nothing, and skip the background-work check.
#   --notes     FILE's content becomes the handoff's notes, above the block,
#               and FILE is deleted once the handoff is written. Without it a
#               handoff already at the key keeps its notes and only its Next
#               session section is replaced. Ignored by --print and --target.
#   --key       the adhoc-<8 hex> or adhoc-legacy-* key of an --adhoc or
#               --project handoff when no session id is set: --target mints
#               one, and the write takes it back. A usage error with a session
#               id or another mode; an --adhoc or --project write with neither
#               exits 2.
#   --complete  the plan is finished and its branch integrated; the ledger may
#               already be deleted. Without --notes, replaces the handoff
#               wholesale.
#   --kept      finishing kept the plan's branch as-is: integration is still
#               pending, so the block names the branch, its worktree and the
#               finish choices still open, and reads no register or roadmap.
#               Replaces the handoff as --complete does.
#   --complete, --kept and --adhoc delete the no-plan finish record
#   (.dforge/sdd/finish.json) of the current checkout and of the primary
#   checkout once the block is printed.
#   --draft     a design phase (brainstorming, a spec, a plan being written) is
#               handing off; DRAFT_FILE is the authority and ACTION names the
#               next step and its skill.
#   --adhoc     unplanned work (a chat-approved change or a punch list, with no
#               plan or draft file) is handing off; the notes in its handoff
#               are the authority. --phase design launches the planning model,
#               --phase build the execution model.
#   --project   no plan is in hand (between plans, or after a milestone close):
#               the block comes from the current milestone's registers, or
#               every register when no milestone is current.
#   --handoff   recompute the block the handoff FILE holds from what its
#               marker names (requires --print), and print it with the marker
#               last; its first prompt names FILE as the handoff. --latest is
#               --handoff with this checkout's newest handoff.
#   --target    print the absolute path of the handoff the same call would
#               write, and exit 0: write nothing, and skip the background-work
#               check. A usage error with --latest.
#   --host      which client the next session launches; default claude. A plan
#               states its own host in its header, so the flag serves the paths
#               that have no plan to read.
# The handoff's Next session section ends with a marker line the printed block
# never carries, naming what the block was computed from and who wrote it:
#   <!-- next-step: kind=<kind> [branch=<name> or branch=detached:<sha>] key=<key> session=<id or -> [host=codex] done=<n> closed=<n> subject=<name or -> at=<epoch> -->
#   host=codex appears only for a Codex block; --print --latest without --host
#   recomputes for the host it names.
# Exit: 0 ok; 2 usage or missing file; 3 plan has no tasks; 4 block printed but
#       the handoff could not be written; 5 background work this session started
#       is still running (scripts/in-flight): nothing printed or written
#       (never under --print); 6 --print --handoff has nothing to resume
#       (nothing on stdout, at most one reason on stderr): a plan in
#       completed.md, or whose ledger is gone and is unrecorded; a draft a
#       plan's Spec line names, or that is gone; a complete or project block
#       whose recomputed Next is terminal; a kept branch merged or gone. An
#       adhoc handoff is never superseded.
set -euo pipefail

# Failures print on stdout as well as stderr. A session that surfaces only
# stdout would otherwise get an empty result from the one script whose whole
# job is saying what happens next.
fail() { # fail EXIT MESSAGE
  printf 'next-step: %s\n' "$2"
  printf 'next-step: %s\n' "$2" >&2
  exit "$1"
}

usage() { fail 2 "usage: next-step [--host claude|codex] [--print|--target] [--notes FILE] [--complete|--kept] PLAN_FILE | next-step [--host claude|codex] [--print|--target] [--notes FILE] --draft DRAFT_FILE --next ACTION | next-step [--host claude|codex] [--print|--target] [--notes FILE] [--key KEY] --adhoc --phase design|build --next ACTION | next-step [--host claude|codex] [--print|--target] [--notes FILE] [--key KEY] --project | next-step [--host claude|codex] --print --handoff FILE | --latest"; }
. "$(cd "$(dirname "$0")" && pwd)/lib/plan.sh"
. "$(cd "$(dirname "$0")" && pwd)/lib/roadmap.sh"
. "$(cd "$(dirname "$0")" && pwd)/lib/lock.sh"
. "$(cd "$(dirname "$0")" && pwd)/lib/route.sh"

# --host, --print, --target, --notes and --key are pulled out wherever they
# sit so the remaining arguments keep their strict positional contract.
host=claude host_given=0 print_only=0 target_only=0 notes_file="" key_arg=""
hostless=()
while [ $# -gt 0 ]; do
  case $1 in
    --print) print_only=1; shift ;;
    --target) target_only=1; shift ;;
    --notes)
      [ $# -ge 2 ] && [ -n "$2" ] || usage
      notes_file=$2; shift 2
      case $notes_file in /* | [A-Za-z]:[\\/]*) ;; *) notes_file="$PWD/$notes_file" ;; esac
      ;;
    --key)
      [ $# -ge 2 ] && [ -n "$2" ] || usage
      key_arg=$2; shift 2
      ;;
    --host)
      [ $# -ge 2 ] || usage
      case $2 in claude|codex) host=$2 host_given=1 ;; *) usage ;; esac
      shift 2
      ;;
    *) hostless+=("$1"); shift ;;
  esac
done
set -- ${hostless[@]+"${hostless[@]}"}

# The design tier writes specs and plans; the build tier executes them. Codex
# runs both tiers on GPT-6.1 Sol high: the session runs for hours, and the
# judgment calls that need Astra go to native judges at the rank-8 floor, not
# to the session.
launch_for() { # launch_for design|build
  case $host:$1 in
    codex:*)       printf 'codex -m gpt-6.1-sol -c model_reasoning_effort=high' ;;
    *:design)      printf 'claude --model opus --effort high' ;;
    *)             printf 'claude --model sonnet --effort high' ;;
  esac
}

# execution_launch EXECUTION_LINE — the launch command a plan's Execution line
# names; nothing when it names none.
execution_launch() {
  local cmd pair
  cmd=$(grep -oE 'claude --model [^ `]+ --effort [^ `]+' <<<"$1" | head -n 1 || true)
  if [ -z "$cmd" ]; then
    pair=$(grep -oE 'codex [a-z0-9.-]+ / [a-z]+' <<<"$1" | head -n 1 || true)
    [ -z "$pair" ] || cmd="codex -m $(awk '{ print $2 }' <<<"$pair") -c model_reasoning_effort=$(awk '{ print $4 }' <<<"$pair")"
  fi
  printf '%s' "$cmd"
}

# plan_finished ROOT NAME — true when the completed.md beside the plan NAME
# records it. Matched on the backticked name, so one plan's name that is a
# substring of another's cannot claim its outcome; an
# entry under either docs prefix counts. An absolute NAME is named from the roots
# first (plan_name); one no root maps never counts.
plan_finished() {
  local f s name
  name=$(plan_name "$1" "$2")
  case $name in /*|[A-Za-z]:/*|[A-Za-z]:\\*) return 1 ;; esac
  f="$(dirname "$(dforge_resolve "$name" "$1")")/completed.md"
  [ -f "$f" ] || return 1
  while IFS= read -r s; do
    grep -qF "\`$s\`" "$f" && return 0
  done < <(dforge_name_spellings "$name")
  return 1
}

# handoff_counts ROOT — "<done> <closed>": the plan entries of completed.md
# and the roadmap's closed milestones, read from the files alone so every
# write and every recompute can afford it.
handoff_counts() {
  local index map done_n=0 closed_n=0
  index="$(dforge_docs_root "$1")/plans/completed.md"
  [ ! -f "$index" ] || done_n=$(tr -d '\r' < "$index" | grep -cE '`[^`]+\.md`' || true)
  map=$(roadmap_file "$1")
  [ -z "$map" ] || closed_n=$(roadmap_rows "$map" | awk -F'\t' '$5 == "closed"' | grep -c . || true)
  printf '%s %s\n' "$done_n" "$closed_n"
}

# _plan_roots ROOT — "<root>\t<name prefix>" for each place a plan name can be
# read from: the docs root in use, then the docs directory and top level of the
# checkout and of every worktree (the primary among them).
_plan_roots() {
  local top=${_DFORGE_TOP:-$1} tree
  printf '%s\t%s\n' "$_DFORGE_DOCS_ROOT" "$(dforge_dir_rel docs "$top")"
  { printf '%s\n' "$top"; git -C "$top" worktree list --porcelain 2>/dev/null | tr -d '\r' | sed -n 's/^worktree //p'; } |
  while IFS= read -r tree; do
    tree=$(_dforge_path "$tree")
    printf '%s\t%s\n' "$(dforge_dir docs "$tree")" "$(dforge_dir_rel docs "$tree")"
    printf '%s\t\n' "$tree"
  done
}

# _plan_physical PATH — PATH with symbolic links resolved where its directory
# exists, else unchanged.
_plan_physical() {
  local dir
  if [ -d "$1" ]; then dir=$(cd "$1" 2>/dev/null && pwd -P) && { _dforge_path "$dir"; return 0; }
  else dir=$(cd "$(dirname "$1")" 2>/dev/null && pwd -P) && { _dforge_path "$dir/$(basename "$1")"; return 0; }
  fi
  printf '%s\n' "$1"
}

# plan_name ROOT NAME — NAME; an absolute NAME is named from the roots instead
# (_plan_roots), as written and then with symbolic links resolved in the name
# and in each root, the same rule as the JavaScript mapping. The deepest root
# holding the name wins, so a worktree nested inside the primary checkout is
# not taken for the primary's own files, and a worktree's register or ledger
# naming the primary's copy still finds its plan. Never a search for a docs
# segment; an absolute name under no root is printed unchanged, and
# plan_finished never counts it.
plan_name() {
  local name=${2//\\//} pass candidate root prefix best="" best_len=0
  case $name in
    /*|[A-Za-z]:/*) ;;
    *) printf '%s\n' "$2"; return 0 ;;
  esac
  dforge_stores_init "$1"
  name=$(_dforge_path "$name")
  for pass in written physical; do
    candidate=$name
    [ "$pass" = written ] || candidate=$(_plan_physical "$name")
    while IFS=$'\t' read -r root prefix; do
      [ "$pass" = written ] || root=$(_plan_physical "$root")
      case $candidate in
        "$root"/*)
          if [ "${#root}" -gt "$best_len" ]; then best_len=${#root}; best=${prefix:+$prefix/}${candidate#"$root"/}; fi ;;
      esac
    done < <(_plan_roots "$1")
    if [ -n "$best" ]; then printf '%s\n' "$best"; return 0; fi
  done
  printf '%s\n' "$name"
}

complete=0 kept=0 draft=0 adhoc=0 project=0 latest_mode=0 handoff_file="" phase="" next_action=""
case "${1:-}" in
  --latest | --handoff)
    latest_mode=1
    if [ "$1" = --handoff ]; then [ $# -ge 2 ] && [ -n "$2" ] || usage; handoff_file=$2; shift; fi
    shift
    { [ $# -eq 0 ] && [ "$print_only" -eq 1 ] && [ "$target_only" -eq 0 ]; } || usage
    ;;
  --project)
    project=1; shift
    [ $# -eq 0 ] || usage
    ;;
  --complete) complete=1; shift ;;
  --kept) kept=1; shift ;;
  --draft)
    draft=1; shift
    { [ $# -eq 3 ] && [ "$2" = "--next" ] && [ -n "$3" ]; } || usage
    next_action=$3
    set -- "$1"
    ;;
  --adhoc)
    adhoc=1; shift
    { [ $# -eq 4 ] && [ "$1" = "--phase" ] && [ "$3" = "--next" ] && [ -n "$4" ]; } || usage
    case $2 in design|build) phase=$2 ;; *) usage ;; esac
    next_action=$4
    ;;
esac
[ "$latest_mode" -eq 0 ] || { [ -z "$notes_file" ] && [ -z "$key_arg" ]; } || usage
# --key names an adhoc handoff for a caller with no session id to key it by.
if [ -n "$key_arg" ]; then
  { [ "$adhoc" -eq 1 ] || [ "$project" -eq 1 ]; } && [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] || usage
  dforge_handoff_key_check adhoc "$key_arg" || usage
fi
if [ -n "$notes_file" ] && [ "$print_only" -eq 0 ] && [ "$target_only" -eq 0 ] && [ ! -f "$notes_file" ]; then
  fail 2 "no notes file at $notes_file"
fi

# collect_rows — read register paths on stdin; set open_rows (route_rows'
# input lines), reg_list and outside_ms, against current_ms and ms_regs.
collect_rows() {
  local reg_file rows
  open_rows="" reg_list="" outside_ms=""
  while IFS= read -r reg_file; do
    [ -n "$reg_file" ] || continue
    rows=$(register_open "$reg_file")
    [ -n "$rows" ] || continue
    # The milestone audit reads only the registers below the milestone.
    if [ -n "$current_ms" ] && ! grep -qxF -- "$reg_file" <<<"$ms_regs"; then outside_ms=1; fi
    # Several registers may cover one spec; every one that has open rows is
    # named, so the count is never attributed to the wrong file.
    reg_list="${reg_list:+$reg_list, }\`$(dforge_name "$reg_file")\`"
    open_rows="${open_rows}$(ROUTE_REG=$reg_file awk '{ print ENVIRON["ROUTE_REG"] "\t" $0 }' <<<"$rows")
"
  done
  open_rows=$(grep . <<<"$open_rows" || true)
}

# render_rows — the Next line, prompt and launch for open_rows from the
# ROUTE_* outputs of route_rows.
render_rows() {
  local open_n row_list kind action waiting stale stale_note ms_id ms_name verify_clause="" built_clause=""
  open_n=$(grep -c . <<<"$open_rows")
  row_list=$(awk -F'\t' '
    NR <= 3 { printf "%s#%s %s", (NR > 1 ? "; " : ""), $2, $3 }
    END { if (NR > 3) printf " +%d more", NR - 3 }
  ' <<<"$open_rows")
  kind=$ROUTE_KIND action=$ROUTE_ACTION waiting=$ROUTE_WAITING stale=$ROUTE_STALE
  launch_cmd=$ROUTE_LAUNCH_CMD launch_plan=$ROUTE_LAUNCH_PLAN
  stale_note=""
  [ -z "$stale" ] || stale_note="Still assigned to a finished plan: $stale — resolve or reassign them with \`scripts/register set\`."
  next_line="Register rows still open ($open_n) in $reg_list: $row_list.${stale_note:+ $stale_note}${action:+ $action}"
  if [ "$kind" = milestone ]; then
    ms_id=$(cut -f1 <<<"$current_ms") ms_name=$(cut -f2 <<<"$current_ms")
    [ -z "$waiting" ] || verify_clause="; rows awaiting the owner's check (verify): $waiting"
    [ -z "$ROUTE_BUILT" ] || built_clause=" Built, awaiting the audit: $ROUTE_BUILT."
    prompt="Close milestone $ms_id ($ms_name) of \`$(dforge_name "$(dforge_docs_root)")/roadmap.md\` with dforge:closing-a-milestone$verify_clause.$built_clause"
    launch=1
  elif [ -n "$kind" ]; then
    prompt="Continue the work recorded in $reg_list: $open_n rows are open ($row_list). $action"
    launch=1
  fi
}

status_line="" next_line="" prompt="" launch=1 launch_cmd="" launch_plan=""

if [ "$adhoc" -eq 1 ] || [ "$project" -eq 1 ] || [ "$latest_mode" -eq 1 ]; then
  root=$(git rev-parse --show-toplevel 2>/dev/null) || fail 2 "not inside a git repository"
  primary=$(plan_primary_root "$root")
else
  [ $# -eq 1 ] || usage
  plan=$(plan_locate "$1")
  [ -f "$plan" ] || fail 2 "no such file: $plan — run it from the repository root, or check the plan path"
  repo_err=$(plan_require_same_project "$plan" 2>&1) || fail 2 "${repo_err#next-step: }"

  root=$(git rev-parse --show-toplevel 2>/dev/null) || fail 2 "not inside a git repository"
  primary=$(plan_primary_root "$root")

  dforge_stores_init "$root"
  rel=$(dforge_name "$plan")
  slug=$(basename "$plan" .md)
fi

dforge_stores_init "$root"

# The handoff's key (spec §1). A key taken from the session id is held only to
# the file-name rule: ids from other clients and tests need not be hex.
session_id=${CLAUDE_CODE_SESSION_ID:-} key=""
if [ "$latest_mode" -eq 1 ]; then :
elif [ "$print_only" -eq 1 ] && [ -n "${DFORGE_NEXT_STEP_HANDOFF:-}" ]; then
  # A recompute names the file it recomputes, whatever its name (latest.md
  # included), so its key is never checked.
  key=$(basename "$DFORGE_NEXT_STEP_HANDOFF" .md)
elif [ "$adhoc" -eq 1 ] || [ "$project" -eq 1 ]; then
  if [ -n "$session_id" ]; then key="adhoc-${session_id:0:8}"
  elif [ -n "$key_arg" ]; then key=$key_arg
  elif [ "$print_only" -eq 1 ] || [ "$target_only" -eq 1 ]; then key="adhoc-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
  else fail 2 "an --adhoc or --project handoff needs CLAUDE_CODE_SESSION_ID or --key KEY (next-step --target prints one)"
  fi
else
  key=$slug
  if [ "$draft" -eq 1 ]; then key_kind=draft; else key_kind=plan; fi
  dforge_handoff_key_check "$key_kind" "$key" || fail 2 "handoff: invalid key $key"
fi
# The draft and adhoc prompts name it; their T is this checkout.
if [ "$print_only" -eq 1 ] && [ -n "${DFORGE_NEXT_STEP_HANDOFF:-}" ]; then own_handoff=$DFORGE_NEXT_STEP_HANDOFF
elif [ -n "$key" ]; then own_handoff=$(dforge_handoff_file "$key" 2>/dev/null) || fail 2 "handoff: invalid key $key"
fi

# handoff_target — T, the checkout the next session works in (spec §2). A
# mirror ledger has no checkout of its own: the one holding its workspace
# stands in (_plan_ledger_tree).
handoff_target() {
  if [ "$complete" -eq 1 ]; then printf '%s\n' "$primary"
  elif [ "$kept" -eq 1 ] || [ "$draft" -eq 1 ] || [ "$adhoc" -eq 1 ] || [ "$project" -eq 1 ]; then printf '%s\n' "$root"
  elif [ "$has_ledger" -eq 1 ] && [ "$(dforge_progress_store)" = darkmem ]; then _plan_ledger_tree "$root" "$slug"
  elif [ "$has_ledger" -eq 1 ]; then printf '%s\n' "$ledger_root"
  else printf '%s\n' "$root"; fi
}

# draft_planned ROOT DRAFT — a plan's Spec line names DRAFT; a Program line
# alone does not, since a program's draft outlives each of its plans.
draft_planned() {
  local want name file sub spec
  want=$(dforge_name_key "$2")
  while IFS=$'\t' read -r name file sub; do
    spec=$(tr -d '\r' < "$file" | sed -n 's/^\*\*Spec:\*\*[[:space:]]*//p' | head -n 1 | sed 's/^`\([^`]*\)`.*/\1/; s/[[:space:]].*//')
    [ "$(dforge_name_key "$spec")" = "$want" ] && return 0
  done < <(_spec_plan_files "$1" "$2")
  return 1
}

# --print --handoff FILE: the stored block, recomputed from what its marker
# names when the repository can answer it, so a reader never replays a stale
# one.
if [ "$latest_mode" -eq 1 ]; then
  gone() { printf 'next-step: %s\n' "$1" >&2; exit 6; }
  latest=${handoff_file:-$(dforge_latest_file)}
  case $latest in /* | [A-Za-z]:[\\/]*) ;; *) latest="$PWD/$latest" ;; esac
  [ -f "$latest" ] || gone "no handoff at $latest"
  stored=$(tr -d '\r' < "$latest" | awk '
    /^## Next session[ \t]*$/ { on = 1; print; next }
    on && /^## / { exit }
    on')
  [ -n "$stored" ] || gone "$latest has no Next session section"
  marker=$(grep -E '^<!-- next-step: .* -->$' <<<"$stored" | tail -n 1 || true)
  stored=$(grep -vE '^<!-- next-step: ' <<<"$stored" | awk 'NF { last = NR } { line[NR] = $0 } END { for (i = 1; i <= last; i++) print line[i] }')
  stored_block() { printf '%s\n%s\n' "$stored" "$marker"; exit 0; }
  if [ -z "$marker" ]; then
    at=$(stat -c %Y "$latest" 2>/dev/null || stat -f %m "$latest")
    marker="<!-- next-step: kind=none subject=- at=$at -->"
    stored_block
  fi
  m=${marker#<!-- next-step: }; m=${m% -->}
  m=${m% at=*}
  m_subject=${m#* subject=}
  m_kind="" m_branch="" m_done=0 m_closed=0
  for word in ${m%% subject=*}; do
    case $word in
      kind=*) m_kind=${word#kind=} ;;
      branch=*) m_branch=${word#branch=} ;;
      done=*) m_done=${word#done=} ;;
      closed=*) m_closed=${word#closed=} ;;
      host=codex) [ "$host_given" -eq 1 ] || host=codex ;;
    esac
  done
  case $m_done$m_closed in *[!0-9]*) gone "malformed marker counts: $marker" ;; esac
  case $m_kind in
    plan|complete|kept|draft)
      case $m_subject in -*|*[[:cntrl:]]*|'') gone "malformed marker subject: $m_subject" ;; esac
      case $m_subject in *.md) ;; *) gone "malformed marker subject: $m_subject" ;; esac ;;
  esac
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  terminal_gone=0
  recompute() { # recompute ARGS... — this script's own --print block, naming the handoff, then the marker
    local out status=0
    out=$(cd "$root" && DFORGE_NEXT_STEP_HANDOFF=$latest bash "$self" --host "$host" --print "$@") || status=$?
    if [ "$status" -ne 0 ]; then printf '%s\n' "$out"; exit "$status"; fi
    if [ "$terminal_gone" -eq 1 ] && grep -q '^\*\*Next:\*\* Nothing — ' <<<"$out"; then
      gone "the recomputed block is terminal"
    fi
    printf '%s\n%s\n' "$out" "$marker"
    exit 0
  }
  case $m_kind in
    plan)
      plan_finished "$root" "$m_subject" && gone "the plan is finished: $m_subject"
      if grep -qE '^\*\*Status:\*\* .*[1-9][0-9]* of [0-9]+ tasks complete' <<<"$stored" \
         && ! plan_ledger_any "$root" "$m_subject" >/dev/null && ! plan_finished "$root" "$m_subject"; then
        gone "the ledger is gone and the plan is unrecorded: $m_subject"
      fi
      recompute "$m_subject" ;;
    complete) terminal_gone=1; recompute --complete "$m_subject" ;;
    project) terminal_gone=1; recompute --project ;;
    kept)
      plan_finished "$root" "$m_subject" && recompute --complete "$m_subject"
      case $m_branch in
        detached:*) kept_ref="${m_branch#detached:}^{commit}" ;;
        *) kept_ref="refs/heads/$m_branch" ;;
      esac
      case $m_branch in -*|detached:-*) gone "malformed marker branch: $m_branch" ;; esac
      git -C "$primary" rev-parse --verify --quiet "$kept_ref" >/dev/null || gone "the kept branch $m_branch is gone"
      ! git -C "$primary" merge-base --is-ancestor "$kept_ref" HEAD 2>/dev/null || gone "the kept branch $m_branch is merged"
      stored_block ;;
    draft)
      [ -f "$(dforge_resolve "$m_subject" "$root")" ] || gone "the draft $m_subject is gone"
      ! draft_planned "$root" "$m_subject" || gone "a plan's Spec line names the draft $m_subject"
      stored_block ;;
    adhoc) stored_block ;;
    *) gone "unknown marker kind: ${m_kind:-none}" ;;
  esac
fi

if [ "$adhoc" -eq 1 ]; then
  case $next_action in *[.!?]) ;; *) next_action="$next_action." ;; esac
  status_line="Unplanned work: the notes in \`$own_handoff\` are the authority."
  next_line=$next_action
  launch_cmd=$(launch_for "$phase")
  prompt="Continue the unplanned work recorded in \`$own_handoff\`: $next_action"
elif [ "$project" -eq 1 ]; then
  launch=0 rel=""
  roadmap=$(roadmap_file "$root")
  current_ms="" ms_regs=""
  [ -z "$roadmap" ] || current_ms=$(roadmap_current "$roadmap")
  if [ -n "$current_ms" ]; then
    ms_id=$(cut -f1 <<<"$current_ms") ms_name=$(cut -f2 <<<"$current_ms")
    status_line="Project: milestone $ms_id ($ms_name) is current."
    ms_regs=$(roadmap_registers "$root" "$(cut -f4 <<<"$current_ms")")
    collect_rows < <(roadmap_unresolved "$root" "$(cut -f4 <<<"$current_ms")" | cut -f1 \
      | while IFS= read -r r; do dforge_resolve "$r"; done | awk '!seen[$0]++')
  else
    if [ -n "$roadmap" ]; then status_line="Project: every milestone is closed."; else status_line="Project: no roadmap."; fi
    collect_rows < <(register_files "$root")
  fi
  if [ -n "$open_rows" ]; then
    # With a current milestone only its registers are read, so no row is
    # outside it; no plan is being completed.
    ROUTE_ROOT=$root ROUTE_FINISHED="" ROUTE_MS=$current_ms ROUTE_OUTSIDE_MS=""
    route_rows <<<"$open_rows"
    # As in --complete: with no current milestone no audit awaits built rows,
    # so rows that are all built count as nothing open.
    if [ -z "$current_ms" ] && [ -n "$ROUTE_BUILT" ] && [ "$(tr ',' '\n' <<<"$ROUTE_BUILT" | grep -c .)" -eq "$(grep -c . <<<"$open_rows")" ]; then
      open_rows=""
    fi
  fi
  if [ -n "$open_rows" ]; then
    render_rows
  elif [ -n "$current_ms" ]; then
    next_line="Milestone $ms_id ($ms_name) has nothing open: audit and close it with dforge:closing-a-milestone."
    launch_cmd=$(launch_for design)
    prompt="Close milestone $ms_id ($ms_name) of \`$(dforge_name "$(dforge_docs_root)")/roadmap.md\` with dforge:closing-a-milestone."
    launch=1
  else
    next_line="Nothing — no register holds an unresolved row."
  fi
elif [ "$draft" -eq 1 ]; then
  case $next_action in *[.!?]) ;; *) next_action="$next_action." ;; esac
  status_line="Design in progress: \`$rel\` is the authority."
  next_line=$next_action
  launch_cmd=$(launch_for design)
  prompt="Continue from \`$rel\` (the authority): $next_action Read \`$own_handoff\` first."
else
  tasks=$(plan_tasks "$plan")
  [ -n "$tasks" ] || fail 3 "no tasks in ${plan} (no heading matching 'Task N')"
  total=$(wc -l <<<"$tasks" | tr -d ' ')

  execution=$(plan_header_line "$plan" Execution)
  program=$(plan_header_line "$plan" Program)

  # A Codex plan states its host in the header and its native pair on the
  # Execution line; the flag is for the paths with no plan to read.
  if plan_is_codex "$(plan_header "$plan")"; then host=codex; fi

  launch_cmd=$(execution_launch "$execution")

  # completed.md records the outcome, so an indexed plan is answered as
  # complete whatever ledger is left behind or missing.
  if [ "$complete" -eq 0 ] && [ "$kept" -eq 0 ] && plan_finished "$root" "$rel"; then complete=1; fi

  ledger_file="$(dforge_ledger_dir "$slug")/progress.md"
  ledger_root=$root
  ledger_note="no ledger at \`$ledger_file\`"
  ledger_text=""
  done_tasks=""
  blocked_tasks=""
  has_ledger=0
  if [ "$complete" -eq 0 ] && [ "$kept" -eq 0 ]; then
    # The identity line may carry the path as given on the command line: relative
    # to the checkout, absolute, or in Windows form; plan_ledger_any compares
    # resolved names, here first and then in every worktree.
    if found=$(plan_ledger_any "$root" "$plan"); then
      ledger_file=${found%%$'\t'*} ledger_root=${found#*$'\t'}
      ledger_text=$(tr -d '\r' < "$ledger_file")
      has_ledger=1
      ledger_note="ledger \`$ledger_file\`"
      done_tasks=$(ledger_done "$ledger_file")
      blocked_tasks=$(ledger_blocked "$ledger_file")
    elif [ -f "$ledger_file" ]; then
      ledger_note="the ledger at \`$ledger_file\` belongs to another plan and is ignored"
    fi
  fi

  if [ "$kept" -eq 1 ]; then
    branch=$(git -C "$root" branch --show-current 2>/dev/null | tr -d '\r')
    [ -n "$branch" ] || branch="detached HEAD $(git -C "$root" rev-parse --short HEAD 2>/dev/null | tr -d '\r')"
    status_line="Plan \`$rel\`: its branch \`$branch\` is kept unintegrated."
    next_line="The branch \`$branch\` in \`$root\` still waits for integration; run dforge:finishing-a-development-branch when you choose merge, pr or discard."
    prompt="Finish \`$rel\` with dforge:finishing-a-development-branch: the branch $branch in $root is kept unintegrated."
  elif [ "$complete" -eq 1 ]; then
    spec=$(sed -E 's/^\*\*Program:\*\*[ \t]*(`([^`]+)`|([^ \t]+)).*/\2\3/' <<<"$program")
    k=$(grep -oE 'sub-project [0-9]+ of [0-9]+' <<<"$program" | head -n 1 | awk '{print $2}' || true)
    n=$(grep -oE 'sub-project [0-9]+ of [0-9]+' <<<"$program" | head -n 1 | awk '{print $4}' || true)
    next_title=$(sed -nE 's/.*( — | – | - | -- )next:[ \t]*(.*[^ \t])[ \t]*$/\2/p' <<<"$program")
    launch=0

    # An item register outranks the Program line. `next:` is copied from the
    # program's decomposition when the plan is written, so a split decided in a
    # child spec never reaches it, and `last` alone cannot end a programme.
    reg_specs=()
    plan_spec=$(sed -E 's/^\*\*Spec:\*\*[ \t]*(`([^`]+)`|([^ \t]+)).*/\2\3/' <<<"$(plan_header_line "$plan" Spec)")
    [ -z "$plan_spec" ] || reg_specs+=("$plan_spec")
    [ -z "$spec" ] || [ "$spec" = "$plan_spec" ] || reg_specs+=("$spec")
    # On a roadmap project the current milestone's register (its epics) and
    # the registers under its epics join them, so the next epic is computed
    # from the roadmap rather than copied into a Program line.
    roadmap=$(roadmap_file "$root")
    current_ms=""
    [ -z "$roadmap" ] || current_ms=$(roadmap_current "$roadmap")
    ms_regs=""
    [ -z "$current_ms" ] || ms_regs=$(roadmap_registers "$root" "$(cut -f4 <<<"$current_ms")")
    collect_rows < <(
      { [ ${#reg_specs[@]} -eq 0 ] || register_for_spec "$root" "${reg_specs[@]}"
        if [ -n "$current_ms" ]; then
          roadmap_unresolved "$root" "$(cut -f4 <<<"$current_ms")" | cut -f1 | while IFS= read -r r; do dforge_resolve "$r"; done
        fi
      } | awk '!seen[$0]++'
    )
    if [ -n "$open_rows" ]; then
      ROUTE_ROOT=$root ROUTE_FINISHED=$rel ROUTE_MS=$current_ms ROUTE_OUTSIDE_MS=$outside_ms
      route_rows <<<"$open_rows"
      # Built rows wait on a milestone audit; with no current milestone there
      # is none, so they are left to the next step as if nothing were open.
      if [ -z "$current_ms" ] && [ -n "$ROUTE_BUILT" ] && [ "$(tr ',' '\n' <<<"$ROUTE_BUILT" | grep -c .)" -eq "$(grep -c . <<<"$open_rows")" ]; then
        open_rows=""
      fi
    fi

    if [ -n "$open_rows" ]; then
      status_line="Plan \`$rel\` is complete."
      render_rows
    elif [ -n "$roadmap" ]; then
      # The roadmap outranks the Program line. Nothing is open in the current
      # milestone, so it is ready for its audit; closing it is the only way on.
      status_line="Plan \`$rel\` is complete."
      if [ -n "$current_ms" ]; then
        ms_id=$(cut -f1 <<<"$current_ms") ms_name=$(cut -f2 <<<"$current_ms")
        next_line="Milestone $ms_id ($ms_name) has nothing open: audit and close it with dforge:closing-a-milestone."
        launch_cmd=$(launch_for design)
        prompt="Close milestone $ms_id ($ms_name) of \`$(dforge_name "$(dforge_docs_root)")/roadmap.md\` with dforge:closing-a-milestone."
        launch=1
      else
        next_line="Nothing — every milestone in \`$(dforge_name "$(dforge_docs_root)")/roadmap.md\` is closed."
      fi
    elif [ -z "$program" ]; then
      status_line="Plan \`$rel\` is complete."
      next_line="Nothing — the plan records no follow-on work."
    elif grep -qE '( — | – | - | -- )last[ \t]*$' <<<"$program" || { [ -n "$k" ] && [ "$k" -ge "$n" ]; }; then
      status_line="Plan \`$rel\` is complete${k:+; sub-project $k of $n is done}."
      next_line="Nothing — every sub-project of \`$spec\` is done."
    elif [ -n "$next_title" ] && [ -n "$k" ]; then
      k1=$((k + 1))
      status_line="Plan \`$rel\` is complete; sub-project $k of $n is done."
      next_line="Sub-project $k1 ($next_title): write its spec in a fresh session."
      launch_cmd=$(launch_for design)
      prompt="Start sub-project $k1 ($next_title) of the program in \`$spec\`: use dforge:brainstorming to write its spec."
      launch=1
    else
      status_line="Plan \`$rel\` is complete."
      next_line="Read \`$spec\` for the sub-project after ${k:-this one} — the plan's Program line names no next step."
    fi
  else
    first_open="" open_title="" done_count=0
    while IFS=$'\t' read -r num title; do
      if grep -qx "$num" <<<"$done_tasks"; then
        done_count=$((done_count + 1))
      elif [ -z "$first_open" ]; then
        first_open=$num open_title=$title
      fi
    done <<<"$tasks"

    blocked_num=$(head -n 1 <<<"$blocked_tasks")
    if [ -n "$blocked_num" ]; then
      # BLOCKED is terminal: the next session must not be told to start the
      # task. What follows the line's second dash names what a human must
      # decide (`BLOCKED — <who> — <decision>`), dashes of its own included.
      blocked_why=$(grep -E "^Task ${blocked_num}: BLOCKED" <<<"$ledger_text" | tail -n 1 \
        | awk '{ sep = " (—|-) "
                 if (match($0, sep)) { $0 = substr($0, RSTART + RLENGTH); if (match($0, sep)) $0 = substr($0, RSTART + RLENGTH) }
                 sub(/[ \t]+$/, ""); print }')
      status_line="Plan \`$rel\`: $done_count of $total tasks complete; Task $blocked_num is BLOCKED ($ledger_note)."
      next_line="Your human partner decides: ${blocked_why:-see the BLOCKED line in the ledger}. Record the ruling in the ledger, then run next-step again."
      launch=0
    elif [ -z "$first_open" ]; then
      review_state=none
      [ "$has_ledger" -eq 0 ] || review_state=$(plan_final_review_state "$ledger_file" "$(handoff_target)")
      case $review_state in
        current)
          status_line="Plan \`$rel\`: all $total tasks complete; the final review is clean."
          next_line="Run dforge:finishing-a-development-branch."
          ;;
        stale\ *)
          status_line="Plan \`$rel\`: all $total tasks complete; commits after the clean review (${review_state#stale }) are unreviewed."
          next_line="Re-review ${review_state#stale }..HEAD with the fix-wave re-review in reference/final-review.md, then append a new clean line; then dforge:finishing-a-development-branch."
          ;;
        *)
          status_line="Plan \`$rel\`: all $total tasks complete."
          case $review_state in
            rewritten\ *) status_line="Plan \`$rel\`: all $total tasks complete; the reviewed head ${review_state#rewritten } is no longer in the branch history." ;;
          esac
          next_line="Run the final whole-branch review, then dforge:finishing-a-development-branch."
          ;;
      esac
    elif [ "$done_count" -eq 0 ]; then
      status_line="Plan \`$rel\`: 0 of $total tasks complete ($ledger_note)."
      next_line="Start at Task $first_open ($open_title)."
    else
      status_line="Plan \`$rel\`: $done_count of $total tasks complete ($ledger_note)."
      next_line="Resume at Task $first_open ($open_title)."
    fi

    # With a ledger there is state to verify before continuing, which is
    # resume-execution's job; without one the plan starts at the skill's Setup,
    # which a session that arrives through a compaction would otherwise skip.
    if [ "$launch" -eq 0 ]; then
      prompt=""
    elif [ "$has_ledger" -eq 1 ]; then
      prompt="Resume \`$rel\` with dforge:resume-execution. $next_line"
    else
      prompt="Continue \`$rel\` with dforge:executing-plans. No ledger exists yet: begin at the skill's Setup, workspace first; the first task is Task $first_open ($open_title)."
    fi
    if [ "$has_ledger" -eq 1 ]; then
      prompt="$prompt Progress ledger: \`$ledger_file\` — trust its \`Task N: complete\` lines."
    fi
  fi
fi

# T's handoff is resolved in a subshell, so the cached roots stay this
# checkout's.
dir=$(handoff_target)
# A recompute of a named handoff (--print --handoff) names that file.
if [ "$print_only" -eq 1 ] && [ -n "${DFORGE_NEXT_STEP_HANDOFF:-}" ]; then handoff=$DFORGE_NEXT_STEP_HANDOFF
else handoff=$(dforge_stores_init "$dir"; dforge_handoff_file "$key" "$dir"); fi
if [ "$target_only" -eq 1 ]; then printf '%s\n' "$handoff"; exit 0; fi

# Every prompt opens on T: an auto run's cockpit pastes it into a cleared
# session where no launch line ran, so the prompt itself says where to work.
if [ -n "$prompt" ]; then
  t_branch=$(git -C "$dir" branch --show-current 2>/dev/null | tr -d '\r')
  if [ -n "$t_branch" ]; then t_where="branch $t_branch"
  else t_where="detached at \`$(git -C "$dir" rev-parse --short HEAD 2>/dev/null | tr -d '\r')\`"; fi
  prompt="Start in \`$dir\` ($t_where); its handoff is \`$handoff\`. If your working directory is not \`$dir\`, enter it first. $prompt"
fi

# A block printed over running work invites ending the session it would die
# with, so nothing is printed while this session still has background work
# listed. Without a transcript (Codex, tests) there is nothing to check.
# Services alone do not stop it, since they never end; the block names them.
services_line=""
if [ "$print_only" -eq 1 ]; then :
elif running=$(bash "$(cd "$(dirname "$0")" && pwd)/in-flight" 2>/dev/null); then
  services=$(sed -n 's/^- \([a-z]*\) \([^ ]*\) [^ ]* idle [^ ]* \(.*\) (service)$/\1 \2 (\3)/p' <<<"$running" | awk 'NR > 1 { printf ", " } { printf "%s", $0 }')
  [ -z "$services" ] || services_line="Still running services: $services — stop them with TaskStop before you end the session."
else
  if [ $? -eq 1 ]; then
    printf '%s\n' "$running"
    fail 5 "not printing the next-step block while background work runs; resolve the list above, then run next-step again"
  fi
fi

block=$(
  printf '## Next session\n\n**Status:** %s\n**Next:** %s\n' "$status_line" "$next_line"
  [ -z "$services_line" ] || printf '%s\n' "$services_line"
  if [ "$launch" -eq 1 ]; then
    if [ -n "$launch_cmd" ]; then
      # A POSIX shell runs the cd; PowerShell 5.1 has no && and cmd.exe keeps
      # single quotes, so a Windows host (cygpath on PATH) gets the bare command.
      command -v cygpath >/dev/null 2>&1 || launch_cmd="cd '$(sed "s/'/'\\\\''/g" <<<"$dir")' && $launch_cmd"
      printf '\nLaunch in `%s`:\n\n```\n%s\n```\n' "$dir" "$launch_cmd"
    else
      printf '\nLaunch from `%s`: see the **Execution:** line in `%s`.\n' "$dir" "${launch_plan:-$rel}"
    fi
    printf '\nPaste as the first prompt:\n\n```\n%s\n```\n' "$prompt"
  fi
)
printf '%s\n' "$block"
[ "$print_only" -eq 0 ] || exit 0

# The no-plan finish record has done its job once finishing has an outcome;
# left behind, the next unplanned finish would act on it without asking.
# finish-choice writes it under the checkout it runs in, a linked worktree
# included, so both that checkout's and the primary's are cleared.
if [ "$complete" -eq 1 ] || [ "$kept" -eq 1 ] || [ "$adhoc" -eq 1 ]; then
  rm -f "$(dforge_dir state "$root")/sdd/finish.json" "$(dforge_dir state "$primary")/sdd/finish.json"
fi

today=$(date -u +%Y-%m-%d)
if [ "$adhoc" -eq 1 ]; then marker_kind=adhoc marker_subject=-
elif [ "$project" -eq 1 ]; then marker_kind=project marker_subject=-
elif [ "$draft" -eq 1 ]; then marker_kind=draft marker_subject=$rel
elif [ "$kept" -eq 1 ]; then
  case $branch in "detached HEAD "*) marker_kind="kept branch=detached:${branch##* }" ;; *) marker_kind="kept branch=$branch" ;; esac
  marker_subject=$rel
elif [ "$complete" -eq 1 ]; then marker_kind=complete marker_subject=$rel
else marker_kind=plan marker_subject=$rel
fi
read -r marker_done marker_closed < <(handoff_counts "$primary")
marker_host=""; [ "$host" != codex ] || marker_host=" host=codex"
marker="<!-- next-step: kind=$marker_kind key=$key session=${session_id:--}$marker_host done=$marker_done closed=$marker_closed subject=$marker_subject at=$(date +%s) -->"
# Read, merged and replaced under the handoff's lock, so a concurrent writer's
# notes are never overwritten with the copy read before them.
write_handoff() {
  local tmp status=0 wholesale=0
  case $handoff in */.dforge/handoff/*.md) dforge_state_ignore "${handoff%/.dforge/handoff/*}" ;; esac
  tmp=$(mktemp) || return 1
  if [ ! -f "$handoff" ] || [ "$complete" -eq 1 ] || [ "$kept" -eq 1 ]; then wholesale=1; fi
  if [ -n "$notes_file" ]; then
    # The notes as given, without their trailing blank lines, then the block.
    { printf '# Handoff — %s\n\n' "$today"
      tr -d '\r' < "$notes_file" | awk 'NF { last = NR } { line[NR] = $0 } END { for (i = 1; i <= last; i++) print line[i]; if (last) print "" }'
      printf '%s\n%s\n' "$block" "$marker"
    } > "$tmp" || status=1
  elif [ "$wholesale" -eq 1 ]; then
    printf '# Handoff — %s\n\n%s\n%s\n' "$today" "$block" "$marker" > "$tmp" || status=1
  else
    # Replace only the Next session section; the rest is the session's own notes.
    BLOCK="$block"$'\n'"$marker" awk '
      /^## Next session[ \t\r]*$/ { print ENVIRON["BLOCK"]; skip = 1; found = 1; next }
      skip && /^## / { skip = 0; print "" }
      !skip { print }
      END { if (!found) { print ""; print ENVIRON["BLOCK"] } }
    ' "$handoff" > "$tmp" || status=1
  fi
  [ "$status" -ne 0 ] || dr_replace "$handoff" "$tmp" || status=1
  rm -f "$tmp"
  return "$status"
}
if ! { mkdir -p "$(dirname "$handoff")" && handoff_lock=$(dr_lock_base "$handoff"); } 2>/dev/null; then
  fail 4 "could not write $handoff — copy the block above into it by hand"
fi
if ! dr_locked "$handoff_lock" write_handoff 2>/dev/null; then
  fail 4 "could not write $handoff — copy the block above into it by hand"
fi
[ -z "$notes_file" ] || rm -f "$notes_file"
