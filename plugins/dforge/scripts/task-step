#!/usr/bin/env bash
# One command per mechanical step of a risk-3 task's session review loop
# (reference/delegated-task.md §The session review loop): each writes the
# filled prompt to a file in the plan workspace and prints a digest of at most
# 15 lines. A task's state lives in <workspace>/task-<N>-step.json; review
# builds it from the task's open line, which task-brief --open writes.
#
# Usage: task-step review PLAN_FILE N [--suite COMMAND] [--suite-base SHA]
#        task-step rereview PLAN_FILE N
#        task-step verdict PLAN_FILE N [--rereview R]
# Exit: 0 ok; 2 usage, or any subcommand on a Host: codex plan; 3 no such task;
# 4 an amendment does not apply; 5 (verdict) the seat
# wrote no report, or one outside the grammar; 6 a required earlier step has
# not run, or (verdict) a tracked file changed during the review; 7 the fix
# loop is at its two-round cap (rereview), or (verdict) the step file names a
# suite command with no record at the review head.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/plan.sh"
. "$HERE/lib/timeout.sh"

die() { printf 'task-step: %s\n' "$1" >&2; exit "${2:-2}"; }
# plan_budget_line SCRIPTS CALLER PLAN_SRC LEDGER — the session budget line,
# naming the plan's tail or final phase as the brief does.
plan_budget_line() {
  local mode=()
  read -r -a mode <<<"$(. "$1/lib/context.sh" && ctx_plan_mode "$3" "$4" 2>/dev/null)" || mode=()
  DFORGE_BUDGET_CALLER=$2 bash "$1/context-size" ${mode[@]+"${mode[@]}"} 2>/dev/null
}
usage() { die "usage: task-step review PLAN_FILE N [--suite COMMAND] [--suite-base SHA] | rereview PLAN_FILE N | verdict PLAN_FILE N [--rereview R]"; }

# dirty_list DIR [-w]: "<path>\t<hash>" for each tracked path that differs from
# HEAD, sorted; the hash is git's content hash, or "deleted". Paths are
# relative to the work tree's top, so they are hashed from there. Fails when
# git cannot list or hash them: an empty list must mean a clean tree. -w also
# writes each content to the object store, so a later restore can read it back.
dirty_list() {
  local root names p h write=${2:-}
  root=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null | tr -d '\r')
  [ -n "$root" ] || return 1
  names=$(git -C "$1" -c core.quotepath=off diff --name-only --no-renames HEAD) || return 1
  [ -n "$names" ] || return 0
  printf '%s\n' "$names" | tr -d '\r' | LC_ALL=C sort |
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      if [ -f "$root/$p" ]; then
        h=$(git -C "$root" hash-object ${write:+"$write"} -- "$p" | tr -d '\r')
        [ -n "$h" ] || exit 1
        printf '%s\t%s\n' "$p" "$h"
      else
        printf '%s\tdeleted\n' "$p"
      fi
    done
}

# tracked_snapshot DIR: what a later verdict compares, as one JSON object
# {cwd, head, dirty: [{path, hash}]}. Fails, printing nothing, when DIR is not
# inside a git work tree or its tracked files cannot be listed.
tracked_snapshot() {
  local head dirty
  [ "$(git -C "$1" rev-parse --is-inside-work-tree 2>/dev/null | tr -d '\r')" = true ] || return 1
  head=$(git -C "$1" rev-parse HEAD 2>/dev/null | tr -d '\r')
  [ -n "$head" ] || return 1
  dirty=$(dirty_list "$1" -w) || return 1
  printf '%s' "$dirty" | jq -R -s -c --arg cwd "$1" --arg head "$head" \
    '{cwd: $cwd, head: $head, dirty: [split("\n")[] | select(. != "") | split("\t") | {path: .[0], hash: .[1]}]}'
}

# suite_key COMMAND: the key suite-run records for `suite-run -- bash -c COMMAND`
# run from the top level: column 3 of suites.tsv.
suite_key() {
  local k
  k=$(printf '%q ' bash -c "$1")
  printf '%s\n' "${k% }"
}

# suite_row STEP_FILE SHA [DIR]: the last suites.tsv row whose HEAD is SHA and
# whose command is the step file's `suite`, from the state directory of DIR
# (default: the current directory). Prints nothing without a row or a suite.
suite_row() {
  local cmd sdir key
  cmd=$(jq -r '.suite // empty' "$1" 2>/dev/null | tr -d '\r')
  [ -n "$cmd" ] || return 0
  sdir=$(cd "${3:-.}" && bash "$HERE/dforge-path" state | tr -d '\r') || return 0
  [ -f "$sdir/suites.tsv" ] || return 0
  key=$(suite_key "$cmd")
  tr -d '\r' < "$sdir/suites.tsv" | RH=$2 K=$key awk -F'\t' '
    $1 == ENVIRON["RH"] && $3 == ENVIRON["K"] { row = $0 }
    END { if (row != "") print row }'
}

# suite_failing_lines LOG: the failing lines of a suite log, numbers dropped
# from TAP "not ok" lines so the same test reads the same at two commits.
suite_failing_lines() {
  [ -f "$1" ] || return 0
  tr -d '\r' < "$1" | grep -E '^[[:space:]]*(not ok|\(fail\)|FAIL)' | cut -c1-200 | sed -E 's/^([[:space:]]*not ok) [0-9]+/\1/'
}

# suite_fail_set LOG CODE: the failing lines of a failed run's log, one per
# line, or "command exit CODE (unnamed <epoch>-<pid>)" when the log holds none.
# A failure no test line names cannot be shown to be the same failure at the
# base and the head, so the marker makes the two lines differ: an unnamed head
# failure is never excused by an unnamed base failure. Each call runs in its
# own $(…) subshell, whose $BASHPID differs.
suite_fail_set() {
  local lines
  lines=$(suite_failing_lines "$1" || true)
  if [ -n "$lines" ]; then printf '%s\n' "$lines"
  else printf 'command exit %s (unnamed %s-%s)\n' "$2" "$(date +%s)" "$BASHPID"; fi
}

# header_command TEXT: the command a header value names, as task-brief's
# check_command reads it: its first `…` code span, so a trailing note is never
# run; "none" for a value that begins with none; the trimmed value when it has
# no span.
header_command() {
  local v
  v=$(printf '%s' "$1" | sed -E 's/^[[:blank:]]+//; s/[[:blank:]]+$//')
  if [[ $v == none* ]]; then printf 'none'
  elif [[ $v =~ \`([^\`]+)\` ]]; then printf '%s' "${BASH_REMATCH[1]}"
  else printf '%s' "$v"
  fi
}

# suite_unfinished CODE: succeeds for an exit that says the run was cut short
# (124 timed out or was killed) or could not start or was signalled (126 and
# up), whatever its partial log shows.
suite_unfinished() {
  [ "$1" = 124 ] || { [[ $1 =~ ^[0-9]+$ ]] && [ "$1" -ge 126 ]; }
}

# suite_base_sha STEP_FILE: the commit a step file's suite is compared with,
# the suiteBase review recorded or else the task's own base.
suite_base_sha() {
  local base
  base=$(jq -r '.suiteBase // empty' "$1" | tr -d '\r')
  [ -n "$base" ] || base=$(jq -r '.base // empty' "$1" | tr -d '\r')
  printf '%s\n' "$base"
}

# require_step_file FILE: exits 6 unless FILE is valid JSON. Call it from the
# shell that reads the step file: an exit inside $(…) leaves only that subshell.
require_step_file() {
  jq -e . "$1" >/dev/null 2>&1 || die "cannot read $1" 6
}

# run_at_base BASE_SHA COMMAND OUT_LOG [SECONDS]: runs COMMAND once at
# BASE_SHA in a temporary detached worktree, after the plan header's
# **Worktree setup:** command when it names one, through suite-run --timeout
# SECONDS (default 600). The setup is bounded by the same SECONDS and its
# output is kept in OUT_LOG.setup.log, which is removed when no setup runs.
# Copies the run's log to OUT_LOG and prints the command's exit code; a setup
# that times out prints 124 and returns 0, with the setup log as OUT_LOG.
# Prints nothing, and returns 1, when the worktree cannot be made, the setup
# fails or the run's log is missing. The header is read from $src, the amended
# plan, when the caller has one.
base_cleanup() { # base_cleanup DIR: also prunes a base worktree made in DIR
  local pruned=0
  [ ! -e "$1/base-worktree" ] || pruned=1
  rm -rf "$1"
  [ "$pruned" -eq 0 ] || git worktree prune >/dev/null 2>&1
}

run_at_base() {
  local sha=$1 cmd=$2 out=$3 secs=${4:-600} wt line setup="" run log code scode=0 rc=1
  if [ -n "${src:-}" ] && [ -f "$src" ]; then
    line=$(plan_header_line "$src" 'Worktree setup')
    setup=$(header_command "${line#\*\*Worktree setup:\*\*}")
    [ "$setup" != none ] || setup=""
  fi
  # Under BASE_TMP, so a run killed mid-suite (a foreground call past its cap)
  # still loses the checkout to the EXIT trap, which then prunes its entry.
  wt=$(mktemp -d "$BASE_TMP/base.XXXXXX") || return 1
  : > "$BASE_TMP/base-worktree"
  if command -v cygpath >/dev/null 2>&1; then wt=$(cygpath -m "$wt"); fi
  if ! git worktree add --detach "$wt" "$sha" >/dev/null 2>&1; then
    rm -rf "$wt"
    echo "task-step: cannot create a worktree at ${sha:0:7}" >&2
    return 1
  fi
  if [ -n "$setup" ]; then
    (cd "$wt" && dforge_timeout && "$DFORGE_TIMEOUT" -k "${SUITE_RUN_KILL_AFTER:-10}" "$secs" bash -c "$setup" < /dev/null) > "$out.setup.log" 2>&1
    scode=$?
    [ "$scode" -ne 137 ] || scode=124
  else
    rm -f "$out.setup.log"
  fi
  if [ "$scode" -eq 124 ]; then
    if cp "$out.setup.log" "$out"; then
      printf '124\n'
      rc=0
    fi
  elif [ "$scode" -ne 0 ]; then
    echo "task-step: the worktree setup failed at ${sha:0:7} (log $out.setup.log)" >&2
  else
    run=$(cd "$wt" && bash "$HERE/suite-run" --timeout "$secs" -- bash -c "$cmd")
    code=$?
    log=$(printf '%s\n' "$run" | tr -d '\r' | sed -n 's/^log: //p' | tail -n 1)
    if [ -n "$log" ] && [ -f "$log" ] && cp "$log" "$out"; then
      printf '%s\n' "$code"
      rc=0
    fi
  fi
  git worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
  git worktree prune >/dev/null 2>&1
  return $rc
}

# suite_base_lines STEP_FILE N [DIR]: the base commit's failing lines for the
# step file's suite command, one per line, nothing for a passing base. The
# base is suite_base_sha's. It reuses a suites.tsv row at the base in the
# checkout's state (then DIR's), then <workspace>/task-N-base-failures.txt, and
# only then runs the suite at the base, for TASK_STEP_BASE_TIMEOUT seconds
# (default 3600). A base run that cannot start writes no file, so a later call
# tries again; one that timed out leaves task-N-base-timeout, so a later call
# does not run it again. Every failing line counts as new meanwhile.
# STEP_FILE has passed require_step_file in the caller.
suite_base_lines() {
  local step=$1 n=$2 dir=${3:-} cmd base ws file marker row code log
  cmd=$(jq -r '.suite // empty' "$step" | tr -d '\r')
  base=$(suite_base_sha "$step")
  [ -n "$cmd" ] && [ -n "$base" ] || return 0
  ws=$(dirname "$step")
  file=$ws/task-$n-base-failures.txt
  marker=$ws/task-$n-base-timeout
  row=$(suite_row "$step" "$base")
  [ -n "$row" ] || [ -z "$dir" ] || row=$(suite_row "$step" "$base" "$dir")
  if [ -n "$row" ]; then
    code=$(cut -f4 <<<"$row")
    log=$(cut -f5 <<<"$row")
    [ "$code" != 0 ] || return 0
    if [ "$code" != 124 ] && [ -f "$log" ]; then
      suite_fail_set "$log" "$code"
      return 0
    fi
  fi
  if [ -f "$file" ]; then cat "$file"; return 0; fi
  if [ -f "$marker" ]; then
    echo "task-step: the base run at ${base:0:7} timed out earlier; every failing line counts as new" >&2
    return 0
  fi
  if ! code=$(run_at_base "$base" "$cmd" "$ws/task-$n-base.log" "${TASK_STEP_BASE_TIMEOUT:-3600}"); then
    echo "task-step: no base run at ${base:0:7}; every failing line counts as new" >&2
    return 0
  fi
  if [ "$code" = 124 ]; then
    : > "$marker"
    echo "task-step: the base run at ${base:0:7} timed out; every failing line counts as new" >&2
    return 0
  fi
  if [ "$code" = 0 ]; then
    : > "$file"
  else
    suite_fail_set "$ws/task-$n-base.log" "$code" > "$file"
  fi
  cat "$file"
}

# drop_base_cache STEP_FILE N OLD_BASE: removes task N's cached base run when
# the step file's suite base (suite_base_sha) is no longer OLD_BASE, the one
# read before the step file was rewritten. The cache is keyed by task, not by
# commit, so it would otherwise answer for a base it was not run at.
drop_base_cache() {
  local ws
  [ "$(suite_base_sha "$1")" != "$3" ] || return 0
  ws=$(dirname "$1")
  rm -f "$ws/task-$2-base-failures.txt" "$ws/task-$2-base-timeout" "$ws/task-$2-base.log" "$ws/task-$2-base.log.setup.log"
}

NONE_RE='^\*\*Task check:\*\*[[:space:]]*none([[:space:]]|$)'

# require_scheduled_suite STEP_FILE N: exits 2 when the plan's task check
# is none, task N is due the integration check (a multiple of 3, or
# the last task), and neither --suite nor STEP_FILE names a suite. verdict
# would otherwise read the task as not scheduled.
require_scheduled_suite() {
  local step=$1 n last
  shift
  [ -z "$suite_arg" ] || return 0
  [ -z "$(jq -r '.suite // empty' "$step" 2>/dev/null | tr -d '\r')" ] || return 0
  [[ $(plan_header_line "$src" "Task check") =~ $NONE_RE ]] || return 0
  last=$(plan_tasks "$src" | awk -F'\t' '$1 + 0 > m { m = $1 + 0 } END { print m + 0 }')
  for n in "$@"; do
    if [ $((n % 3)) -eq 0 ] || [ "$n" -eq "$last" ]; then
      die "Task $n is due the integration check (task check none): pass --suite <integration check> --suite-base <sha>"
    fi
  done
}

# require_suite_base BASE_SHA N: exits 2 unless --suite-base is BASE_SHA, task
# N's base, or an ancestor of it. A commit inside the task's own range, such
# as its earlier head, would excuse the task's regressions as base failures.
require_suite_base() {
  [ -n "$suite_base_sha_arg" ] || return 0
  git merge-base --is-ancestor "$suite_base_sha_arg" "$1" 2>/dev/null \
    || die "--suite-base ${suite_base_sha_arg:0:7} is not Task $2's base ${1:0:7} or an ancestor of it"
}

rr_usage() {
  echo "usage: task-step rereview PLAN_FILE N" >&2
  exit 2
}

rr_render() { # rr_render TEMPLATE FINDINGS_FILE — the fenced prompt body, de-indented, placeholders filled from RR_*
  awk -v findings="$2" '
    function rep(s, key, val,   out, i) {
      out = ""
      while ((i = index(s, key)) > 0) { out = out substr(s, 1, i - 1) val; s = substr(s, i + length(key)) }
      return out s
    }
    BEGIN { while ((getline line < findings) > 0) fl = fl (fl == "" ? "" : "\n") line }
    { sub(/\r$/, "") }
    !fenced { if ($0 == "```") fenced = 1; next }
    !body { if ($0 ~ /^[ ]+prompt: \|$/) body = 1; next }
    $0 == "```" { exit }
    {
      sub(/^    /, "")
      if ($0 == "[FINDINGS]") { print fl; next }
      $0 = rep($0, "[BRIEF_FILE]", ENVIRON["RR_BRIEF"])
      $0 = rep($0, "[IMPLEMENTER_REPORT_FILE]", ENVIRON["RR_REPORT"])
      $0 = rep($0, "[REPORT_FILE]", ENVIRON["RR_JUDGE_REPORT"])
      $0 = rep($0, "[FIX_BASE_SHA]", ENVIRON["RR_FIX_BASE"])
      $0 = rep($0, "[HEAD_SHA]", ENVIRON["RR_HEAD"])
      $0 = rep($0, "[DIFF_FILE]", ENVIRON["RR_DIFF"])
      print
    }
  ' "$1"
}

# A subshell body: every exit below leaves only the subshell, so the
# dispatch branch passes the status on.
cmd_rereview() (
  local here plan_arg plan tmp src header ws state first t
  local fix bullets nopen review_head round new_round head_ref head_sha fix_base fix_base_sha
  local pkg diff_file now prompt tpl check_dir snap old_base
  here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  . "$here/lib/plan.sh"
  [ $# -eq 2 ] && [[ $2 =~ ^[0-9]+$ ]] || rr_usage
  plan_arg=$1 first=$((10#$2))

  plan=$(plan_locate "$plan_arg")
  [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
  dforge_stores_init "$(_plan_ctx "$plan")"
  tmp=$(mktemp -d)
  BASE_TMP=$tmp
  trap 'base_cleanup "$tmp"' EXIT
  src=$tmp/plan.md
  plan_amendments_ready "$plan"
  if ! plan_apply_amendments "$plan" "$(plan_amendments_file "$plan")" > "$src" 2> "$tmp/err"; then
    cat "$tmp/err" >&2
    exit 4
  fi
  header=$(plan_header "$src")
  if plan_is_codex "$header"; then
    echo "task-step: a Host: codex plan runs the Codex loop; task-step does not apply" >&2
    exit 2
  fi
  plan_require_same_project "$plan"
  plan_task_text "$src" "$first" >/dev/null || { echo "task $first not found in $plan" >&2; exit 3; }

  ws=$(dforge_workspace "$(basename "$plan" .md)" "$(_plan_ctx "$plan")")
  state=$ws/task-$first-step.json
  review_head=""
  [ ! -f "$state" ] || review_head=$(jq -r '.reviewHead // empty' "$state" | tr -d '\r')
  if [ -z "$review_head" ]; then
    echo "task-step: rereview before review: run task-step review for task $first first" >&2
    exit 6
  fi
  round=$(jq -r '.round // 0' "$state" | tr -d '\r')
  new_round=$((round + 1))
  if [ "$new_round" -gt 2 ]; then
    echo "task-step: fix round $new_round is past the cap of 2; send the open findings to the breaker (reference/delegated-task.md §4)" >&2
    exit 7
  fi

  fix=$ws/task-$first-fix-$new_round.md
  if [ ! -f "$fix" ]; then
    echo "task-step: no fix message $fix; write it before rereview" >&2
    exit 6
  fi
  bullets=$(awk '{ sub(/\r$/, "") } /^- / { print; next } { exit }' "$fix")
  nopen=$(printf '%s\n' "$bullets" | awk 'NF { n++ } END { print n + 0 }')
  if [ "$nopen" -lt 1 ]; then
    echo "task-step: $fix must start with one '- <file>: <finding>' bullet per open finding" >&2
    exit 2
  fi

  # A step file written before 5.0 may name a head ref; it still packages to it.
  head_ref=$(jq -r '.head // empty' "$state" | tr -d '\r')
  [ -n "$head_ref" ] || head_ref=HEAD
  head_sha=$(git rev-parse --verify --quiet "$head_ref^{commit}") || { echo "bad HEAD: $head_ref" >&2; exit 2; }
  fix_base_sha=$(git rev-parse --verify --quiet "$review_head^{commit}") || { echo "bad BASE: $review_head" >&2; exit 2; }

  pkg=$(bash "$here/review-package" "$plan" "$fix_base_sha" "$head_sha") || { printf '%s\n' "$pkg" >&2; exit 2; }
  diff_file=$(printf '%s\n' "$pkg" | sed -n -E '/^wrote /{s/^wrote (.*): [0-9]+ commit\(s\), [0-9]+ bytes$/\1/;p;q;}')

  prompt=$ws/task-$first-rereview-$new_round-prompt.md
  tpl=$here/../reference/prompts/re-review-prompt.md
  [ -f "$tpl" ] || { echo "task-step: missing template $tpl" >&2; exit 2; }
  printf '%s\n\nThe fix message holds each finding'"'"'s detail: %s\n' "$bullets" "$fix" > "$tmp/findings"
  judge_report=$ws/task-$first-rereview-$new_round-report.md
  RR_BRIEF=$ws/task-$first-brief.md RR_REPORT=$ws/task-$first-report.md RR_JUDGE_REPORT=$judge_report \
    RR_FIX_BASE=$fix_base_sha RR_HEAD=$head_sha RR_DIFF=$diff_file rr_render "$tpl" "$tmp/findings" > "$tmp/prompt"
  if grep -qE '\[(BRIEF_FILE|FINDINGS|IMPLEMENTER_REPORT_FILE|REPORT_FILE|FIX_BASE_SHA|HEAD_SHA|DIFF_FILE|MODEL)\]' "$tmp/prompt"; then
    echo "task-step: $tpl holds a placeholder rereview does not fill" >&2
    exit 2
  fi
  rm -f "$judge_report"
  cp "$tmp/prompt" "$prompt"

  check_dir=$(jq -r '.reviewCheck.cwd // empty' "$state" | tr -d '\r')
  [ -n "$check_dir" ] || check_dir=$(git rev-parse --show-toplevel | tr -d '\r')
  snap=$(tracked_snapshot "$check_dir") || {
    echo "task-step: cannot record the tracked files of $check_dir for the verdict check" >&2
    exit 2
  }
  now=$(date +%s)
  old_base=$(suite_base_sha "$state")
  jq --arg rh "$head_sha" --argjson r "$new_round" --argjson t "$now" --argjson chk "$snap" \
    '.reviewHead = $rh | .round = $r | .t0 = $t | .reviewCheck = $chk' \
    "$state" > "$state.tmp" && mv "$state.tmp" "$state" || die "cannot update $state"
  drop_base_cache "$state" "$first" "$old_base"

  printf 'task %s: re-review round %s: packaged %s..%s, prompt written\n' "$first" "$new_round" "${fix_base_sha:0:7}" "${head_sha:0:7}"
  printf 'seat: dforge:judge-sonnet-high prompt: %s\n' "$prompt"
  printf 'state: base %s review-head %s round %s t0 %s\n' \
    "$(jq -r '.base' "$state" | tr -d '\r' | cut -c1-7)" "${head_sha:0:7}" "$new_round" "$now"
  # review-package already measured the session; its line is the digest's.
  budget=$(grep -E '^budget' <<<"$pkg" | tail -n 1)
  printf '%s\n' "${budget:-budget: unknown}"
)

if [ "${1:-}" = rereview ]; then
  shift
  cmd_rereview "$@"
  exit $?
fi
[ $# -ge 3 ] || usage
sub=$1; shift
case $sub in review|verdict) ;; *) usage ;; esac
plan_arg=$1; shift

first="" rereview_arg="" suite_arg="" suite_base_arg="" suite_base_sha_arg=""
while [ $# -gt 0 ]; do
  case $1 in
    --suite) [ "$sub" = review ] && [ $# -ge 2 ] && [ -n "$2" ] || usage; suite_arg=$2; shift 2 ;;
    --suite-base) [ "$sub" = review ] && [ $# -ge 2 ] && [ -n "$2" ] || usage; suite_base_arg=$2; shift 2 ;;
    --rereview) [ "$sub" = verdict ] && [ $# -ge 2 ] && [[ $2 =~ ^[1-9][0-9]*$ ]] || usage; rereview_arg=$2; shift 2 ;;
    -*) usage ;;
    *) [ -z "$first" ] && [[ $1 =~ ^[0-9]+$ ]] || usage; first=$((10#$1)); shift ;;
  esac
done
[ -n "$first" ] || usage
# Without its base, a review's suite would be compared with the task's own base.
[ -z "$suite_arg" ] || [ -n "$suite_base_arg" ] || usage
if [ -n "$suite_base_arg" ]; then
  suite_base_sha_arg=$(git rev-parse --verify --quiet "$suite_base_arg^{commit}" 2>/dev/null | tr -d '\r') \
    && [ -n "$suite_base_sha_arg" ] || die "bad --suite-base: $suite_base_arg"
fi

plan=$(plan_locate "$plan_arg")
[ -f "$plan" ] || die "no such plan file: $plan"
plan_require_same_project "$plan"
ctx=$(_plan_ctx "$plan")
dforge_stores_init "$ctx"

TMP=$(mktemp -d)
BASE_TMP=$TMP
trap 'base_cleanup "$TMP"' EXIT
src="$TMP/plan.md"
plan_amendments_ready "$plan"
plan_apply_amendments "$plan" "$(plan_amendments_file "$plan")" > "$src" 2>/dev/null \
  || die "an amendment does not apply; run plan-lint" 4
if plan_is_codex "$(plan_header "$src")"; then
  die "a Host: codex plan runs the Codex loop (reference/native-codex.md); task-step is for Claude Code"
fi
plan_task_text "$src" "$first" >/dev/null || die "no Task $first in $plan" 3

slug=$(basename "$plan" .md)
ws=$(dforge_workspace "$slug" "$ctx")
ledger="$(dforge_ledger_dir "$slug" "$ctx")/progress.md"
state="$ws/task-$first-step.json"
plugin_root=$(cd "$HERE/.." && pwd)
brief="$ws/task-$first-brief.md"
report="$ws/task-$first-report.md"

budget_of() { grep -E '^budget' | tail -n 1; }

# The fenced `prompt: |` body of a template, de-indented, without the
# "[Include this section only ...]" instruction lines.
prompt_text() {
  tr -d '\r' < "$1" | awk '
    /^  prompt: \|[ \t]*$/ && !done { on = 1; next }
    on && /^```/ { on = 0; done = 1; next }
    on { sub(/^    /, "") }
    on && !/^\[Include this section only/ { print }'
}

# fill TOKEN VALUE [TOKEN VALUE ...]: stdin to stdout, each literal TOKEN
# replaced by its VALUE. The pairs travel in the environment so that a path
# with a backslash or an ampersand is never read as an escape.
fill() {
  local i=0
  while [ $# -ge 2 ]; do export "TS_T$i=$1" "TS_V$i=$2"; i=$((i + 1)); shift 2; done
  TS_N=$i awk '
    BEGIN { n = ENVIRON["TS_N"] + 0 }
    {
      line = $0
      for (k = 0; k < n; k++) {
        t = ENVIRON["TS_T" k]; v = ENVIRON["TS_V" k]; out = ""
        while ((p = index(line, t)) > 0) { out = out substr(line, 1, p - 1) v; line = substr(line, p + length(t)) }
        line = out line
      }
      print line
    }'
}

# drop_sections HEADING ...: stdin to stdout without the `## ` sections whose
# heading begins with one of the given words.
drop_sections() {
  local list="" h
  for h in "$@"; do list="$list${list:+|}$h"; done
  TS_DROP=$list awk '
    BEGIN { n = split(ENVIRON["TS_DROP"], d, "|") }
    /^## / { skip = 0; for (i = 1; i <= n; i++) if (index($0, "## " d[i]) == 1) skip = 1 }
    !skip { print }'
}

# Every commit from $1 to $2 is authored and committed by the configured
# user. Prints the digest line.
check_identity() {
  local un ue sha an ae cn ce who bad="" count=0
  un=$(git -C "${top:-.}" config user.name | tr -d '\r') ue=$(git -C "${top:-.}" config user.email | tr -d '\r')
  if [ -z "$un" ] || [ -z "$ue" ]; then echo "check identity: no git user.name and user.email configured"; return; fi
  while IFS=$'\x1f' read -r sha an ae cn ce; do
    [ -n "$sha" ] || continue
    who=""
    if [ "$an" != "$un" ] || [ "$ae" != "$ue" ]; then who="author $an <$ae>"; fi
    if [ "$cn" != "$un" ] || [ "$ce" != "$ue" ]; then who="${who:+$who, }committer $cn <$ce>"; fi
    [ -n "$who" ] || continue
    count=$((count + 1))
    [ -n "$bad" ] || bad="$sha $who"
  done < <(git -C "${top:-.}" log --reverse --format='%h%x1f%an%x1f%ae%x1f%cn%x1f%ce' "$1..$2" | tr -d '\r')
  if [ "$count" -eq 0 ]; then echo "check identity: clean"; return; fi
  echo "check identity: $bad (expected $un <$ue>)$([ "$count" -le 1 ] || echo "; $((count - 1)) more commit(s)")"
}

# No commit from $1 to $2 carries an attribution trailer (a co-author or a
# session line) or a line that begins "Generated with", after any leading
# symbols such as a bullet or an emoji. A mention inside a sentence is not
# attribution. Prints the digest line.
check_attribution() {
  local sha hit bad="" count=0
  for sha in $(git -C "${top:-.}" rev-list --reverse "$1..$2" | tr -d '\r'); do
    hit=$(git -C "${top:-.}" log -1 --format=%B "$sha" | tr -d '\r' | grep -iE '^[[:space:]]*(co-authored-by|claude-session):|^[^[:alnum:]]*generated with' | head -n 1)
    [ -n "$hit" ] || continue
    count=$((count + 1))
    [ -n "$bad" ] || bad="$(git -C "${top:-.}" rev-parse --short=7 "$sha") $(cut -c1-70 <<<"$hit")"
  done
  if [ "$count" -eq 0 ]; then echo "check attribution: clean"; return; fi
  echo "check attribution: $bad$([ "$count" -le 1 ] || echo "; $((count - 1)) more commit(s)")"
}

state_line() {
  jq -r '"state: base \(.base[0:7]) review-head \(if .reviewHead then .reviewHead[0:7] else "-" end) round \(.round) t0 \(.t0 // "-")"' "$state" | tr -d '\r'
}

ledger_init() {
  [ -f "$ledger" ] && return
  mkdir -p "$(dirname "$ledger")"
  printf '# SDD ledger — plan: %s\n' "$(dforge_name "$plan" "$ctx")" > "$ledger"
}

route_field() { sed -n "s/.* $1=\\([^ ]*\\).*/\\1/p" <<<"$route" | tr -d '\r'; }

do_review() {
  local base head basesha headsha diff pkgout rc t0 gate route rrc primary fallback reason note="" tier="" judge old_base
  local lens_files="" lout lrc n line secs timeout_ms cmd top drops=() unexpanded snap ids_ranked id gl gr probed=0
  local template="$plugin_root/reference/prompts/task-reviewer-prompt.md"
  local judge_prompt="$ws/task-$first-review-prompt.md" panel_prompt="$ws/task-$first-review-panel-prompt.md"
  local panel_dir="$ws/task-$first-review-panel" external_files=""

  if [ ! -f "$state" ]; then
    # task-brief --open recorded the base on the task's ledger line.
    open_base=$(tr -d '\r' < "$ledger" 2>/dev/null | sed -n "s/^Task $first: implementer inline (assigned; base \([0-9a-f]*\)).*/\1/p" | tail -n 1)
    [ -n "$open_base" ] || die "Task $first has no step state or open line; run task-brief --open first" 6
    open_sha=$(git rev-parse --verify --quiet "$open_base^{commit}") || die "the open line's base $open_base is not a commit" 6
    ledger_init
    jq -n --argjson task "$first" --arg base "$open_sha" \
      '{tasks: [$task], base: $base, head: null, reviewHead: null, round: 0, t0: null}' > "$state.tmp" \
      && mv "$state.tmp" "$state" || die "cannot update $state"
  fi
  top=$(git rev-parse --show-toplevel)
  base=$(jq -r '.base' "$state" | tr -d '\r')
  # A step file written before 5.0 may name a head ref; it still packages to it.
  head=$(jq -r '.head // empty' "$state" | tr -d '\r')
  [ -n "$head" ] || head=HEAD
  basesha=$(git -C "$top" rev-parse --verify --quiet "$base^{commit}") || die "bad BASE: $base"
  headsha=$(git -C "$top" rev-parse --verify --quiet "$head^{commit}") || die "bad head: $head"
  require_scheduled_suite "$state" "$first"
  require_suite_base "$basesha" "$first"

  # One gate per reviewer family; the digest names each family's reason when
  # no surface is open, or when a gate probed.
  ids_ranked=$(bash "$HERE/executors" ranked 2>/dev/null | tr -d '\r')
  gate=""
  for id in $ids_ranked; do
    case $id in
      codex) gl=$(bash "${TASK_STEP_CODEX_GATE:-$HERE/codex-gate}" 2>/dev/null | tail -n 1 | tr -d '\r') ;;
      agy) gl=$(bash "${TASK_STEP_AGY_GATE:-$HERE/agy-gate}" 2>/dev/null | tail -n 1 | tr -d '\r') ;;
      *) gl="" ;;
    esac
    [[ " $gl " == *" source=probe "* ]] && probed=1
    if [[ " $gl " == *" review=true "* ]]; then gr=open
    elif [[ " $gl " == *" usable=true "* ]]; then gr=untrusted
    else gr=$(sed -n 's/.* reason=\([^ ]*\).*/\1/p' <<<" $gl"); gr=${gr:--}
    fi
    gate="${gate:+$gate }$id=$gr"
    external_files="${external_files:+$external_files
}$panel_dir/$id.json"
  done
  route=$(bash "$HERE/review-route" "$plan" --task "$first" 2>"$TMP/route.err"); rrc=$?
  if [ "$rrc" -eq 0 ]; then
    primary=$(route_field primary) fallback=$(route_field fallback) reason=$(route_field reason)
  else
    primary=dforge:judge-opus fallback=- reason=route-failed
    note=" (review-route exited $rrc: $(tr -d '\r' < "$TMP/route.err" | head -n 1))"
  fi
  case $primary in
    panel:heavy+judge-opus) tier=heavy judge=dforge:judge-opus ;;
    *) judge=$primary ;;
  esac
  case $judge in dforge:*) ;; *) judge=dforge:judge-opus ;; esac

  lout=$(bash "$HERE/lens-route" "$plan" --task "$first" 2>&1); lrc=$?
  [ "$lrc" -eq 0 ] || die "lens-route: $(tr -d '\r' <<<"$lout" | head -n 1)"
  while IFS= read -r line; do
    line=$(sed -n 's/^lens [^ ]* criteria=\(.*\)$/\1/p' <<<"$line" | tr -d '\r')
    [ -n "$line" ] || continue
    case ", $lens_files, " in *", $line, "*) continue ;; esac
    lens_files="${lens_files:+$lens_files, }$line"
  done <<<"$lout"

  pkgout=$(bash "$HERE/review-package" "$plan" "$basesha" "$headsha"); rc=$?
  [ "$rc" -eq 0 ] || { printf '%s\n' "$pkgout" >&2; exit "$rc"; }
  t0=$(date +%s)
  diff=$(sed -n 's/^wrote \(.*\): [0-9]* commit(s), [0-9]* bytes$/\1/p' <<<"$pkgout" | head -n 1 | tr -d '\r')

  [ -n "$lens_files" ] || drops+=("Lens Criteria")
  [ -n "$tier" ] || drops+=("Second Pass")
  prompt_text "$template" | drop_sections ${drops[@]+"${drops[@]}"} | fill \
    '[BASE_SHA]' "$basesha" '[HEAD_SHA]' "$headsha" '[DIFF_FILE]' "$diff" '[BRIEF_FILE]' "$brief" \
    '[IMPLEMENTER_REPORT_FILE]' "$report" '[REPORT_FILE]' "$ws/task-$first-review-report.md" \
    '[PLUGIN_ROOT]' "$plugin_root" '[JUDGE]' "$judge" \
    '[LENS_FILES]' "$lens_files" '[EXTERNAL_REVIEW_FILES]' "$external_files" > "$judge_prompt"

  if [ -n "$tier" ]; then
    {
      prompt_text "$template" | drop_sections "Output Format" "Criteria" "Lens Criteria" "Second Pass" | fill \
        '[BASE_SHA]' "$basesha" '[HEAD_SHA]' "$headsha" '[DIFF_FILE]' "$diff" '[BRIEF_FILE]' "$brief" \
        '[IMPLEMENTER_REPORT_FILE]' "$report" '[PLUGIN_ROOT]' "$plugin_root" '[JUDGE]' "$judge"
      printf '\n## Criteria\n\nScore each criterion independently on a 1 to 20 scale, where 1 is a clear failure, 10 is genuinely uncertain, and 20 is clearly met.\n\n'
      tr -d '\r' < "$plugin_root/criteria/task-review.md" | sed 's/^#/##/'
      printf '\nScore against those criteria and nothing else. Where a criterion tells you to ignore something, ignoring it is part of scoring correctly.\n\n'
      printf '## Output\n\nYour final message is one JSON object that satisfies the output schema, and nothing else: no markdown and no preamble. It carries the four scores (spec, scope, verification, quality), spec_verdict (compliant or issues), task_quality (approved or needs_fixes), findings (severity, file, line and summary for each; line is 0 when a finding has no single line) and cannot_verify (the requirements you could not verify from the diff alone; an empty array when there are none). This overrides any instruction above about the shape of your final message.\n'
    } > "$panel_prompt"
    # The host call must outlast the panel, whose bound is the slowest family's
    # first row plus that family's grace (run-review-panel).
    timeout_ms=0
    for id in codex:60 agy:70; do
      secs=$(ladder_block "${id%%:*}-judge" | awk 'NR == 1 { print $3 }')
      [ -n "$secs" ] || continue
      [ $(( (secs + ${id##*:} + 120) * 1000 )) -le "$timeout_ms" ] || timeout_ms=$(( (secs + ${id##*:} + 120) * 1000 ))
    done
    cmd="bash \"$plugin_root\"/scripts/run-review-panel --kind task --tier heavy --cwd \"$top\" --out-dir \"$panel_dir\" --prompt \"$panel_prompt\""
  fi
  # Only a token the template holds is a placeholder: a filled value, such as a
  # checkout path, may hold a bracketed capital word of its own.
  for line in "$judge_prompt" ${tier:+"$panel_prompt"}; do
    while IFS= read -r unexpanded; do
      [ -z "$unexpanded" ] || ! grep -qF -- "$unexpanded" "$line" || die "unexpanded placeholder $unexpanded in $line"
    done < <(prompt_text "$template" | grep -oE '\[[A-Z][A-Z_]*\]' | sort -u)
  done
  rm -f "$ws/task-$first-review-report.md"

  snap=$(tracked_snapshot "$top") || die "cannot record the tracked files of $top for the verdict check"
  old_base=$(suite_base_sha "$state")
  jq --arg rh "$headsha" --argjson t0 "$t0" --argjson chk "$snap" \
    --arg suite "$suite_arg" --arg sbase "$suite_base_sha_arg" \
    '.reviewHead = $rh | .t0 = $t0
     | .reviewCheck = $chk | (if $suite == "" then . else .suite = $suite end) | (if $sbase == "" then . else .suiteBase = $sbase end)' \
    "$state" > "$state.tmp" && mv "$state.tmp" "$state" || die "cannot update $state"
  drop_base_cache "$state" "$first" "$old_base"
  if [ -n "$suite_arg" ]; then
    ledger_init
    if [ "$(tr -d '\r' < "$ledger" | grep -cF 'Ruling: suite command —')" -eq 0 ]; then
      printf 'Task %s: Ruling: suite command — %s — none\n' "$first" "$suite_arg" >> "$ledger"
    fi
  fi

  printf 'task %s: reviewed %s..%s (%s commit(s)), diff %s\n' "$first" "${basesha:0:7}" "${headsha:0:7}" \
    "$(git -C "$top" rev-list --count "$basesha..$headsha")" "$diff"
  if [ "$reason" = reviewers-off ] || [ "$probed" -eq 1 ]; then printf 'gate: %s\n' "${gate:--}"; fi
  case $tier in
    heavy) printf 'seat: panel:heavy+judge-opus prompt: %s then: %s\n' "$judge_prompt" "$judge" ;;
    *) printf 'seat: %s prompt: %s%s\n' "$judge" "$judge_prompt" "$note" ;;
  esac
  if [ -n "$tier" ]; then printf 'panel: %s\ntimeout: %s\n' "$cmd" "$timeout_ms"; fi
  check_identity "$basesha" "$headsha"
  check_attribution "$basesha" "$headsha"
  state_line
  printf '%s\n' "$(budget_of <<<"$pkgout")"
}

# parse_report REPORT MODE: checks the judge report grammar and prints one
# record per line: "K\t<verdict key line>", "F\t<severity>\t<task>\t<file>\t
# <line>\t<one-liner>", "C\t<cannot-verify item>". On the first refusal it
# prints "E\t<reason>" and exits 1. MODE is review or rereview.
parse_report() {
  tr -d '\r' < "$1" | awk -v mode="$2" -v first="$first" '
    function err(s) { print "E\t" s; bad = 1; exit 1 }
    function need(key, allowed, v) {
      if (!(key in KV)) err("missing verdict line '"'"'" key ": …'"'"'")
      v = KV[key]
      if (allowed == "SCORES") {
        if (v !~ /^spec [0-9]+ \/ scope [0-9]+ \/ verification [0-9]+ \/ quality [0-9]+$/) err("bad verdict line: " KL[key])
        n = split(v, w, " ")
        for (j = 2; j <= n; j += 3) if (w[j] + 0 < 1 || w[j] + 0 > 20) err("bad verdict line: " KL[key])
      } else if (allowed == "COUNT") {
        if (v !~ /^[0-9]+$/) err("bad verdict line: " KL[key])
      } else if (index("|" allowed "|", "|" v "|") == 0) err("bad verdict line: " KL[key])
    }
    !started {
      if ($0 ~ /^[ \t]*$/) next
      if ($0 != "## Verdict") err("does not open with ## Verdict")
      started = 1; sect = "Verdict"; nsect = 1; next
    }
    /^## / {
      sect = substr($0, 4); sub(/[ \t]+$/, "", sect); nsect++
      if (sect == "External findings") codex_at = nsect
      if (sect == "Codex findings") err("## Codex findings is retired; the external section is ## External findings")
      next
    }
    sect == "Verdict" {
      if ($0 !~ /^[^:]+: .+$/) next
      key = $0; sub(/: .*$/, "", key)
      val = substr($0, length(key) + 3); sub(/[ \t]+$/, "", val)
      if (!(key in KV)) { KV[key] = val; KL[key] = $0 }
      out[++no] = "K\t" $0
      next
    }
    sect == "Findings" && /^- / {
      if (tolower($0) ~ /^- none\.?[ \t]*$/) next
      if ($0 !~ /^- \[(Critical|Important|Minor)\] [^ ].*:[0-9]+(-[0-9]+)? (—|-) .+$/) err("line " NR " is not a finding line: " $0)
      rest = substr($0, 4); sev = rest; sub(/\].*$/, "", sev)
      rest = substr(rest, length(sev) + 3)
      # A batch review prefixed findings with the task; one task has no prefix.
      if (rest ~ /^\(Task [0-9]+\) /) err("line " NR " is not a finding line: " $0)
      task = first
      if (sev != "Minor") serious[task]++
      # The path may hold spaces, so the location ends at the first
      # ":<line> — " rather than at the first space.
      match(rest, /:[0-9]+(-[0-9]+)? (—|-) /)
      loc = substr(rest, 1, RSTART + RLENGTH - 1); sub(/ (—|-) $/, "", loc)
      one = substr(rest, RSTART + RLENGTH)
      match(loc, /:[0-9]+(-[0-9]+)?$/)
      out[++no] = "F\t" sev "\t" task "\t" substr(loc, 1, RSTART - 1) "\t" substr(loc, RSTART + 1) "\t" one
      next
    }
    sect == "Cannot verify" && /^- / {
      if (tolower($0) ~ /^- none\.?[ \t]*$/) next
      out[++no] = "C\t" substr($0, 3)
      next
    }
    # Anything else under these two headings would be dropped unread, so a
    # line that is neither a bullet nor its indented detail is refused.
    sect == "Findings" || sect == "Cannot verify" {
      if ($0 ~ /^[ \t]*$/ || $0 ~ /^(  |\t)/ || tolower($0) ~ /^none\.?[ \t]*$/) next
      err("line " NR " under ## " sect " is neither a bullet nor an indented detail line: " $0)
    }
    END {
      if (bad) exit 1
      if (!started) err("does not open with ## Verdict")
      if (mode == "rereview") {
        need("fix round", "addressed|open"); need("open", "COUNT")
        if (KV["fix round"] == "open" && !serious[first]) err("fix round: open with no Critical or Important finding under ## Findings")
      } else {
        need("spec", "pass|fail|cannot-verify"); need("quality", "approved|changes"); need("scores", "SCORES")
        if ((KV["spec"] == "fail" || KV["quality"] == "changes") && !serious[first])
          err("spec: fail or quality: changes with no Critical or Important finding under ## Findings")
      }
      if (codex_at && codex_at != nsect) err("## External findings is not the report'"'"'s last section")
      for (i = 1; i <= no; i++) print out[i]
    }'
}

# restore_hints DIR RECORDED: for each changed path on stdin, its name and
# then "  restore: <command>", the command that puts back what the snapshot
# recorded. A path dirty at review time held uncommitted edits, so it comes
# back from its recorded content, never from HEAD. A snapshot taken before
# contents were stored has none to read. The snapshot is read back from the
# task's state file, so a path outside the work tree or a hash that is no
# object id gets no command: the session runs these lines as printed.
restore_hints() {
  local root p h
  root=$(git -C "$1" rev-parse --show-toplevel | tr -d '\r')
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    h=$(awk -F'\t' -v p="$p" '$1 == p { print $2; exit }' "$2")
    printf '%s\n' "$p"
    case /$p/ in
      //* | */../*)
        printf '  restore: none: the recorded path is outside the work tree; restore it by hand\n'
        continue ;;
    esac
    if [ -z "$h" ]; then
      printf '  restore: git -C %q checkout -- %q\n' "$root" "$p"
    elif [ "$h" = deleted ]; then
      printf '  restore: rm -f -- %q\n' "$root/$p"
    elif ! [[ $h =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]; then
      printf '  restore: none: the recorded content hash is no object id; restore it by hand\n'
    elif git -C "$root" cat-file -e "$h" 2>/dev/null; then
      printf '  restore: git -C %q cat-file --filters --path=%q %q > %q\n' "$root" "$p" "$h" "$root/$p"
    else
      printf '  restore: none: its content at review time (%s) was not stored; restore it by hand\n' "$h"
    fi
  done
}

# check_tracked: the check line, after comparing the snapshot the review step
# recorded with its checkout now. Exits 6 on a change, naming it.
check_tracked() {
  local vstate=$1 snap dir old new changed
  snap=$(jq -c '.reviewCheck // empty' "$vstate" | tr -d '\r') || die "cannot read $vstate"
  # A task's state may come from a review step that predates the check.
  if [ -z "$snap" ]; then
    echo "check tracked: not recorded (the review step predates this check)"
    return
  fi
  dir=$(jq -r '.cwd' <<<"$snap" | tr -d '\r')
  [ -d "$dir" ] || die "the reviewed checkout $dir is gone"
  old=$(jq -r '.head' <<<"$snap" | tr -d '\r')
  new=$(git -C "$dir" rev-parse HEAD 2>/dev/null | tr -d '\r')
  [ -n "$new" ] || die "the reviewed checkout $dir has no HEAD"
  if [ "$new" != "$old" ]; then
    {
      printf 'task-step: HEAD moved during the review in %s (%s -> %s); files changed since:\n' "$dir" "${old:0:7}" "${new:0:7}"
      git -C "$dir" -c core.quotepath=off diff --name-only --no-renames "$old" | tr -d '\r'
    } >&2
    exit 6
  fi
  jq -r '.dirty[] | "\(.path)\t\(.hash)"' <<<"$snap" | tr -d '\r' > "$TMP/recorded"
  dirty_list "$dir" > "$TMP/now" || die "cannot list the tracked changes in $dir"
  changed=$(awk -F'\t' '
    FNR == NR { rec[$1] = $2; next }
    !($1 in rec) || rec[$1] != $2 { print $1 }
    { delete rec[$1] }
    END { for (p in rec) print p }' "$TMP/recorded" "$TMP/now" | LC_ALL=C sort -u)
  if [ -n "$changed" ]; then
    {
      printf 'task-step: tracked files changed during the review in %s; restore each to its recorded state with the command under it:\n' "$dir"
      restore_hints "$dir" "$TMP/recorded" <<<"$changed"
    } >&2
    exit 6
  fi
  echo "check tracked: clean"
}

# plan_named_commands TASK STEP_FILE: the baseline commands the plan names for
# TASK, one per line: the step file's suite command, the header's Integration
# check, then the first code span of each of the task's Run: and **Check:**
# lines outside fenced blocks. Each is trimmed of edge blanks, as settle_item
# trims the seat's text, and a span left empty names nothing. Reads $src, the
# amended plan. A suite command with a newline is left out: a one-line item can
# never equal it.
plan_named_commands() {
  local n=$1 step=$2 suite line integ
  suite=$(jq -r '.suite // empty' "$step" | tr -d '\r' | sed -E 's/^[[:blank:]]+//; s/[[:blank:]]+$//')
  case $suite in '' | *$'\n'*) ;; *) printf '%s\n' "$suite" ;; esac
  line=$(plan_header "$src" | plan_lines 'Integration check' | sed -n 1p)
  integ=$(header_command "${line#\*\*Integration check:\*\*}")
  [ -z "$integ" ] || [ "$integ" = none ] || printf '%s\n' "$integ"
  # A lone * before a blank is a list marker, so the ** of **Check:** is never
  # stripped. A span opened by a double backtick, unclosed, empty or closed by
  # a double backtick names nothing.
  plan_task_text "$src" "$n" | awk "$_PLAN_AWK"'
    in_fence($0) { next }
    {
      rest = $0
      while (match(rest, /^[ \t|]+/) || match(rest, /^([-*+]|[0-9]+[.)])[ \t]/)) rest = substr(rest, RLENGTH + 1)
      if (index(rest, "Run:") == 1) rest = substr(rest, 5)
      else if (index(rest, "**Check:**") == 1) rest = substr(rest, 11)
      else next
      i = index(rest, "`")
      if (!i) next
      rest = substr(rest, i + 1)
      if (substr(rest, 1, 1) == "`") next
      j = index(rest, "`")
      if (!j || substr(rest, j + 1, 1) == "`") next
      span = substr(rest, 1, j - 1)
      gsub(/^[ \t]+|[ \t]+$/, "", span)
      if (span != "") print span
    }
  '
}

# settle_item ITEM BASE HEAD LOG: answers one structured cannot-verify item.
# Prints "<exists|baseline>\t<evidence>\t<match|mismatch>\t<check>, expect <answer>"
# and returns 0; returns 1 for free text, an item without expect, a malformed
# item or a check that could not run, and 2 for a baseline command the plan
# does not name (a whole line of $named_file).
settle_item() {
  local item=$1 base=$2 head=$3 log=$4 rest spec want got res target where sha hit ev cmd code grc
  case $item in
    'cannot-verify: exists '*' — '*)
      rest=${item#cannot-verify: exists }
      spec=${rest%% — *}
      case $spec in *', expect '*) ;; *) return 1 ;; esac
      want=${spec##*, expect }
      spec=${spec%, expect *}
      case $want in present | absent) ;; *) return 1 ;; esac
      where=${spec##* at }
      target=${spec% at *}
      case $where in base) sha=$base ;; head) sha=$head ;; *) return 1 ;; esac
      case $target in '' | *' '*) return 1 ;; esac
      [ -n "$sha" ] || return 1
      # An unknown commit, a shallow clone or a wrong directory must reach the
      # ruling seat, not read as "absent".
      git cat-file -e "$sha^{commit}" 2>/dev/null || return 1
      got=present
      if git cat-file -e "$sha:${target#./}" 2>/dev/null; then
        ev="path present"
      elif [[ $target == */* ]]; then
        ev="path absent" got=absent
      else
        # git grep exits 1 for no match and 141 when head closed the pipe on a hit.
        hit=$(git grep -InwF -e "$target" "$sha" 2>/dev/null | head -n 1 | tr -d '\r'; exit "${PIPESTATUS[0]}")
        grc=$?
        case $grc in 0 | 1 | 141) ;; *) return 1 ;; esac
        if [ -n "$hit" ]; then
          ev=$(printf '%s\n' "${hit#"$sha":}" | awk -F: '{ print $1 ":" $2 }')
        else
          ev=absent got=absent
        fi
      fi
      res=mismatch; [ "$got" != "$want" ] || res=match
      printf 'exists\t%s\t%s\texists %s, expect %s\n' "$ev" "$res" "$spec" "$want" ;;
    'cannot-verify: baseline '*' — '*)
      rest=${item#cannot-verify: baseline }
      spec=${rest%% — *}
      case $spec in *', expect '*) ;; *) return 1 ;; esac
      want=${spec##*, expect }
      cmd=${spec%, expect *}
      case $want in pass | fail) ;; *) return 1 ;; esac
      cmd=${cmd#"${cmd%%[![:blank:]]*}"}
      cmd=${cmd%"${cmd##*[![:blank:]]}"}
      [ -n "$cmd" ] || return 1
      # The seat's text runs only when, after trimming, it is byte for byte a
      # command the plan names, so a review seat cannot choose what runs on the
      # controller host.
      [ -n "${named_file:-}" ] && [ -r "$named_file" ] && LC_ALL=C grep -qxF -- "$cmd" "$named_file" || return 2
      [ -n "$base" ] || return 1
      code=$(run_at_base "$base" "$cmd" "$log") || return 1
      # Only an exit the command itself produced answers pass or fail: a
      # timeout, a command that cannot run and one that is not found go to the seat.
      case $code in 124 | 126 | 127) return 1 ;; esac
      got=fail; [ "$code" != 0 ] || got=pass
      res=mismatch; [ "$got" != "$want" ] || res=match
      printf 'baseline\texit %s, log %s\t%s\tbaseline %s, expect %s\n' "$code" "$log" "$res" "$cmd" "$want" ;;
    *) return 1 ;;
  esac
}

# settle_cannot_verify: do_verdict's helper. It answers a single task's
# structured cannot-verify items and removes them from do_verdict's cvs array.
# An answer that matches the item's expect is logged to the ledger. A mismatch
# is never settled silently: it becomes an Important finding (file
# cannot-verify, line 0) in do_verdict's $TMP/serious, flines and imp, so the
# fix-file loop below writes it and the digest prints it. Free text, items
# without expect and items it could not check reach the ruling seat. A kept
# item loses its "cannot-verify: " prefix, which the digest line adds back.
# A baseline item whose command the plan does not name (plan_named_commands)
# is not run and is kept with " (command not named in the plan)" appended.
# The k-th baseline item writes task-N-baseline-k.log.
settle_cannot_verify() {
  local item out kind ev res label one line base head src_rc named_file bk=0 j seen="" open=()
  named_file=$TMP/named-commands
  plan_named_commands "$first" "$vstate" > "$named_file"
  base=$(jq -r '.base // empty' "$vstate" | tr -d '\r')
  head=$(jq -r '.reviewHead // empty' "$vstate" | tr -d '\r')
  for item in ${cvs[@]+"${cvs[@]}"}; do
    case $item in 'cannot-verify: baseline '*) bk=$((bk + 1)) ;; esac
    out=$(settle_item "$item" "$base" "$head" "$ws/task-$first-baseline-$bk.log"); src_rc=$?
    if [ "$src_rc" -eq 0 ]; then
      IFS=$'\t' read -r kind ev res label <<<"$out"
      if [ "$res" = mismatch ]; then
        one="$label — got $ev"
        printf '%s\tImportant\tcannot-verify\t0\t%s\n' "$first" "$one" >> "$TMP/serious"
        flines+=("Important $first cannot-verify:0 — $one")
        imp=$((imp + 1))
        continue
      fi
      line="Task $first: Ruling: cannot-verify — settled by task-step check $kind — $ev"
      j=$(printf '%s' "$seen" | grep -cxF -- "$line" || true)
      j=$((j + 1))
      seen="$seen$line"$'\n'
      if [ ! -f "$ledger" ] || [ "$(tr -d '\r' < "$ledger" | grep -cxF -- "$line")" -lt "$j" ]; then
        ledger_init
        printf '%s\n' "$line" >> "$ledger"
      fi
    elif [ "$src_rc" -eq 2 ]; then
      open+=("${item#cannot-verify: } (command not named in the plan)")
    else
      open+=("${item#cannot-verify: }")
    fi
  done
  cvs=(${open[@]+"${open[@]}"})
}

# verdict_val KEY: the value of the first Verdict line with that key, from
# do_verdict's vals ("<key>\t<value>" entries).
verdict_val() {
  local v
  for v in ${vals[@]+"${vals[@]}"}; do
    [ "${v%%$'\t'*}" != "$1" ] || { printf '%s' "${v#*$'\t'}"; return; }
  done
}

# suite_check: reads the suite record for the review head and sets suite_state
# (none|pass|red|notrun) and suite_line; the findings a red suite adds are
# written to $TMP/suite-findings, one "task, severity, file, line, summary" row
# per new failing line, uncapped.
suite_check() {
  local target st rh head7 row kind code log fails nfail nnew nbase line suite_cmd next last
  suite_state=none suite_line="suite: none recorded"
  : > "$TMP/suite-findings"
  target=$first
  st=$ws/task-$target-step.json
  require_step_file "$st"
  suite_cmd=$(jq -r '.suite // empty' "$st" | tr -d '\r')
  if [ -z "$suite_cmd" ]; then
    if [[ $(plan_header_line "$src" "Task check") =~ $NONE_RE ]]; then
      next=$(( (target / 3 + 1) * 3 ))
      last=$(plan_tasks "$src" | awk -F'\t' '$1 + 0 > m { m = $1 + 0 } END { print m + 0 }')
      [ "$last" -ge "$next" ] || next=$last
      suite_line="suite: not scheduled (next at Task $next)"
    fi
    return 0
  fi
  rh=$(jq -r '.reviewHead // empty' "$vstate" | tr -d '\r')
  head7=${rh:0:7}
  row=$(suite_row "$st" "$rh" .)
  if [ -z "$row" ]; then
    suite_state=notrun suite_line="suite: not run ($suite_cmd)"
    return 0
  fi
  IFS=$'\t' read -r _ kind _ code log _ <<<"$row"
  suite_log=$log
  if [ "$code" = 0 ]; then
    suite_state=pass suite_line="suite: pass ($kind)"
    return 0
  fi
  suite_state=red
  if suite_unfinished "$code"; then
    fails=$(suite_failing_lines "$log" || true)
    fails="${fails:+$fails$'\n'}suite did not finish (exit $code)"
  else
    fails=$(suite_fail_set "$log" "$code")
  fi
  printf '%s\n' "$fails" > "$TMP/suite-fails"
  suite_base_lines "$st" "$target" . > "$TMP/suite-base"
  if [ -s "$TMP/suite-base" ]; then grep -vxF -f "$TMP/suite-base" "$TMP/suite-fails" > "$TMP/suite-new"; else cp "$TMP/suite-fails" "$TMP/suite-new"; fi
  nfail=$(grep -c '' "$TMP/suite-fails")
  nnew=$(grep -c '' "$TMP/suite-new")
  nbase=$((nfail - nnew))
  suite_line="suite: red ($nnew failing, $nbase baseline)"
  while IFS= read -r line; do
    # The unnamed marker only keeps a base line from matching; the finding
    # names the exit.
    [[ $line =~ ^(command\ exit\ [0-9]+)\ \(unnamed\ [0-9]+-[0-9]+\)$ ]] && line=${BASH_REMATCH[1]}
    case $line in
      'suite did not finish'*) printf '%s\tImportant\tsuite\t0\tsuite: %s at %s\n' "$target" "$line" "$head7" ;;
      *) printf '%s\tImportant\tsuite\t0\tsuite: %s fails at %s\n' "$target" "${line//$'\t'/ }" "$head7" ;;
    esac
  done < "$TMP/suite-new" > "$TMP/suite-findings"
}

do_verdict() {
  local n vstate rpath mode check_line recs rc rec tag rest sev task file line one r fix l nv i room nc budget
  local k is_req used nx fix_line=none
  local vlines=() flines=() cvs=() minors=() req=() vals=() extras=()
  local crit=0 imp=0 minor=0 ns=0 suite_more=0 suite_fix= suite_log=
  vstate=$state
  [ -f "$vstate" ] && [ -n "$(jq -r '.reviewHead // empty' "$vstate" | tr -d '\r')" ] \
    || die "run task-step review for task $first first" 6
  rpath=$ws/task-$first-review-report.md
  [ -z "$rereview_arg" ] || rpath=$ws/task-$first-rereview-$rereview_arg-report.md
  mode=review
  [ -z "$rereview_arg" ] || mode=rereview

  check_line=$(check_tracked "$vstate"); rc=$?
  [ "$rc" -eq 0 ] || exit "$rc"

  [ -f "$rpath" ] || die "no report at $rpath: the seat wrote none" 5
  recs=$(parse_report "$rpath" "$mode"); rc=$?
  [ "$rc" -eq 0 ] || die "$rpath: ${recs#E$'\t'}" 5

  suite_check
  if [ "$suite_state" = notrun ]; then
    printf 'task %s: verdict from %s\n' "$first" "$rpath"
    printf '%s\n' "$suite_line"
    exit 7
  fi

  : > "$TMP/serious"
  while IFS= read -r rec; do
    tag=${rec%%$'\t'*} rest=${rec#*$'\t'}
    case $tag in
      K) vlines+=("$rest") ;;
      C) cvs+=("$rest") ;;
      F)
        IFS=$'\t' read -r sev task file line one <<<"$rest"
        case $sev in
          Critical) crit=$((crit + 1)) ;;
          Important) imp=$((imp + 1)) ;;
          *) minor=$((minor + 1)); minors+=("Task $task: minor (deferred): $file:$line — $one"); continue ;;
        esac
        flines+=("$sev $task $file:$line — $one")
        printf '%s\t%s\t%s\t%s\t%s\n' "$task" "$sev" "$file" "$line" "$one" >> "$TMP/serious"
        ;;
    esac
  done <<<"$recs"
  settle_cannot_verify

  if [ -s "$TMP/suite-findings" ]; then
    cat "$TMP/suite-findings" >> "$TMP/serious"
    while IFS=$'\t' read -r task sev file line one; do
      imp=$((imp + 1))
      ns=$((ns + 1))
      if [ "$ns" -le 20 ]; then flines+=("$sev $task $file:$line — $one"); else suite_more=$((suite_more + 1)); fi
    done < "$TMP/suite-findings"
  fi

  n=$(grep -c '' "$TMP/serious")
  if [ "$n" -gt 0 ]; then
    r=$(jq -r '.round // 0' "$vstate" | tr -d '\r')
    fix=$ws/task-$first-fix-$(( ${r:-0} + 1 )).md
    # Past round 2 the open findings go to the breaker, so no third fix file
    # invites a round that rereview refuses.
    if [ "${r:-0}" -ge 2 ]; then
      suite_fix="the suite log $suite_log"
      fix_line="breaker (round 2 of 2; $n finding$([ "$n" -eq 1 ] || echo s))"
    else
      suite_fix=$fix
      awk -F'\t' -v report="$rpath" '
        { n++; sev[n] = $2; loc[n] = $3 ($4 == "0" ? "" : ":" $4); full[n] = $3 ":" $4; one[n] = $5 }
        END {
          for (i = 1; i <= n; i++) print "- " loc[i] ": " one[i]
          print ""
          print "Severity and detail: " report
          for (i = 1; i <= n; i++) print "- [" sev[i] "] " full[i] " — " one[i]
        }' "$TMP/serious" > "$fix" || die "cannot write $fix"
      fix_line="$fix ($n finding$([ "$n" -eq 1 ] || echo s))"
    fi
  fi

  for l in ${minors[@]+"${minors[@]}"}; do
    # grep -c reads the whole ledger: grep -q would close the pipe early and,
    # under pipefail, a SIGPIPE'd tr would read as "not there yet".
    if [ -f "$ledger" ] && [ "$(tr -d '\r' < "$ledger" | grep -cxF -- "$l")" -gt 0 ]; then continue; fi
    ledger_init
    printf '%s\n' "$l" >> "$ledger"
  done

  printf 'task %s: verdict from %s\n' "$first" "$rpath"
  # The verdict keys the fix loop reads are always printed; only the other
  # Verdict lines are cut to fit 12 lines.
  if [ "$mode" = rereview ]; then
    req=("fix round" "open")
  else
    req=(spec quality scores)
  fi
  used="|"
  for l in ${vlines[@]+"${vlines[@]}"}; do
    k=${l%%: *}
    is_req=0
    for i in "${req[@]}"; do [ "$i" != "$k" ] || is_req=1; done
    if [ "$is_req" -eq 1 ] && [[ $used != *"|$k|"* ]]; then
      used="$used$k|" vals+=("$k"$'\t'"${l#*: }")
    else
      extras+=("$l")
    fi
  done
  nv=0
  for k in "${req[@]}"; do printf '%s: %s\n' "$k" "$(verdict_val "$k")"; nv=$((nv + 1)); done
  nx=${#extras[@]} room=$((12 - nv))
  if [ "$nx" -eq 0 ]; then
    :
  elif [ "$nx" -le "$room" ]; then
    for i in "${!extras[@]}"; do printf '%s\n' "${extras[$i]}"; done
    nv=$((nv + nx))
  else
    [ "$room" -ge 1 ] || room=1
    for ((i = 0; i < room - 1; i++)); do printf '%s\n' "${extras[$i]}"; done
    printf 'verdict: %s more lines in the report\n' "$((nx - room + 1))"
    nv=$((nv + room))
  fi
  printf 'findings: %s Critical, %s Important, %s Minor\n' "$crit" "$imp" "$minor"
  [ "${#flines[@]}" -eq 0 ] || printf '%s\n' "${flines[@]}"
  [ "$suite_more" -eq 0 ] || printf 'suite: %s more failing lines in %s\n' "$suite_more" "$suite_fix"
  printf '%s\n' "$suite_line"
  # Every line but the finding lines fits in 20: the first, the verdict lines,
  # and the findings, suite, fix, minor, check and budget lines, with the suite
  # line counting the rest when there is one, leave this many. Items past
  # that still get one line saying how many wait.
  room=$((20 - nv - 7))
  [ "$suite_more" -eq 0 ] || room=$((room - 1))
  [ "$room" -ge 1 ] || room=1
  nc=${#cvs[@]}
  if [ "$nc" -le "$room" ]; then
    for i in ${cvs[@]+"${!cvs[@]}"}; do printf 'cannot-verify: %s\n' "${cvs[$i]}"; done
  else
    for ((i = 0; i < room - 1; i++)); do printf 'cannot-verify: %s\n' "${cvs[$i]}"; done
    printf 'cannot-verify: %s more in the report\n' "$((nc - room + 1))"
  fi
  printf 'fix: %s\n' "$fix_line"
  printf 'minor: %s logged as deferred\n' "$minor"
  printf '%s\n' "$check_line"
  budget=$(plan_budget_line "$HERE" task-step:verdict "$src" "$ledger" | budget_of)
  printf '%s\n' "${budget:-budget: unknown}"
}

case $sub in
  review) do_review ;;
  verdict) do_verdict ;;
esac
