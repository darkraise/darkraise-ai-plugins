#!/usr/bin/env bash
# One command per mechanical phase of the delegated task loop
# (reference/delegated-task.md): each wraps today's scripts, writes the filled
# prompt to a file in the plan workspace and prints a digest of at most 15
# lines. State for a task, or a batch named after its first task, lives in
# <workspace>/task-<N>-step.json; a group review's in
# <workspace>/group-<list>-step.json.
#
# Usage: task-step start  PLAN_FILE N [M ...] [--wave K] [--reset]
#        task-step review PLAN_FILE N [M ...] [--base SHA] [--head REF] [--cwd DIR]
#        task-step hold   PLAN_FILE N [--head REF] [--cwd DIR]
#        task-step review --group PLAN_FILE N M ... [--cwd DIR]
#        task-step rereview PLAN_FILE N [M ...] [--base SHA] [--head REF] [--covered]
#        task-step verdict PLAN_FILE N [M ...] [--group] [--rereview R] [--cwd DIR]
# A start that finds the task's state file keeps it (and writes no second
# assigned line) unless --reset is given.
# Exit: 0 ok; 2 usage, or any subcommand on a Host: codex plan; 3 no such task;
# 4 an amendment does not apply, hold was refused because review-route reviews
# the task alone, or review --group was given a task with no awaiting group
# review line or one already in a group's review rounds; 5 (verdict) the seat
# wrote no report, or one outside the grammar; 6 a required earlier step has
# not run, or (verdict) a tracked file changed during the review; 7 the fix
# loop is at its two-round cap.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/plan.sh"

die() { printf 'task-step: %s\n' "$1" >&2; exit "${2:-2}"; }
usage() { die "usage: task-step start PLAN_FILE N [M ...] [--wave K] [--reset] | review PLAN_FILE N [M ...] [--base SHA] [--head REF] [--cwd DIR] | hold PLAN_FILE N [--head REF] [--cwd DIR] | review --group PLAN_FILE N M ... [--cwd DIR] | rereview PLAN_FILE N [M ...] [--base SHA] [--head REF] [--covered] | verdict PLAN_FILE N [M ...] [--group] [--rereview R] [--cwd DIR]"; }

# dirty_list DIR: "<path>\t<hash>" for each tracked path that differs from
# HEAD, sorted; the hash is git's content hash, or "deleted". Paths are
# relative to the work tree's top, so they are hashed from there.
dirty_list() {
  local root p
  root=$(git -C "$1" rev-parse --show-toplevel | tr -d '\r')
  git -C "$1" -c core.quotepath=off diff --name-only --no-renames HEAD | tr -d '\r' | LC_ALL=C sort |
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      if [ -f "$root/$p" ]; then
        printf '%s\t%s\n' "$p" "$(git -C "$root" hash-object -- "$p" | tr -d '\r')"
      else
        printf '%s\tdeleted\n' "$p"
      fi
    done
}

# tracked_snapshot DIR: what a later verdict compares, as one JSON object
# {cwd, head, dirty: [{path, hash}]}. Prints nothing when DIR is not inside a
# git work tree.
tracked_snapshot() {
  local head
  [ "$(git -C "$1" rev-parse --is-inside-work-tree 2>/dev/null | tr -d '\r')" = true ] || return 0
  head=$(git -C "$1" rev-parse HEAD 2>/dev/null | tr -d '\r') || return 0
  dirty_list "$1" | jq -R -s -c --arg cwd "$1" --arg head "$head" \
    '{cwd: $cwd, head: $head, dirty: [split("\n")[] | select(. != "") | split("\t") | {path: .[0], hash: .[1]}]}'
}

rr_usage() {
  echo "usage: task-step rereview PLAN_FILE N [M ...] [--base SHA] [--head REF] [--covered]" >&2
  exit 2
}

rr_render() { # rr_render TEMPLATE FINDINGS_FILE — the fenced prompt body, de-indented, placeholders filled from RR_*
  awk -v findings="$2" '
    function rep(s, key, val,   out, i) {
      out = ""
      while ((i = index(s, key)) > 0) { out = out substr(s, 1, i - 1) val; s = substr(s, i + length(key)) }
      return out s
    }
    BEGIN { while ((getline line < findings) > 0) fl = fl (fl == "" ? "" : "\n") line }
    { sub(/\r$/, "") }
    !fenced { if ($0 == "```") fenced = 1; next }
    !body { if ($0 ~ /^[ ]+prompt: \|$/) body = 1; next }
    $0 == "```" { exit }
    {
      sub(/^    /, "")
      if ($0 == "[FINDINGS]") { print fl; next }
      $0 = rep($0, "[BRIEF_FILE]", ENVIRON["RR_BRIEF"])
      $0 = rep($0, "[IMPLEMENTER_REPORT_FILE]", ENVIRON["RR_REPORT"])
      $0 = rep($0, "[REPORT_FILE]", ENVIRON["RR_JUDGE_REPORT"])
      $0 = rep($0, "[FIX_BASE_SHA]", ENVIRON["RR_FIX_BASE"])
      $0 = rep($0, "[HEAD_SHA]", ENVIRON["RR_HEAD"])
      $0 = rep($0, "[DIFF_FILE]", ENVIRON["RR_DIFF"])
      print
    }
  ' "$1"
}

# A subshell body: every exit below leaves only the subshell, so the
# dispatch branch passes the status on.
cmd_rereview() (
  local here plan_arg plan tmp src header ws state first t scores row risk
  local fix bullets nopen file review_head round new_round head_ref head_sha fix_base fix_base_sha
  local pkg diff_file numstat a d f lines over touched risk3 skip why now prompt tpl ids group gstate check_dir snap
  local tasks=() base_arg="" head_arg="" covered=0
  here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  . "$here/lib/plan.sh"
  [ $# -ge 2 ] || rr_usage
  plan_arg=$1; shift
  while [ $# -gt 0 ]; do
    case $1 in
      --base) [ $# -ge 2 ] && [ -n "$2" ] || rr_usage; base_arg=$2; shift 2 ;;
      --head) [ $# -ge 2 ] && [ -n "$2" ] || rr_usage; head_arg=$2; shift 2 ;;
      --covered) covered=1; shift ;;
      *) [[ $1 =~ ^[0-9]+$ ]] || rr_usage; tasks+=("$((10#$1))"); shift ;;
    esac
  done
  [ "${#tasks[@]}" -ge 1 ] || rr_usage

  plan=$(plan_locate "$plan_arg")
  [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
  dforge_stores_init "$(_plan_ctx "$plan")"
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  src=$tmp/plan.md
  if ! plan_apply_amendments "$plan" "$(plan_amendments_file "$plan")" > "$src" 2> "$tmp/err"; then
    cat "$tmp/err" >&2
    exit 4
  fi
  header=$(plan_header "$src")
  if grep -qE '^(\*\*)?Host:(\*\*)?[ \t]+codex[ \t]*$' <<<"$header"; then
    echo "task-step: a Host: codex plan runs the Codex loop; task-step does not apply" >&2
    exit 2
  fi
  plan_require_same_project "$plan"
  for t in "${tasks[@]}"; do
    plan_task_text "$src" "$t" >/dev/null || { echo "task $t not found in $plan" >&2; exit 3; }
  done

  first=${tasks[0]}
  ids=$(IFS=,; echo "${tasks[*]}")
  ws=$(dforge_workspace "$(basename "$plan" .md)" "$(_plan_ctx "$plan")")
  state=$ws/task-$first-step.json
  review_head=""
  [ ! -f "$state" ] || review_head=$(jq -r '.reviewHead // empty' "$state" | tr -d '\r')
  if [ -z "$review_head" ]; then
    echo "task-step: rereview before review: run task-step review for task $first first" >&2
    exit 6
  fi
  round=$(jq -r '.round // 0' "$state" | tr -d '\r')
  new_round=$((round + 1))
  if [ "$new_round" -gt 2 ]; then
    echo "task-step: fix round $new_round is past the cap of 2; send the open findings to the breaker (reference/delegated-task.md §4)" >&2
    exit 7
  fi

  fix=$ws/task-$first-fix-$new_round.md
  if [ ! -f "$fix" ]; then
    echo "task-step: no fix message $fix; write it before rereview" >&2
    exit 6
  fi
  bullets=$(awk '{ sub(/\r$/, "") } /^- / { print; next } { exit }' "$fix")
  nopen=$(printf '%s\n' "$bullets" | awk 'NF { n++ } END { print n + 0 }')
  if [ "$nopen" -lt 1 ]; then
    echo "task-step: $fix must start with one '- <file>: <finding>' bullet per open finding" >&2
    exit 2
  fi
  file=${bullets%%$'\n'*}
  file=${file#- }
  file=${file%%: *}
  file=$(printf '%s' "$file" | tr -d '`' | sed -E 's/:[0-9][0-9,-]*$//; s#^\./##')

  head_ref=$head_arg
  [ -n "$head_ref" ] || head_ref=$(jq -r '.head // empty' "$state" | tr -d '\r')
  [ -n "$head_ref" ] || head_ref=HEAD
  head_sha=$(git rev-parse --verify --quiet "$head_ref^{commit}") || { echo "bad HEAD: $head_ref" >&2; exit 2; }
  # A sequential group member's fixes run one after another in one checkout,
  # so its fix diff starts where the group's last review ended. A wave member
  # (one with a head ref) keeps its own review head.
  group=$(jq -r '.group // empty' "$state" | tr -d '\r')
  gstate=""
  if [ -n "$group" ] && [ -z "$(jq -r '.head // empty' "$state" | tr -d '\r')" ] && [ -f "$ws/group-$group-step.json" ]; then
    gstate=$ws/group-$group-step.json
  fi
  fix_base=$base_arg
  [ -n "$fix_base" ] || [ -z "$gstate" ] || fix_base=$(jq -r '.reviewHead // empty' "$gstate" | tr -d '\r')
  [ -n "$fix_base" ] || fix_base=$review_head
  fix_base_sha=$(git rev-parse --verify --quiet "$fix_base^{commit}") || { echo "bad BASE: $fix_base" >&2; exit 2; }

  scores=$(plan_scores "$src")
  risk3=0
  for t in "${tasks[@]}"; do
    row=$(awk -F'\t' -v n="$t" '$1 == n' <<<"$scores")
    risk=$(cut -f3 <<<"$row")
    case $risk in 0|1|2) ;; *) risk3=1 ;; esac
  done

  lines=0 over=0 touched=0
  numstat=$(git -c core.quotepath=off diff --numstat --no-renames "$fix_base_sha..$head_sha")
  while IFS=$'\t' read -r a d f; do
    [ -n "$f" ] || continue
    f=${f%$'\r'}
    if [ "$a" = "-" ] || [ "$d" = "-" ]; then over=1; else lines=$((lines + a + d)); fi
    [ "$f" != "$file" ] || touched=1
  done <<<"$numstat"

  skip=0 why=""
  if [ "$nopen" -ne 1 ]; then why="$nopen findings open"
  elif [ "$risk3" -eq 1 ]; then why="risk 3 or unscored"
  elif [ "$covered" -ne 1 ]; then why="--covered not given"
  elif [ "$over" -eq 1 ]; then why="binary file in the fix"
  elif [ "$lines" -gt 3 ]; then why="$lines changed lines"
  elif [ "$touched" -ne 1 ]; then why="the fix does not touch $file"
  else skip=1
  fi

  pkg=$(bash "$here/review-package" "$plan" "$fix_base_sha" "$head_sha") || { printf '%s\n' "$pkg" >&2; exit 2; }
  diff_file=$(printf '%s\n' "$pkg" | sed -n -E '/^wrote /{s/^wrote (.*): [0-9]+ commit\(s\), [0-9]+ bytes$/\1/;p;q;}')

  prompt=$ws/task-$first-rereview-$new_round-prompt.md
  if [ "$skip" -eq 0 ]; then
    tpl=$here/../skills/subagent-driven-development/references/re-review-prompt.md
    [ -f "$tpl" ] || { echo "task-step: missing template $tpl" >&2; exit 2; }
    printf '%s\n\nThe fix message holds each finding'"'"'s detail: %s\n' "$bullets" "$fix" > "$tmp/findings"
    judge_report=$ws/task-$first-rereview-$new_round-report.md
    RR_BRIEF=$ws/task-$first-brief.md RR_REPORT=$ws/task-$first-report.md RR_JUDGE_REPORT=$judge_report \
      RR_FIX_BASE=$fix_base_sha RR_HEAD=$head_sha RR_DIFF=$diff_file rr_render "$tpl" "$tmp/findings" > "$tmp/prompt"
    if grep -qE '\[(BRIEF_FILE|FINDINGS|IMPLEMENTER_REPORT_FILE|REPORT_FILE|FIX_BASE_SHA|HEAD_SHA|DIFF_FILE|MODEL)\]' "$tmp/prompt"; then
      echo "task-step: $tpl holds a placeholder rereview does not fill" >&2
      exit 2
    fi
    rm -f "$judge_report"
    cp "$tmp/prompt" "$prompt"
  fi

  check_dir=$(jq -r '.reviewCheck.cwd // .heldCwd // empty' "$state" | tr -d '\r')
  [ -n "$check_dir" ] || check_dir=$(git rev-parse --show-toplevel | tr -d '\r')
  snap=$(tracked_snapshot "$check_dir")
  now=$(date +%s)
  jq --arg rh "$head_sha" --argjson r "$new_round" --argjson t "$now" \
    --arg base "$base_arg" --arg bsha "$fix_base_sha" --arg head "$head_arg" --arg chk "$snap" \
    '.reviewHead = $rh | .round = $r | .t0 = $t | (if $base == "" then . else .base = $bsha end) | (if $head == "" then . else .head = $head end)
     | (if $chk == "" then del(.reviewCheck) else .reviewCheck = ($chk | fromjson) end)' \
    "$state" > "$state.tmp" && mv "$state.tmp" "$state" || die "cannot update $state"
  if [ -n "$gstate" ]; then
    jq --arg rh "$head_sha" '.reviewHead = $rh' "$gstate" > "$gstate.tmp" && mv "$gstate.tmp" "$gstate" || die "cannot update $gstate"
  fi

  if [ "$skip" -eq 1 ]; then
    printf 'task %s: re-review round %s: packaged %s..%s, skipped\n' "$ids" "$new_round" "${fix_base_sha:0:7}" "${head_sha:0:7}"
    printf 're-review: skipped (%s changed lines, 1 finding, %s)\n' "$lines" "$file"
  else
    printf 'task %s: re-review round %s: packaged %s..%s, prompt written (not skipped: %s)\n' "$ids" "$new_round" "${fix_base_sha:0:7}" "${head_sha:0:7}" "$why"
    printf 'seat: dforge:judge-sonnet-high prompt: %s\n' "$prompt"
  fi
  printf 'state: base %s review-head %s round %s t0 %s\n' \
    "$(jq -r '.base' "$state" | tr -d '\r' | cut -c1-7)" "${head_sha:0:7}" "$new_round" "$now"
  DFORGE_BUDGET_CALLER="task-step:rereview" bash "$here/context-size" 2>/dev/null || true
)

if [ "${1:-}" = rereview ]; then
  shift
  cmd_rereview "$@"
  exit $?
fi
[ $# -ge 3 ] || usage
sub=$1; shift
case $sub in start|review|hold|verdict) ;; *) usage ;; esac
if [ "$sub" = review ] && [ "$1" = --group ]; then
  sub=group; shift
  [ $# -ge 2 ] || usage
fi
plan_arg=$1; shift

ids=() wave="" reset=0 base_arg="" head_arg="" cwd_arg="" vgroup=0 rereview_arg=""
while [ $# -gt 0 ]; do
  case $1 in
    --wave) [ "$sub" = start ] && [ $# -ge 2 ] && [[ $2 =~ ^[1-9][0-9]*$ ]] || usage; wave=$2; shift 2 ;;
    --reset) [ "$sub" = start ] || usage; reset=1; shift ;;
    --base) [ "$sub" = review ] && [ $# -ge 2 ] && [ -n "$2" ] || usage; base_arg=$2; shift 2 ;;
    --head) [[ $sub =~ ^(review|hold)$ ]] && [ $# -ge 2 ] && [ -n "$2" ] || usage; head_arg=$2; shift 2 ;;
    --cwd) [[ $sub =~ ^(review|hold|group|verdict)$ ]] && [ $# -ge 2 ] && [ -n "$2" ] || usage; cwd_arg=$2; shift 2 ;;
    --group) [ "$sub" = verdict ] || usage; vgroup=1; shift ;;
    --rereview) [ "$sub" = verdict ] && [ $# -ge 2 ] && [[ $2 =~ ^[1-9][0-9]*$ ]] || usage; rereview_arg=$2; shift 2 ;;
    -*) usage ;;
    *) [[ $1 =~ ^[0-9]+$ ]] || usage; ids+=("$((10#$1))"); shift ;;
  esac
done
[ ${#ids[@]} -ge 1 ] || usage
[ "$sub" != hold ] || [ ${#ids[@]} -eq 1 ] || usage
# A group member's fix round is re-reviewed alone, so a group has no re-review report.
[ "$vgroup" -eq 0 ] || [ -z "$rereview_arg" ] || usage
first=${ids[0]}
idlist=$(IFS=,; echo "${ids[*]}")

plan=$(plan_locate "$plan_arg")
[ -f "$plan" ] || die "no such plan file: $plan"
plan_require_same_project "$plan"
ctx=$(_plan_ctx "$plan")
dforge_stores_init "$ctx"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
src="$TMP/plan.md"
plan_apply_amendments "$plan" "$(plan_amendments_file "$plan")" > "$src" 2>/dev/null \
  || die "an amendment does not apply; run plan-lint" 4
if grep -qE '^(\*\*)?Host:(\*\*)?[ \t]+codex[ \t]*$' <<<"$(plan_header "$src")"; then
  die "a Host: codex plan runs the Codex loop (reference/native-codex.md); task-step is for Claude Code"
fi
for n in "${ids[@]}"; do
  plan_task_text "$src" "$n" >/dev/null || die "no Task $n in $plan" 3
done

slug=$(basename "$plan" .md)
ws=$(dforge_workspace "$slug" "$ctx")
ledger="$(dforge_ledger_dir "$slug" "$ctx")/progress.md"
state="$ws/task-$first-step.json"
plugin_root=$(cd "$HERE/.." && pwd)
brief="$ws/task-$first-brief.md"
report="$ws/task-$first-report.md"

budget_of() { grep -E '^budget' | tail -n 1; }

# The fenced `prompt: |` body of a template, de-indented, without the
# "[Include this section only ...]" instruction lines.
prompt_text() {
  tr -d '\r' < "$1" | awk '
    /^  prompt: \|[ \t]*$/ && !done { on = 1; next }
    on && /^```/ { on = 0; done = 1; next }
    on { sub(/^    /, "") }
    on && !/^\[Include this section only/ { print }'
}

# fill TOKEN VALUE [TOKEN VALUE ...]: stdin to stdout, each literal TOKEN
# replaced by its VALUE. The pairs travel in the environment so that a path
# with a backslash or an ampersand is never read as an escape.
fill() {
  local i=0
  while [ $# -ge 2 ]; do export "TS_T$i=$1" "TS_V$i=$2"; i=$((i + 1)); shift 2; done
  TS_N=$i awk '
    BEGIN { n = ENVIRON["TS_N"] + 0 }
    {
      line = $0
      for (k = 0; k < n; k++) {
        t = ENVIRON["TS_T" k]; v = ENVIRON["TS_V" k]; out = ""
        while ((p = index(line, t)) > 0) { out = out substr(line, 1, p - 1) v; line = substr(line, p + length(t)) }
        line = out line
      }
      print line
    }'
}

title_of() { plan_tasks "$src" | awk -F'\t' -v n="$1" '$1 == n && !d { print $2; d = 1 }' | tr -d '\r'; }

agent_rank() {
  local m e
  if [ "$1" = impl-haiku ]; then echo 0; return; fi
  [[ "$1" =~ ^impl-(sonnet|opus|fable)-(low|medium|high|xhigh|max)$ ]] || return 0
  case ${BASH_REMATCH[1]} in sonnet) m=1 ;; opus) m=2 ;; *) m=3 ;; esac
  case ${BASH_REMATCH[2]} in low) e=0 ;; medium) e=1 ;; high) e=2 ;; xhigh) e=3 ;; *) e=4 ;; esac
  echo $((m * 10 + e))
}

implementer_of() {
  plan_task_text "$src" "$1" | plan_lines Implementer | head -n 1 \
    | sed -nE 's/^\*\*Implementer:\*\*[ \t]*`?([^` \t]+)`?.*/\1/p' | sed 's/^.*://' | tr -d '\r'
}

strip_excerpt() { awk '/^## Plan header excerpt$/ { skip = 1 } /^## UI\/UX contract items$/ { skip = 0 } !skip { print }' "$1"; }
only_excerpt() { awk '/^## Plan header excerpt$/ { on = 1 } /^## UI\/UX contract items$/ { on = 0 } on { print }' "$1"; }

# drop_sections HEADING ...: stdin to stdout without the `## ` sections whose
# heading begins with one of the given words.
drop_sections() {
  local list="" h
  for h in "$@"; do list="$list${list:+|}$h"; done
  TS_DROP=$list awk '
    BEGIN { n = split(ENVIRON["TS_DROP"], d, "|") }
    /^## / { skip = 0; for (i = 1; i <= n; i++) if (index($0, "## " d[i]) == 1) skip = 1 }
    !skip { print }'
}

# Every commit from $1 to $2 is authored and committed by the configured
# user. Prints the digest line.
check_identity() {
  local un ue sha an ae cn ce who bad="" count=0
  un=$(git config user.name | tr -d '\r') ue=$(git config user.email | tr -d '\r')
  if [ -z "$un" ] || [ -z "$ue" ]; then echo "check identity: no git user.name and user.email configured"; return; fi
  while IFS=$'\x1f' read -r sha an ae cn ce; do
    [ -n "$sha" ] || continue
    who=""
    if [ "$an" != "$un" ] || [ "$ae" != "$ue" ]; then who="author $an <$ae>"; fi
    if [ "$cn" != "$un" ] || [ "$ce" != "$ue" ]; then who="${who:+$who, }committer $cn <$ce>"; fi
    [ -n "$who" ] || continue
    count=$((count + 1))
    [ -n "$bad" ] || bad="$sha $who"
  done < <(git log --reverse --format='%h%x1f%an%x1f%ae%x1f%cn%x1f%ce' "$1..$2" | tr -d '\r')
  if [ "$count" -eq 0 ]; then echo "check identity: clean"; return; fi
  echo "check identity: $bad (expected $un <$ue>)$([ "$count" -le 1 ] || echo "; $((count - 1)) more commit(s)")"
}

# No commit from $1 to $2 carries an attribution trailer (a co-author or a
# session line) or a line that begins "Generated with", after any leading
# symbols such as a bullet or an emoji. A mention inside a sentence is not
# attribution. Prints the digest line.
check_attribution() {
  local sha hit bad="" count=0
  for sha in $(git rev-list --reverse "$1..$2" | tr -d '\r'); do
    hit=$(git log -1 --format=%B "$sha" | tr -d '\r' | grep -iE '^[[:space:]]*(co-authored-by|claude-session):|^[^[:alnum:]]*generated with' | head -n 1)
    [ -n "$hit" ] || continue
    count=$((count + 1))
    [ -n "$bad" ] || bad="$(git rev-parse --short=7 "$sha") $(cut -c1-70 <<<"$hit")"
  done
  if [ "$count" -eq 0 ]; then echo "check attribution: clean"; return; fi
  echo "check attribution: $bad$([ "$count" -le 1 ] || echo "; $((count - 1)) more commit(s)")"
}

state_line() {
  jq -r '"state: base \(.base[0:7]) review-head \(if .reviewHead then .reviewHead[0:7] else "-" end) round \(.round) t0 \(.t0 // "-")"' "$state" | tr -d '\r'
}

ledger_init() {
  [ -f "$ledger" ] && return
  mkdir -p "$(dirname "$ledger")"
  printf '# SDD ledger — plan: %s\n' "$(dforge_name "$plan" "$ctx")" > "$ledger"
}

# terminal_line N: the task's last `Task <N>: ` ledger line, stepping over the
# minor (deferred), parked and Ruling: lines (the Recovery rule of
# subagent-driven-development).
terminal_line() {
  [ -f "$ledger" ] || return 0
  tr -d '\r' < "$ledger" | awk -v p="Task $1: " '
    index($0, p) != 1 { next }
    { rest = substr($0, length(p) + 1) }
    index(rest, "minor (deferred)") == 1 || index(rest, "parked") == 1 || index(rest, "Ruling:") == 1 { next }
    { last = $0 }
    END { print last }'
}

# Every task a `Group <list>: review round` line names, one per line: a comma
# list names each task it lists, a range a-b every task from a to b.
group_round_tasks() {
  [ -f "$ledger" ] || return 0
  tr -d '\r' < "$ledger" | awk '
    /^Group [0-9][0-9,-]*: review round/ {
      l = $2; sub(/:$/, "", l)
      n = split(l, parts, ",")
      for (i = 1; i <= n; i++) {
        if (split(parts[i], r, "-") == 2) { for (k = r[1] + 0; k <= r[2] + 0; k++) print k }
        else if (parts[i] != "") print parts[i] + 0
      }
    }'
}

do_start() {
  local base base7 out rc n a agent="" best=-1 rank unknown=0 exec_id="" suffix=")" label titles kept=0
  local template="$plugin_root/skills/subagent-driven-development/references/implementer-prompt.md"
  local dispatch="$ws/task-$first-dispatch.md" budget="" workfrom scene

  if [ -f "$state" ] && [ "$reset" -eq 0 ]; then
    kept=1
    base=$(jq -r '.base' "$state" | tr -d '\r')
  else
    base=$(git rev-parse HEAD) || die "not inside a git checkout"
  fi
  base7=${base:0:7}
  bash "$HERE/sdd-workspace" "$plan" >/dev/null || exit 2

  for n in "${ids[@]}"; do
    out=$(bash "$HERE/task-brief" "$plan" "$n"); rc=$?
    [ "$rc" -eq 0 ] || { printf '%s\n' "$out" >&2; exit "$rc"; }
    if [ "$n" = "$first" ]; then budget=$(budget_of <<<"$out"); fi
  done
  if [ ${#ids[@]} -gt 1 ]; then
    {
      strip_excerpt "$brief"
      for n in "${ids[@]}"; do
        [ "$n" = "$first" ] && continue
        printf '\n---\n\n'
        strip_excerpt "$ws/task-$n-brief.md"
      done
      only_excerpt "$brief"
    } > "$brief.tmp" && mv "$brief.tmp" "$brief"
  fi

  for n in "${ids[@]}"; do
    a=$(implementer_of "$n")
    if [[ "$a" == impl-* ]] && [ -f "$plugin_root/agents/$a.md" ]; then
      rank=$(agent_rank "$a")
      if [ "${rank:--1}" -gt "$best" ]; then best=$rank agent=$a; fi
    else
      unknown=1
    fi
  done
  [ "$unknown" -eq 0 ] || agent=""
  if [ ${#ids[@]} -eq 1 ]; then
    exec_id=$(plan_executors "$src" | awk -F'\t' -v n="$first" '$1 == n { print $2 }' | tr -d '\r')
  fi

  [ -z "$wave" ] || suffix="; wave $wave)"
  if [ -n "$agent" ] && [ -z "$exec_id" ] && [ "$kept" -eq 0 ]; then
    ledger_init
    for n in "${ids[@]}"; do
      printf 'Task %s: implementer %s (assigned; base %s%s\n' "$n" "$agent" "$base7" "$suffix" >> "$ledger"
    done
  fi

  if [ "$kept" -eq 0 ]; then
    jq -n --argjson tasks "$(printf '%s\n' "${ids[@]}" | jq -sc .)" --arg base "$base" --argjson wave "${wave:-null}" \
      '{tasks: $tasks, base: $base, head: null, reviewHead: null, round: 0, t0: null, wave: $wave}' > "$state.tmp" \
      && mv "$state.tmp" "$state"
  fi

  if [ -z "$exec_id" ]; then
    if [ ${#ids[@]} -eq 1 ]; then
      label="Task $first: $(title_of "$first")"
    else
      titles=$(for n in "${ids[@]}"; do title_of "$n"; done | awk 'NR > 1 { printf "; " } { printf "%s", $0 } END { print "" }')
      label="Tasks $(IFS=,; echo "${ids[*]}" | sed 's/,/, /g'): $titles"
    fi
    workfrom="Work from: $(git rev-parse --show-toplevel)"
    [ -z "$wave" ] || workfrom="Work from: your worktree (see the Parallel workspace section)"
    reportat="$report"
    [ -z "$wave" ] || reportat="task-$first-report.md in the directory sdd-workspace prints in your worktree (see the Parallel workspace section)"
    scene="The message that sent you to this file says where the task fits, and carries the interfaces from earlier tasks and the verdicts that bear on it."
    prompt_text "$template" | fill \
      '[BRIEF_FILE]' "$brief" '[REPORT_FILE]' "$reportat" '[PLUGIN_ROOT]' "$plugin_root" \
      '[IMPLEMENTER]' "${agent:-the scored implementer}" 'Task N: [task name]' "$label" \
      'Work from: [directory]' "$workfrom" \
      '[Scene-setting: where this fits, dependencies, architectural context]' "$scene" > "$dispatch"
    unexpanded=$(grep -oE '\[[A-Z][A-Z_]*\]' "$dispatch" | head -n 1)
    [ -s "$dispatch" ] && [ -z "$unexpanded" ] || die "dispatch file $dispatch is empty or holds an unexpanded placeholder ${unexpanded:-}"
  fi

  printf 'task %s: briefed %s, base %s' "$idlist" "$brief" "$base7"
  if [ "$kept" -eq 1 ]; then printf '; state kept, no assigned line written (--reset discards the state)\n'
  elif [ -n "$exec_id" ]; then printf '; executor task, no dispatch file written\n'
  elif [ -n "$agent" ]; then printf '; assigned %s\n' "$agent"
  else printf '; no assigned line written\n'; fi
  if [ -n "$exec_id" ]; then
    printf 'executor %s: follow executor-lane.md §Dispatch\n' "$exec_id"
  elif [ -n "$agent" ]; then
    printf 'seat: dforge:%s prompt: %s\n' "$agent" "$dispatch"
  else
    printf 'seat: unscored (no known **Implementer:** line; score it per ladder.md, dispatch that agent, end its assigned line with "; scored at dispatch") prompt: %s\n' "$dispatch"
  fi
  state_line
  printf '%s\n' "${budget:-budget: unknown}"
}

route_field() { sed -n "s/.* $1=\\([^ ]*\\).*/\\1/p" <<<"$route" | tr -d '\r'; }

do_review() {
  local base head basesha headsha diff pkgout rc t0 gate route rrc primary fallback reason note="" tier="" judge
  local lens_files="" lout lrc n line secs timeout_ms cmd top drops=() unexpanded snap
  local template="$plugin_root/skills/subagent-driven-development/references/task-reviewer-prompt.md"
  local judge_prompt="$ws/task-$first-review-prompt.md" codex_prompt="$ws/task-$first-review-codex-prompt.md"
  local codex_out="$ws/task-$first-review-codex.json"

  [ -f "$state" ] || die "Task $first has no step state; run task-step start first" 6
  top=$(git rev-parse --show-toplevel)
  if [ -n "$cwd_arg" ]; then
    [ -d "$cwd_arg" ] || die "bad --cwd: $cwd_arg"
    top=$cwd_arg
  fi
  base=$base_arg
  [ -n "$base" ] || base=$(jq -r '.base' "$state" | tr -d '\r')
  head=$head_arg
  [ -n "$head" ] || head=$(jq -r '.head // empty' "$state" | tr -d '\r')
  [ -n "$head" ] || head=HEAD
  basesha=$(git rev-parse --verify --quiet "$base^{commit}") || die "bad BASE: $base"
  headsha=$(git rev-parse --verify --quiet "$head^{commit}") || die "bad head: $head"

  gate=$(bash "${TASK_STEP_CODEX_GATE:-$HERE/codex-gate}" 2>/dev/null | tail -n 1 | tr -d '\r')
  route=$(bash "$HERE/review-route" "$plan" --task "${ids[@]}" 2>"$TMP/route.err"); rrc=$?
  if [ "$rrc" -eq 0 ]; then
    primary=$(route_field primary) fallback=$(route_field fallback) reason=$(route_field reason)
  else
    primary=dforge:judge-opus fallback=- reason=route-failed
    note=" (review-route exited $rrc: $(tr -d '\r' < "$TMP/route.err" | head -n 1))"
  fi
  case $primary in
    codex:light) tier=light judge=$fallback ;;
    codex:heavy+judge-opus) tier=heavy judge=dforge:judge-opus ;;
    *) judge=$primary ;;
  esac
  case $judge in dforge:*) ;; *) judge=dforge:judge-opus ;; esac

  for n in "${ids[@]}"; do
    lout=$(bash "$HERE/lens-route" "$plan" --task "$n" 2>&1); lrc=$?
    [ "$lrc" -eq 0 ] || die "lens-route: $(tr -d '\r' <<<"$lout" | head -n 1)"
    while IFS= read -r line; do
      line=$(sed -n 's/^lens [^ ]* criteria=\(.*\)$/\1/p' <<<"$line" | tr -d '\r')
      [ -n "$line" ] || continue
      case ", $lens_files, " in *", $line, "*) continue ;; esac
      lens_files="${lens_files:+$lens_files, }$line"
    done <<<"$lout"
  done

  pkgout=$(bash "$HERE/review-package" "$plan" "$basesha" "$headsha"); rc=$?
  [ "$rc" -eq 0 ] || { printf '%s\n' "$pkgout" >&2; exit "$rc"; }
  t0=$(date +%s)
  diff=$(sed -n 's/^wrote \(.*\): [0-9]* commit(s), [0-9]* bytes$/\1/p' <<<"$pkgout" | head -n 1 | tr -d '\r')

  [ -n "$lens_files" ] || drops+=("Lens Criteria")
  [ "$tier" = heavy ] || drops+=("Second Pass")
  prompt_text "$template" | drop_sections ${drops[@]+"${drops[@]}"} | fill \
    '[BASE_SHA]' "$basesha" '[HEAD_SHA]' "$headsha" '[DIFF_FILE]' "$diff" '[BRIEF_FILE]' "$brief" \
    '[IMPLEMENTER_REPORT_FILE]' "$report" '[REPORT_FILE]' "$ws/task-$first-review-report.md" \
    '[PLUGIN_ROOT]' "$plugin_root" '[JUDGE]' "$judge" \
    '[LENS_FILES]' "$lens_files" '[CODEX_REVIEW_FILE]' "$codex_out" > "$judge_prompt"

  if [ -n "$tier" ]; then
    {
      prompt_text "$template" | drop_sections "Output Format" "Criteria" "Lens Criteria" "Second Pass" | fill \
        '[BASE_SHA]' "$basesha" '[HEAD_SHA]' "$headsha" '[DIFF_FILE]' "$diff" '[BRIEF_FILE]' "$brief" \
        '[IMPLEMENTER_REPORT_FILE]' "$report" '[PLUGIN_ROOT]' "$plugin_root" '[JUDGE]' "$judge"
      printf '\n## Criteria\n\nScore each criterion independently on a 1 to 20 scale, where 1 is a clear failure, 10 is genuinely uncertain, and 20 is clearly met.\n\n'
      tr -d '\r' < "$plugin_root/criteria/task-review.md" | sed 's/^#/##/'
      printf '\nScore against those criteria and nothing else. Where a criterion tells you to ignore something, ignoring it is part of scoring correctly.\n\n'
      printf '## Output\n\nYour final message is one JSON object that satisfies the output schema, and nothing else: no markdown and no preamble. It carries the four scores (spec, scope, verification, quality), spec_verdict (compliant or issues), task_quality (approved or needs_fixes), findings (severity, file, line and summary for each; line is 0 when a finding has no single line) and cannot_verify (the requirements you could not verify from the diff alone; an empty array when there are none). This overrides any instruction above about the shape of your final message.\n'
    } > "$codex_prompt"
    case $tier in
      light) secs=$(ladder_block codex-judge | awk 'END { print $3 }') ;;
      *) secs=$(ladder_block codex-judge | awk 'NR == 1 { print $3 }') ;;
    esac
    timeout_ms=$(( (${secs:-0} + 120) * 1000 ))
    cmd="bash \"$plugin_root/scripts/run-codex-review.sh\" --kind task --tier $tier --cwd \"$top\" --out \"$codex_out\" --prompt \"$codex_prompt\""
  fi
  for line in "$judge_prompt" ${tier:+"$codex_prompt"}; do
    unexpanded=$(grep -oE '\[[A-Z][A-Z_]*\]' "$line" | head -n 1)
    [ -z "$unexpanded" ] || die "unexpanded placeholder $unexpanded in $line"
  done
  rm -f "$ws/task-$first-review-report.md"

  snap=$(tracked_snapshot "$top")
  jq --arg rh "$headsha" --argjson t0 "$t0" --arg base "$base_arg" --arg bsha "$basesha" --arg head "$head_arg" --arg chk "$snap" \
    '.reviewHead = $rh | .t0 = $t0 | (if $base == "" then . else .base = $bsha end) | (if $head == "" then . else .head = $head end)
     | (if $chk == "" then del(.reviewCheck) else .reviewCheck = ($chk | fromjson) end)' \
    "$state" > "$state.tmp" && mv "$state.tmp" "$state"

  printf 'task %s: reviewed %s..%s (%s commit(s)), diff %s\n' "$idlist" "${basesha:0:7}" "${headsha:0:7}" \
    "$(git rev-list --count "$basesha..$headsha")" "$diff"
  if [ "$reason" = codex-off ] || [[ "$gate" == *source=probe ]]; then printf 'gate: %s\n' "$gate"; fi
  case $tier in
    light) printf 'seat: codex:light prompt: %s fallback: %s prompt: %s\n' "$codex_prompt" "$judge" "$judge_prompt" ;;
    heavy) printf 'seat: codex:heavy+judge-opus prompt: %s then: %s prompt: %s\n' "$codex_prompt" "$judge" "$judge_prompt" ;;
    *) printf 'seat: %s prompt: %s%s\n' "$judge" "$judge_prompt" "$note" ;;
  esac
  if [ -n "$tier" ]; then printf 'codex: %s\ntimeout: %s\n' "$cmd" "$timeout_ms"; fi
  check_identity "$basesha" "$headsha"
  check_attribution "$basesha" "$headsha"
  state_line
  printf '%s\n' "$(budget_of <<<"$pkgout")"
}

do_hold() {
  local route tier="" held base line appended=1 budget held_cwd
  # A route that cannot score the task never groups it.
  route=$(bash "$HERE/review-route" "$plan" --task "$first" 2>/dev/null) && tier=$(route_field review)
  [ "$tier" = group ] || die "Task $first is reviewed alone (review-route: review=task); run task-step review" 4
  [ -f "$state" ] || die "Task $first has no step state; run task-step start first" 6
  if [ -n "$cwd_arg" ] && [ ! -d "$cwd_arg" ]; then die "bad --cwd: $cwd_arg"; fi
  if [ -n "$head_arg" ]; then
    held=$(git rev-parse --verify --quiet "$head_arg^{commit}") || die "bad head: $head_arg"
  elif [ -n "$cwd_arg" ]; then
    held=$(git -C "$cwd_arg" rev-parse HEAD) || die "bad --cwd: $cwd_arg"
  else
    held=$(git rev-parse HEAD) || die "not inside a git checkout"
  fi
  base=$(jq -r '.base' "$state" | tr -d '\r')
  line="Task $first: awaiting group review (commits ${base:0:7}..${held:0:7})"
  if [ "$(terminal_line "$first")" = "$line" ]; then
    appended=0
  else
    ledger_init
    printf '%s\n' "$line" >> "$ledger"
  fi
  held_cwd=$cwd_arg
  [ -n "$held_cwd" ] || held_cwd=$(git rev-parse --show-toplevel | tr -d '\r')
  jq --arg h "$held" --arg head "$head_arg" --arg hc "$held_cwd" \
    '.heldHead = $h | .heldCwd = $hc | (if $head == "" then . else .head = $head end)' \
    "$state" > "$state.tmp" && mv "$state.tmp" "$state" || die "cannot update $state"

  if [ "$appended" -eq 1 ]; then
    printf 'task %s: held for group review (commits %s..%s)\n' "$first" "${base:0:7}" "${held:0:7}"
  else
    printf 'task %s: already held for group review (commits %s..%s)\n' "$first" "${base:0:7}" "${held:0:7}"
  fi
  printf 'state: base %s held-head %s\n' "${base:0:7}" "${held:0:7}"
  budget=$(DFORGE_BUDGET_CALLER=task-step:hold bash "$HERE/context-size" 2>/dev/null | budget_of)
  printf '%s\n' "${budget:-budget: unknown}"
}

do_group() {
  local n i list pending="" rounds ghead mstate sbase sheld lout lrc lenses pkgout rc
  local route rrc primary fallback note="" judge unexpanded t0 line id_line at_line budget
  local mcwd default_cwd snaps="" snap seen
  local members=() bases=() helds=() check_dirs=()
  local template="$plugin_root/skills/subagent-driven-development/references/group-reviewer-prompt.md"

  while IFS= read -r n; do members+=("$n"); done < <(printf '%s\n' "${ids[@]}" | sort -n -u)
  list=$(IFS=,; echo "${members[*]}")
  local pkg="$ws/group-$list-review-package.md" prompt="$ws/group-$list-review-prompt.md"
  local gstate="$ws/group-$list-step.json"

  for n in "${members[@]}"; do
    case $(terminal_line "$n") in
      "Task $n: awaiting group review ("*) ;;
      *) die "Task $n holds no awaiting group review line; hold it or review it alone" 4 ;;
    esac
  done
  # A group in its fix rounds is never reviewed again: that would reset each
  # member's round to 0 and lift the two-round cap.
  rounds=$(group_round_tasks)
  for n in "${members[@]}"; do
    if grep -qxF "$n" <<<"$rounds"; then pending="${pending:+$pending, }Task $n"; fi
  done
  [ -z "$pending" ] || die "already in group review rounds: $pending; re-review a member with task-step rereview" 4

  if [ -n "$cwd_arg" ]; then
    [ -d "$cwd_arg" ] || die "bad --cwd: $cwd_arg"
    ghead=$(git -C "$cwd_arg" rev-parse HEAD) || die "bad --cwd: $cwd_arg"
  else
    ghead=$(git rev-parse HEAD) || die "not inside a git checkout"
  fi

  default_cwd=$cwd_arg
  [ -n "$default_cwd" ] || default_cwd=$(git rev-parse --show-toplevel | tr -d '\r')
  printf '# Group review package: Tasks %s\n' "$list" > "$TMP/package.md"
  for n in "${members[@]}"; do
    mstate="$ws/task-$n-step.json"
    [ -f "$mstate" ] || die "Task $n has no step state; run task-step start first" 6
    sbase=$(jq -r '.base' "$mstate" | tr -d '\r')
    sheld=$(jq -r '.heldHead // empty' "$mstate" | tr -d '\r')
    [ -n "$sheld" ] || die "Task $n has no held head; run task-step hold first" 6
    bases+=("$sbase") helds+=("$sheld")
    mcwd=$(jq -r '.heldCwd // empty' "$mstate" | tr -d '\r')
    [ -n "$mcwd" ] || mcwd=$default_cwd
    seen=0
    for i in ${check_dirs[@]+"${!check_dirs[@]}"}; do [ "${check_dirs[$i]}" != "$mcwd" ] || seen=1; done
    [ "$seen" -eq 1 ] || check_dirs+=("$mcwd")
    lout=$(bash "$HERE/lens-route" "$plan" --task "$n" 2>&1); lrc=$?
    [ "$lrc" -eq 0 ] || die "lens-route: $(tr -d '\r' <<<"$lout" | head -n 1)"
    lenses=$(sed -n 's/^lens [^ ]* criteria=\(.*\)$/\1/p' <<<"$lout" | tr -d '\r' | awk 'NR > 1 { printf ", " } { printf "%s", $0 }')
    pkgout=$(bash "$HERE/review-package" "$plan" "$sbase" "$sheld" "$TMP/task-$n.diff"); rc=$?
    [ "$rc" -eq 0 ] || { printf '%s\n' "$pkgout" >&2; exit "$rc"; }
    {
      printf '\n## Task %s\n\n**Brief:** %s\n**Report:** %s\n**Commits:** %s..%s\n' \
        "$n" "$ws/task-$n-brief.md" "$ws/task-$n-report.md" "${sbase:0:7}" "${sheld:0:7}"
      [ -z "$lenses" ] || printf '**Lenses:** %s\n' "$lenses"
      tail -n +2 "$TMP/task-$n.diff" | sed 's/^## /### /'
    } >> "$TMP/package.md"
  done

  route=$(bash "$HERE/review-route" "$plan" --task "${members[@]}" 2>"$TMP/route.err"); rrc=$?
  if [ "$rrc" -eq 0 ]; then
    primary=$(route_field primary) fallback=$(route_field fallback)
  else
    primary=dforge:judge-opus fallback=-
    note=" (review-route exited $rrc: $(tr -d '\r' < "$TMP/route.err" | head -n 1))"
  fi
  case $primary in
    codex:light) judge=$fallback ;;
    codex:*) judge=dforge:judge-opus ;;
    *) judge=$primary ;;
  esac
  case $judge in dforge:*) ;; *) judge=dforge:judge-opus ;; esac

  [ -f "$template" ] || die "missing template $template"
  prompt_text "$template" | fill '[GROUP_LIST]' "$list" '[PACKAGE_FILE]' "$pkg" \
    '[REPORT_FILE]' "$ws/group-$list-review-report.md" '[PLUGIN_ROOT]' "$plugin_root" > "$TMP/prompt.md"
  unexpanded=$(grep -oE '\[[A-Z][A-Z_]*\]' "$TMP/prompt.md" | head -n 1)
  [ -s "$TMP/prompt.md" ] && [ -z "$unexpanded" ] || die "group prompt is empty or holds an unexpanded placeholder ${unexpanded:-}"

  id_line="check identity: clean" at_line="check attribution: clean"
  for i in "${!members[@]}"; do
    line=$(check_identity "${bases[$i]}" "${helds[$i]}")
    if [ "$id_line" = "check identity: clean" ] && [ "$line" != "$id_line" ]; then
      id_line="check identity: Task ${members[$i]}: ${line#check identity: }"
    fi
    line=$(check_attribution "${bases[$i]}" "${helds[$i]}")
    if [ "$at_line" = "check attribution: clean" ] && [ "$line" != "$at_line" ]; then
      at_line="check attribution: Task ${members[$i]}: ${line#check attribution: }"
    fi
  done

  rm -f "$ws/group-$list-review-report.md"
  cp "$TMP/package.md" "$pkg" && cp "$TMP/prompt.md" "$prompt" || die "cannot write $pkg or $prompt"
  for mcwd in "${check_dirs[@]}"; do
    snap=$(tracked_snapshot "$mcwd")
    [ -z "$snap" ] || snaps="$snaps$snap"$'\n'
  done
  t0=$(date +%s)
  jq -n --argjson tasks "$(printf '%s\n' "${members[@]}" | jq -sc .)" --arg rh "$ghead" --argjson t0 "$t0" \
    --argjson checks "$(printf '%s' "$snaps" | jq -sc .)" \
    '{tasks: $tasks, reviewHead: $rh, t0: $t0, reviewChecks: $checks}' > "$gstate.tmp" && mv "$gstate.tmp" "$gstate" || die "cannot write $gstate"
  for n in "${members[@]}"; do
    mstate="$ws/task-$n-step.json"
    # A member held with --head is a wave task: its own held head is what was reviewed.
    jq --arg g "$ghead" --argjson t0 "$t0" --arg list "$list" \
      '.reviewHead = (if (.head // "") != "" then .heldHead else $g end) | .t0 = $t0 | .round = 0 | .group = $list' \
      "$mstate" > "$mstate.tmp" && mv "$mstate.tmp" "$mstate" || die "cannot update $mstate"
  done

  printf 'group %s: packaged %s task(s) at head %s, package %s\n' "$list" "${#members[@]}" "${ghead:0:7}" "$pkg"
  printf 'seat: %s prompt: %s%s\n' "$judge" "$prompt" "$note"
  printf '%s\n%s\n' "$id_line" "$at_line"
  printf 'state: group %s review-head %s round 0 t0 %s\n' "$list" "${ghead:0:7}" "$t0"
  budget=$(DFORGE_BUDGET_CALLER=task-step:review-group bash "$HERE/context-size" 2>/dev/null | budget_of)
  printf '%s\n' "${budget:-budget: unknown}"
}

# parse_report REPORT MODE TASKS GROUP: checks the judge report grammar and
# prints one record per line: "K\t<verdict key line>", "F\t<severity>\t<task>\t
# <file>\t<line>\t<one-liner>", "C\t<cannot-verify item>". On the first
# refusal it prints "E\t<reason>" and exits 1. MODE is review or rereview;
# TASKS is the comma list whose verdict keys a group report must carry.
parse_report() {
  tr -d '\r' < "$1" | awk -v mode="$2" -v tasks="$3" -v group="$4" -v first="$first" '
    function err(s) { print "E\t" s; bad = 1; exit 1 }
    function need(key, allowed, v) {
      if (!(key in KV)) err("missing verdict line '"'"'" key ": …'"'"'")
      v = KV[key]
      if (allowed == "SCORES") {
        if (v !~ /^spec [0-9]+ \/ scope [0-9]+ \/ verification [0-9]+ \/ quality [0-9]+$/) err("bad verdict line: " KL[key])
        n = split(v, w, " ")
        for (j = 2; j <= n; j += 3) if (w[j] + 0 < 1 || w[j] + 0 > 20) err("bad verdict line: " KL[key])
      } else if (allowed == "COUNT") {
        if (v !~ /^[0-9]+$/) err("bad verdict line: " KL[key])
      } else if (index("|" allowed "|", "|" v "|") == 0) err("bad verdict line: " KL[key])
    }
    BEGIN { nt = split(tasks, T, ","); for (i = 1; i <= nt; i++) LISTED[T[i]] = 1 }
    !started {
      if ($0 ~ /^[ \t]*$/) next
      if ($0 != "## Verdict") err("does not open with ## Verdict")
      started = 1; sect = "Verdict"; nsect = 1; next
    }
    /^## / {
      sect = substr($0, 4); sub(/[ \t]+$/, "", sect); nsect++
      if (sect == "Codex findings") codex_at = nsect
      next
    }
    sect == "Verdict" {
      if ($0 !~ /^[^:]+: .+$/) next
      key = $0; sub(/: .*$/, "", key)
      val = substr($0, length(key) + 3); sub(/[ \t]+$/, "", val)
      if (!(key in KV)) { KV[key] = val; KL[key] = $0 }
      out[++no] = "K\t" $0
      next
    }
    sect == "Findings" && /^- / {
      if (tolower($0) ~ /^- none[ \t]*$/) next
      if ($0 !~ /^- \[(Critical|Important|Minor)\] (\(Task [0-9]+\) )?[^ ]+:[0-9]+(-[0-9]+)? (—|-) .+$/) err("line " NR " is not a finding line: " $0)
      rest = substr($0, 4); sev = rest; sub(/\].*$/, "", sev)
      rest = substr(rest, length(sev) + 3)
      task = ""
      if (rest ~ /^\(Task [0-9]+\) /) {
        task = rest; sub(/\).*$/, "", task); sub(/^\(Task /, "", task)
        rest = substr(rest, index(rest, ") ") + 2)
      }
      if (group && (task == "" || !(task in LISTED))) err("line " NR " is not a finding line: " $0)
      if (!group && task != "") err("line " NR " is not a finding line: " $0)
      if (task == "") task = first
      loc = rest; sub(/ .*$/, "", loc)
      rest = substr(rest, length(loc) + 2)
      one = rest; sub(/^[^ ]+ /, "", one)
      match(loc, /:[0-9]+(-[0-9]+)?$/)
      out[++no] = "F\t" sev "\t" task "\t" substr(loc, 1, RSTART - 1) "\t" substr(loc, RSTART + 1) "\t" one
      next
    }
    sect == "Cannot verify" && /^- / {
      if (tolower($0) ~ /^- none[ \t]*$/) next
      out[++no] = "C\t" substr($0, 3)
      next
    }
    END {
      if (bad) exit 1
      if (!started) err("does not open with ## Verdict")
      if (mode == "rereview") { need("fix round", "addressed|open"); need("open", "COUNT") }
      else if (group) for (i = 1; i <= nt; i++) {
        need("Task " T[i] " spec", "pass|fail|cannot-verify")
        need("Task " T[i] " quality", "approved|changes")
        need("Task " T[i] " scores", "SCORES")
      } else { need("spec", "pass|fail|cannot-verify"); need("quality", "approved|changes"); need("scores", "SCORES") }
      if (codex_at && codex_at != nsect) err("## Codex findings is not the report'"'"'s last section")
      for (i = 1; i <= no; i++) print out[i]
    }'
}

# check_tracked: the check line, after comparing every snapshot the review
# step recorded with its checkout now. Exits 6 on a change, naming it.
check_tracked() {
  local vstate=$1 snaps k snap dir old new changed
  if [ "$vgroup" -eq 1 ]; then
    snaps=$(jq -c '(.reviewChecks // [])[]' "$vstate" | tr -d '\r')
  else
    snaps=$(jq -c '.reviewCheck // empty' "$vstate" | tr -d '\r')
  fi
  k=$(printf '%s' "$snaps" | grep -c .)
  if [ "$k" -eq 0 ]; then
    echo "check tracked: not recorded (the review step predates this check)"
    return
  fi
  [ -z "$cwd_arg" ] || [ "$k" -eq 1 ] || die "--cwd names one checkout; this group recorded $k"
  while IFS= read -r snap; do
    dir=$cwd_arg
    [ -n "$dir" ] || dir=$(jq -r '.cwd' <<<"$snap" | tr -d '\r')
    [ -d "$dir" ] || die "bad --cwd: $dir"
    old=$(jq -r '.head' <<<"$snap" | tr -d '\r')
    new=$(git -C "$dir" rev-parse HEAD 2>/dev/null | tr -d '\r')
    [ -n "$new" ] || die "bad --cwd: $dir"
    if [ "$new" != "$old" ]; then
      {
        printf 'task-step: HEAD moved during the review in %s (%s -> %s); files changed since:\n' "$dir" "${old:0:7}" "${new:0:7}"
        git -C "$dir" -c core.quotepath=off diff --name-only --no-renames "$old" | tr -d '\r'
      } >&2
      exit 6
    fi
    jq -r '.dirty[] | "\(.path)\t\(.hash)"' <<<"$snap" | tr -d '\r' > "$TMP/recorded"
    dirty_list "$dir" > "$TMP/now"
    changed=$(awk -F'\t' '
      FNR == NR { rec[$1] = $2; next }
      !($1 in rec) || rec[$1] != $2 { print $1 }
      { delete rec[$1] }
      END { for (p in rec) print p }' "$TMP/recorded" "$TMP/now" | LC_ALL=C sort -u)
    if [ -n "$changed" ]; then
      {
        printf 'task-step: tracked files changed during the review in %s; restore them with git -C %s checkout -- <files>:\n' "$dir" "$dir"
        printf '%s\n' "$changed"
      } >&2
      exit 6
    fi
  done <<<"$snaps"
  echo "check tracked: clean"
}

do_verdict() {
  local n list vstate rpath mode check_line recs rc rec tag rest sev task file line one t r fix l nv i room nc budget
  local members=() fixes=() vlines=() flines=() cvs=() minors=()
  local crit=0 imp=0 minor=0
  if [ "$vgroup" -eq 1 ]; then
    while IFS= read -r n; do members+=("$n"); done < <(printf '%s\n' "${ids[@]}" | sort -n -u)
    list=$(IFS=,; echo "${members[*]}")
    vstate=$ws/group-$list-step.json
    [ -f "$vstate" ] && [ -n "$(jq -r '.reviewHead // empty' "$vstate" | tr -d '\r')" ] \
      || die "run task-step review --group for group $list first" 6
    rpath=$ws/group-$list-review-report.md
  else
    members=("$first")
    list=$first
    vstate=$state
    [ -f "$vstate" ] && [ -n "$(jq -r '.reviewHead // empty' "$vstate" | tr -d '\r')" ] \
      || die "run task-step review for task $first first" 6
    rpath=$ws/task-$first-review-report.md
    [ -z "$rereview_arg" ] || rpath=$ws/task-$first-rereview-$rereview_arg-report.md
  fi
  mode=review
  [ -z "$rereview_arg" ] || mode=rereview

  [ -z "$cwd_arg" ] || [ -d "$cwd_arg" ] || die "bad --cwd: $cwd_arg"
  check_line=$(check_tracked "$vstate"); rc=$?
  [ "$rc" -eq 0 ] || exit "$rc"

  [ -f "$rpath" ] || die "no report at $rpath: the seat wrote none" 5
  recs=$(parse_report "$rpath" "$mode" "$list" "$vgroup"); rc=$?
  [ "$rc" -eq 0 ] || die "$rpath: ${recs#E$'\t'}" 5

  : > "$TMP/serious"
  while IFS= read -r rec; do
    tag=${rec%%$'\t'*} rest=${rec#*$'\t'}
    case $tag in
      K) vlines+=("$rest") ;;
      C) cvs+=("$rest") ;;
      F)
        IFS=$'\t' read -r sev task file line one <<<"$rest"
        case $sev in
          Critical) crit=$((crit + 1)) ;;
          Important) imp=$((imp + 1)) ;;
          *) minor=$((minor + 1)); minors+=("Task $task: minor (deferred): $file:$line — $one"); continue ;;
        esac
        flines+=("$sev $task $file:$line — $one")
        printf '%s\t%s\t%s\t%s\t%s\n' "$task" "$sev" "$file" "$line" "$one" >> "$TMP/serious"
        ;;
    esac
  done <<<"$recs"

  for t in "${members[@]}"; do
    n=$(awk -F'\t' -v t="$t" '$1 == t { c++ } END { print c + 0 }' "$TMP/serious")
    [ "$n" -gt 0 ] || continue
    if [ "$vgroup" -eq 1 ]; then
      r=$(jq -r '.round // 0' "$ws/task-$t-step.json" 2>/dev/null | tr -d '\r')
    else
      r=$(jq -r '.round // 0' "$vstate" | tr -d '\r')
    fi
    fix=$ws/task-$t-fix-$(( ${r:-0} + 1 )).md
    awk -F'\t' -v t="$t" -v report="$rpath" '
      $1 == t { n++; sev[n] = $2; loc[n] = $3 ($4 == "0" ? "" : ":" $4); full[n] = $3 ":" $4; one[n] = $5 }
      END {
        for (i = 1; i <= n; i++) print "- " loc[i] ": " one[i]
        print ""
        print "Severity and detail: " report
        for (i = 1; i <= n; i++) print "- [" sev[i] "] " full[i] " — " one[i]
      }' "$TMP/serious" > "$fix" || die "cannot write $fix"
    fixes+=("$fix ($n finding$([ "$n" -eq 1 ] || echo s))")
  done

  for l in ${minors[@]+"${minors[@]}"}; do
    if [ -f "$ledger" ] && tr -d '\r' < "$ledger" | grep -qxF -- "$l"; then continue; fi
    ledger_init
    printf '%s\n' "$l" >> "$ledger"
  done

  if [ "$vgroup" -eq 1 ]; then
    printf 'group %s: verdict from %s\n' "$list" "$rpath"
  else
    printf 'task %s: verdict from %s\n' "$idlist" "$rpath"
  fi
  nv=${#vlines[@]}
  if [ "$nv" -gt 12 ]; then
    printf '%s\n' "${vlines[@]:0:11}"
    printf 'verdict: %s more lines in the report\n' "$((nv - 11))"
    nv=12
  elif [ "$nv" -gt 0 ]; then
    printf '%s\n' "${vlines[@]}"
  fi
  printf 'findings: %s Critical, %s Important, %s Minor\n' "$crit" "$imp" "$minor"
  [ "${#flines[@]}" -eq 0 ] || printf '%s\n' "${flines[@]}"
  # Every line but the finding lines fits in 20: the first, the verdict lines,
  # and the findings, fix, minor, check and budget lines leave this many.
  room=$((20 - nv - 6))
  nc=${#cvs[@]}
  if [ "$nc" -le "$room" ]; then
    for i in ${cvs[@]+"${!cvs[@]}"}; do printf 'cannot-verify: %s\n' "${cvs[$i]}"; done
  else
    for ((i = 0; i < room - 1; i++)); do printf 'cannot-verify: %s\n' "${cvs[$i]}"; done
    printf 'cannot-verify: %s more in the report\n' "$((nc - room + 1))"
  fi
  if [ "${#fixes[@]}" -eq 0 ]; then
    echo "fix: none"
  else
    printf 'fix: %s' "${fixes[0]}"
    for i in "${!fixes[@]}"; do [ "$i" -eq 0 ] || printf '; %s' "${fixes[$i]}"; done
    echo
  fi
  printf 'minor: %s logged as deferred\n' "$minor"
  printf '%s\n' "$check_line"
  budget=$(DFORGE_BUDGET_CALLER="task-step:verdict" bash "$HERE/context-size" 2>/dev/null | budget_of)
  printf '%s\n' "${budget:-budget: unknown}"
}

case $sub in
  start) do_start ;;
  review) do_review ;;
  hold) do_hold ;;
  group) do_group ;;
  verdict) do_verdict ;;
esac
