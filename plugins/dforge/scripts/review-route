#!/usr/bin/env bash
# Print the review seat for a task, a batch, or a plan-review round, and the
# Claude seat that replaces it when a Codex seat produces nothing.
#
# The routing table lives here rather than in prose for the reason
# run-codex-review.sh gives: a rule a seat must follow is only reachable when a
# test can reach it. This script never probes Codex: it reads the file
# scripts/codex-gate keeps for this session, and while that file does not open
# the review surface it names Claude seats only, with reason=codex-off. While
# the surface is open, run-codex-review.sh still checks availability on every
# run, and its status line decides whether the fallback is used.
#
# Usage: review-route PLAN_FILE --task ID [ID ...]
#        review-route PLAN_FILE --plan-round R
#        review-route PLAN_FILE --ruling KIND[,KIND...] [ID ...]
#        review-route PLAN_FILE --final
#        review-route PLAN_FILE --final-fix FILE [FILE ...]
# ID is a task number, or a task number and part letter for a split task (7B).
# Output: review-seat <scope> primary=<seat> fallback=<seat|-> reason=<why>
#         (a plan round appends cap=<n>; a single --task ID puts
#         review=<task|group> before reason=)
# A Claude plan's round cap comes from scripts/depth-route's depth: light and
# standard 1, full 2; any round past the cap exits 2.
# A Host: codex plan routes only --plan-round and --final-fix, to a native seat
# printed as primary=native:<model>/<effort>; its other seats come from
# reference/native-codex.md.
# Exit: 0 routed, including a lone --task ID with no Evaluation line, which
# prints review=task reason=unscored; 2 usage error, missing task, unparseable
# Evaluation, a batch task with no Evaluation line, or any other route on a
# Codex-host plan.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/plan.sh"
. "$HERE/lib/depth.sh"
. "$HERE/lib/executor-session.sh"

SONNET=dforge:judge-sonnet-high
OPUS=dforge:judge-opus
# jq reads it on stdin: under MSYS_NO_PATHCONV, jq.exe cannot open the /d/...
# form pwd gives on Git Bash.
ROUTING="$HERE/../reference/codex-routing.json"
SEP='( — | – | - | -- )'

die() { printf 'review-route: %s\n' "$1" >&2; exit 2; }
usage() { die "usage: review-route PLAN_FILE --task ID [ID ...] | --plan-round R | --ruling KIND[,KIND...] [ID ...] | --final | --final-fix FILE [FILE ...]"; }

[ $# -ge 2 ] || usage
plan=$(plan_locate "$1"); shift
[ -f "$plan" ] || die "no such plan file: $plan"
dforge_stores_init "$(_plan_ctx "$plan")"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
src="$TMP/plan.md"
plan_apply_amendments "$plan" "$(plan_amendments_file "$plan")" > "$src" 2>/dev/null \
  || die "an amendment does not apply; run plan-lint"

# Captured, not piped: grep -q exits at its first match, and under pipefail the
# writer's SIGPIPE would decide the if, not the match.
header=$(plan_header "$src")
native=0
grep -qE '^(\*\*)?Host:(\*\*)?[ \t]+codex[ \t]*$' <<<"$header" && native=1
if [ "$native" -eq 1 ] && [ "$1" != --plan-round ] && [ "$1" != --final-fix ]; then
  die "a Host: codex plan routes reviews through reference/native-codex.md"
fi

# plan_shape — sets intricate (1 when a task is at risk 3 or totals 6) for
# --ruling. It sets no cap: a Claude plan's review cap comes from claude_cap.
plan_shape() {
  local n t r
  intricate=0
  while IFS=$'\t' read -r n t r; do
    [ -n "$n" ] || continue
    [ "$t" != "?" ] || die "Task $n: the Evaluation line does not parse"
    [ "$t" != "-" ] || continue
    if [ "$r" -ge 3 ] || [ "$t" -ge 6 ]; then intricate=1; fi
  done < <(plan_scores "$src")
}

# claude_cap — a Claude plan's review cap from its depth (lib/depth.sh): light
# and standard 1, full 2. A depth that does not print takes the full cap.
claude_cap() {
  local root depth
  root=$(git -C "$(dirname "$plan")" rev-parse --show-toplevel 2>/dev/null || git rev-parse --show-toplevel 2>/dev/null || pwd)
  depth=$(depth_plan_depth "$src" "$root")
  case $depth in light|standard) cap=1 ;; *) cap=2 ;; esac
}

# cap_for MAX — a Codex-host plan's review cap from its highest raw task total;
# a Claude plan's cap does not come from here.
cap_for() {
  cap=1
  if [ "$1" -ge 6 ]; then cap=3; elif [ "$1" -ge 4 ]; then cap=2; fi
}

# native_shape — sets cap through cap_for, from each task's raw total
# (files+spec+coupling+risk, still 0-6), never the weighted routing score: the
# bands were drawn for the raw total.
native_shape() {
  local n _title ev max=-1 t
  while IFS=$'\t' read -r n _title; do
    [ -n "$n" ] || continue
    while IFS= read -r ev; do
      [ -n "$ev" ] || continue
      [[ "$ev" =~ files=([0-9]+),\ spec=([0-9]+),\ coupling=([0-9]+),\ risk=([0-9]+)\; ]] \
        || die "Task $n: the Evaluation line does not parse: $ev"
      t=$((10#${BASH_REMATCH[1]} + 10#${BASH_REMATCH[2]} + 10#${BASH_REMATCH[3]} + 10#${BASH_REMATCH[4]}))
      [ "$t" -le "$max" ] || max=$t
    done < <(plan_task_text "$src" "$n" | plan_eval_lines)
  done < <(plan_tasks "$src")
  cap_for "$max"
}

# native_rank MODEL EFFORT — the pair's execution rank in codex-routing.json,
# 10 (above every execution rank) for a reserve pair, nothing for any other.
native_rank() {
  jq -r --arg m "$1" --arg e "$2" '
    [.execution[] | select(.model == $m and .effort == $e) | .rank][0]
    // (if any(.reserve[]; .model == $m and .effort == $e) then 10 else empty end)' < "$ROUTING" | tr -d '\r'
}

native_pair() { # native_pair RANK — model/effort of an execution rank
  jq -r --argjson r "$1" '.execution[] | select(.rank == $r) | "\(.model)/\(.effort)"' < "$ROUTING" | tr -d '\r'
}

pairs_in() { # pairs_in TEXT — "model effort" for every native pair TEXT names
  grep -oE 'gpt-[a-z0-9.-]+ ?/ ?[a-z]+' <<<"$1" | sed -E 's# ?/ ?# #'
}

# agent_rank AGENT — reference/ladder.md §Why this terminates: model_rank * 10 +
# effort_rank. Nothing for a name that is not an implementer.
agent_rank() {
  local m e
  if [ "$1" = impl-haiku ]; then echo 0; return; fi
  [[ "$1" =~ ^impl-(sonnet|opus|fable)-(low|medium|high|xhigh|max)$ ]] || return 0
  case ${BASH_REMATCH[1]} in sonnet) m=1 ;; opus) m=2 ;; *) m=3 ;; esac
  case ${BASH_REMATCH[2]} in low) e=0 ;; medium) e=1 ;; high) e=2 ;; xhigh) e=3 ;; *) e=4 ;; esac
  echo $((m * 10 + e))
}

# task_files N — the paths every **Files:** block of task N names, backticks and
# a :line-range or :line-list suffix (b.txt:10-20, plan-lint:143,239) removed.
# A backticked path is taken whole, spaces included; a bare one ends at the
# first blank.
task_files() {
  plan_task_text "$src" "$1" | awk "$_PLAN_AWK"'
    in_fence($0) { on = 0; next }
    /^\*\*Files:\*\*/ { on = 1; next }
    on && /^- (Create|Modify|Test|Delete):/ {
      p = $0; sub(/^- (Create|Modify|Test|Delete):[ \t]*/, "", p)
      if (p ~ /^`[^`]+`/) { sub(/^`/, "", p); sub(/`.*$/, "", p) } else sub(/[ \t].*$/, "", p)
      sub(/:[0-9][0-9,-]*$/, "", p)
      print p; next
    }
    { on = 0 }
  '
}

# task_agents N — the implementer task N last ran on: the ledger's last assigned
# agent, escalation target or HANDBACK target, or else every **Implementer:**
# line of the task (one per part). Plugin prefixes are dropped. The inline
# marker "escalated inline -> subagent" names no agent, so only impl- targets
# count.
task_agents() {
  local agent=""
  [ -z "$ledger" ] || agent=$(tr -d '\r' < "$ledger" | awk -v p="Task $1: " '
    index($0, p) != 1 { next }
    match($0, /: implementer [^ ]+ \(assigned/) {
      s = substr($0, RSTART, RLENGTH); sub(/^: implementer /, "", s); sub(/ \(assigned$/, "", s); a = s
    }
    match($0, /(escalated [^ ]+ -> |HANDBACK to )[^ ;)]+/) {
      s = substr($0, RSTART, RLENGTH); sub(/^.* /, "", s); sub(/^.*:/, "", s)
      if (s ~ /^impl-/) a = s
    }
    END { sub(/^.*:/, "", a); if (a != "") print a }
  ')
  if [ -n "$agent" ]; then printf '%s\n' "$agent"; return; fi
  plan_task_text "$src" "$1" | sed -nE 's/^\*\*Implementer:\*\*[ \t]*`?([^` \t]+)`?.*/\1/p' | sed 's/^.*://'
}

# matched_tasks FILE... — the tasks whose Files blocks name one of FILE, comma
# separated.
matched_tasks() {
  local n _title files file hit tasks=""
  while IFS=$'\t' read -r n _title; do
    [ -n "$n" ] || continue
    files=$(task_files "$n")
    hit=0
    for file in "$@"; do
      file=${file#./}
      [[ "$file" =~ ^(.+):[0-9][0-9,-]*$ ]] && file=${BASH_REMATCH[1]}
      if grep -qxF -- "$file" <<<"$files"; then hit=1; break; fi
    done
    [ "$hit" -eq 0 ] || tasks="${tasks:+$tasks,}$n"
  done < <(plan_tasks "$src")
  printf '%s\n' "$tasks"
}

# final_fix FILE... — the fix wave takes the highest tier among the tasks whose
# Files blocks name the findings' paths, between impl-sonnet-high and
# impl-opus-high: the wave has no second wave and no escalation, so its tier
# follows the work it touches.
final_fix() {
  local execution m e rung="" n agents agent rank best=-1 tasks
  local models=(haiku sonnet opus fable) efforts=(low medium high xhigh max)
  ledger=$(plan_ledger "$plan")
  execution=$(plan_header_line "$src" Execution)
  if [[ "$execution" =~ claude\ --model\ ([a-z0-9.-]+)\ --effort\ ([a-z]+) ]]; then
    m=${BASH_REMATCH[1]} e=${BASH_REMATCH[2]}
    case $m in
      *haiku*) rung=impl-haiku ;;
      *sonnet*) rung=impl-sonnet-$e ;;
      *opus*) rung=impl-opus-$e ;;
      *fable*) rung=impl-fable-$e ;;
    esac
  fi
  tasks=$(matched_tasks "$@")
  for n in ${tasks//,/ }; do
    agents=$(task_agents "$n")
    while IFS= read -r agent; do
      [ "$agent" != inline ] || agent=$rung
      rank=$(agent_rank "$agent")
      [ -z "$rank" ] || [ "$rank" -le "$best" ] || best=$rank
    done <<<"$agents"
  done
  if [ -z "$tasks" ]; then
    printf 'review-seat final-fix primary=dforge:impl-sonnet-high fallback=- reason=floor\n'
    return
  fi
  [ "$best" -ge 12 ] || best=12
  [ "$best" -le 22 ] || best=22
  printf 'review-seat final-fix primary=dforge:%s fallback=- reason=tasks:%s\n' \
    "impl-${models[best / 10]}-${efforts[best % 10]}" "$tasks"
}

# native_task_pairs N — "model effort" for every native pair the ledger assigned
# task N: its implementer lines, escalations and handbacks, an inline implementer
# being the Execution line's pair. Without one, the task's **Implementer:** pairs.
native_task_pairs() {
  local lines="" segs
  [ -z "$ledger" ] || lines=$(tr -d '\r' < "$ledger" | awk -v p="Task $1: " 'index($0, p) == 1')
  # Only assignments: a complete line's seat clause names the reviewer's pair.
  segs=$(grep -oE ': implementer [^(]*\(assigned|escalated [^;)]*|HANDBACK to [^;)]*' <<<"$lines")
  if grep -qF ': implementer inline (assigned' <<<"$segs"; then
    segs+=$'\n'$(plan_header_line "$src" Execution)
  fi
  [ -n "$(pairs_in "$segs")" ] || segs=$(plan_task_text "$src" "$1" | plan_lines Implementer)
  pairs_in "$segs"
}

# final_fix_native FILE... — final_fix for a Host: codex plan: the highest native
# rank the ledger recorded among the matched tasks, between rank 5 (gpt-6.1-sol
# high, Acceptance QA's native seat and the impl-sonnet-high row) and the top
# execution rank. A reserve pair is capped there, as impl-opus-high caps one.
final_fix_native() {
  local tasks n m e rank best=-1 floor=5 top
  ledger=$(plan_ledger "$plan")
  top=$(jq '[.execution[].rank] | max' < "$ROUTING" | tr -d '\r')
  tasks=$(matched_tasks "$@")
  if [ -z "$tasks" ]; then
    printf 'review-seat final-fix primary=native:%s fallback=- reason=floor\n' "$(native_pair "$floor")"
    return
  fi
  for n in ${tasks//,/ }; do
    while read -r m e; do
      [ -n "$m" ] || continue
      rank=$(native_rank "$m" "$e")
      [ -z "$rank" ] || [ "$rank" -le "$best" ] || best=$rank
    done < <(native_task_pairs "$n")
  done
  [ "$best" -ge "$floor" ] || best=$floor
  [ "$best" -le "$top" ] || best=$top
  printf 'review-seat final-fix primary=native:%s fallback=- reason=tasks:%s\n' "$(native_pair "$best")" "$tasks"
}

case "$1" in
  --plan-round)
    [ $# -eq 2 ] && [[ "$2" =~ ^[1-9][0-9]*$ ]] || usage
    r=$2 claude=$OPUS
    # A Claude plan's cap follows its depth, never its totals, and it has no
    # cap-critical round: a round past the cap exits 2.
    if [ "$native" -eq 1 ]; then native_shape; else claude_cap; fi
    if [ "$native" -eq 0 ] && [ "$r" -gt "$cap" ]; then
      die "plan round $r is past the cap ($cap)"
    elif [ "$r" -gt $((cap + 1)) ]; then
      die "plan round $r is past the cap ($cap) and its one cap-critical round"
    elif [ "$native" -eq 1 ]; then
      # Every round takes the judge floor's pair; there is no external Codex round.
      judge=native:$(native_pair "$(jq '.role_floors.judge' < "$ROUTING" | tr -d '\r')")
      reason=round
      [ "$r" -le "$cap" ] || reason=cap-critical
      printf 'review-seat plan-round=%s primary=%s fallback=- reason=%s cap=%s\n' "$r" "$judge" "$reason" "$cap"
    elif [ "$r" -eq 1 ] && executor_session_on codex review; then
      printf 'review-seat plan-round=1 primary=codex:plan fallback=%s reason=round cap=%s\n' "$claude" "$cap"
    elif [ "$r" -eq 1 ]; then
      printf 'review-seat plan-round=1 primary=%s fallback=- reason=codex-off cap=%s\n' "$claude" "$cap"
    else
      printf 'review-seat plan-round=%s primary=%s fallback=- reason=round cap=%s\n' "$r" "$OPUS" "$cap"
    fi
    exit 0 ;;
  --ruling)
    shift
    [ $# -ge 1 ] || usage
    kinds=$1; shift
    [[ "$kinds" =~ ^[a-z-]+(,[a-z-]+)*$ ]] || die "not a ruling kind: $kinds"
    simple=1 residual=0 preflight=0
    for kind in ${kinds//,/ }; do
      case $kind in
        # executor-empty-diff is the neutral kind. codex-empty-diff is its
        # earlier name and stays accepted, but it is not canonicalised: the
        # printf below echoes $kinds, so rewriting it here would change an
        # existing caller's output.
        cannot-verify|executor-empty-diff|codex-empty-diff) ;;
        preflight) simple=0 preflight=1 ;;
        final-residual) simple=0 residual=1 ;;
        plan-conflict|breaker|blocked-plan|acceptance-ambiguous) simple=0 ;;
        *) die "not a ruling kind: $kind" ;;
      esac
    done
    plan_shape
    scores=$(plan_scores "$src")
    ids="" risky=0
    for id in "$@"; do
      [[ "$id" =~ ^([0-9]+)([A-Z]?)$ ]] || die "not a task id: $id"
      row=$(awk -F'\t' -v n="${BASH_REMATCH[1]}" '$1 == n' <<<"$scores")
      [ -n "$row" ] || die "no Task ${BASH_REMATCH[1]} in the plan"
      [ "$(cut -f3 <<<"$row")" != 3 ] || risky=1
      ids="${ids:+$ids,}$id"
    done
    # Only a list made wholly of the simple kinds, on no risk-3 task, leaves
    # Opus; the reason records why, for the ledger.
    seat=$OPUS
    if [ "$residual" -eq 1 ]; then reason=merge-gate
    elif [ "$risky" -eq 1 ]; then reason=risk
    elif [ "$simple" -eq 1 ]; then seat=$SONNET reason=simple-kind
    elif [ "$preflight" -eq 1 ] && [ "$intricate" -eq 1 ]; then reason=intricate
    else reason=routine
    fi
    printf 'review-seat ruling=%s tasks=%s primary=%s fallback=- reason=%s\n' "$kinds" "${ids:-plan}" "$seat" "$reason"
    exit 0 ;;
  --final)
    [ $# -eq 1 ] || usage
    plan_shape
    reason=plain
    [ "$intricate" -eq 0 ] || reason=intricate
    printf 'review-seat final primary=%s fallback=- reason=%s\n' "$OPUS" "$reason"
    exit 0 ;;
  --final-fix)
    shift
    [ $# -ge 1 ] || usage
    if [ "$native" -eq 1 ]; then final_fix_native "$@"; else final_fix "$@"; fi
    exit 0 ;;
  --task) shift; [ $# -ge 1 ] || usage ;;
  *) usage ;;
esac

max_total=-1 max_risk=-1 executor=0
for id in "$@"; do
  [[ "$id" =~ ^([0-9]+)([A-Z]?)$ ]] || die "not a task id: $id"
  n=${BASH_REMATCH[1]} part=${BASH_REMATCH[2]}
  text=$(plan_task_text "$src" "$n") || die "no Task $n in the plan"
  if [ -n "$part" ]; then
    text=$(plan_part_text "$part" <<<"$text")
    [ -n "$text" ] || die "no part $part in Task $n"
  fi
  [ -z "$(plan_lines Executor <<<"$text")" ] || executor=1
  evs=$(plan_eval_lines <<<"$text")
  if [ -z "$evs" ] && [ $# -eq 1 ]; then
    # An unscored task has no band to read, so it takes the strongest judge
    # alone, whatever the Codex gate or an Executor line says.
    printf 'review-seat task=%s primary=%s fallback=- review=task reason=unscored\n' "$id" "$OPUS"
    exit 0
  fi
  [ -n "$evs" ] || die "Task $id has no **Evaluation:** line"
  # A task without a part letter carries every part's Evaluation line, so it
  # routes on its heaviest part.
  while IFS= read -r ev; do
    [[ "$ev" =~ ^\*\*Evaluation:\*\*\ files\ [0-9]+$SEP"spec "[0-9]+$SEP"coupling "[0-9]+$SEP"risk "([0-9]+)\ =\ ([0-9]+) ]] \
      || die "Task $id: the Evaluation line does not parse: $ev"
    [ "${BASH_REMATCH[4]}" -le "$max_risk" ] || max_risk=${BASH_REMATCH[4]}
    [ "${BASH_REMATCH[5]}" -le "$max_total" ] || max_total=${BASH_REMATCH[5]}
  done <<<"$evs"
done

band() { # band <total> - the Claude judge for a score band
  if [ "$1" -le 5 ]; then echo "$SONNET"
  else echo "$OPUS"
  fi
}

# Executor first: a task Codex implemented is never reviewed by Codex, whatever
# its risk. Risk 3 (security, data loss, migration, concurrency) takes Opus
# whatever its total; every other task takes its band. The lane gate admits risk <= 1,
# so the executor risk-3 row is a guard.
if [ "$executor" -eq 1 ] && [ "$max_risk" -ge 3 ]; then
  primary=$OPUS fallback=- reason=executor
elif [ "$executor" -eq 1 ]; then
  primary=$(band "$max_total") fallback=- reason=executor
elif ! executor_session_on codex review; then
  # Codex is off for this session, so the Codex rows name their Claude seat
  # directly, and there is nothing left to fall back to. Risk 3 stays with Opus.
  if [ "$max_risk" -ge 3 ]; then primary=$OPUS; else primary=$(band "$max_total"); fi
  fallback=- reason=codex-off
elif [ "$max_risk" -ge 3 ]; then
  primary=codex:heavy+judge-opus fallback=$OPUS reason=risk
else
  # Below risk 3 every total takes the light row, gpt-6.1-sol; Astra is kept
  # for risk 3, plan review and the final round.
  primary=codex:light fallback=$(band "$max_total") reason=band
fi

# A single task carries its review tier; a batch is already one review, so it
# carries none.
tier=""
if [ $# -eq 1 ]; then
  tier=" review=group"
  if [ "$max_risk" -ge 2 ] || [ "$max_total" -ge 5 ]; then tier=" review=task"; fi
fi
printf 'review-seat task=%s primary=%s fallback=%s%s reason=%s\n' \
  "$(IFS=,; echo "$*")" "$primary" "$fallback" "$tier" "$reason"
