#!/usr/bin/env bash
# Run every open external reviewer family at once and report one status line
# per family.
#
# Families come from `scripts/executors ranked`. Each family's gate is read
# once; a family whose gate does not say review=true is skipped. Every open
# family's runner starts in the background, and a watchdog ends any runner
# still going at the bound, so one hung reviewer cannot hold the others' lists.
# In an auto run bound to this session in --cwd's checkout, a family whose
# runner failed on quota is recorded (auto-run review-skip, until the line's
# until= epoch, else 5 hours) and skipped as reason=quota-skip while that
# lasts. An agy quota on a claude-* row is not recorded: agy-gate then routes
# the family to its Gemini row, which has its own quota. In such a run each
# FAILED or TIMEOUT line, or a reason=denied one, adds to the run's
# panelFailures total.
#
# Usage: run-review-panel --kind task|plan|final [--tier heavy] --cwd DIR
#          --out-dir DIR (--prompt FILE | --base SHA)
#   Every kind takes the heavy rows, the only tier; --prompt goes with task
#   and plan, --base with final.
#   Each gate's stderr goes to <out-dir>/<id>.gate.log, each runner's to
#   <out-dir>/<id>.stderr. The panel's own stderr names its bound and the
#   second its watchdog fires.
# Output: one `<id>-judge ...` line per family in ranked order, then
#   `panel tier=<t> lists=<n>`, n counting OK and FALLBACK lines.
# Env seams: PANEL_<ID>_GATE, PANEL_<ID>_RUNNER, PANEL_LADDER, and
#   PANEL_BOUND_SECONDS, the seconds from panel start at which the watchdog
#   fires, in place of the computed bound, and PANEL_NO_SETSID, which runs
#   the runners as on a host without setsid.
# Exit: 0 answered, whatever the reviewers did; 2 usage error.
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
LADDER="${PANEL_LADDER:-$HERE/../reference/ladder.md}"

die() { printf 'run-review-panel: %s\n' "$1" >&2; exit 2; }

kind="" tier="" cwd="" out_dir="" prompt="" base=""
while [ $# -gt 0 ]; do
  case "$1" in
    --kind|--tier|--cwd|--out-dir|--prompt|--base) [ $# -ge 2 ] || die "$1 needs a value" ;;
  esac
  case "$1" in
    --kind) kind="$2"; shift 2 ;;
    --tier) tier="$2"; shift 2 ;;
    --cwd) cwd="$2"; shift 2 ;;
    --out-dir) out_dir="$2"; shift 2 ;;
    --prompt) prompt="$2"; shift 2 ;;
    --base) base="$2"; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done

case "$kind" in
  task|plan|final) ;;
  *) die "--kind must be task, plan or final" ;;
esac
case "$tier" in ""|heavy) tier=heavy ;; *) die "--tier must be heavy" ;; esac
if [ "$kind" = final ]; then
  [ -n "$base" ] || die "--kind final needs --base"
  [ -z "$prompt" ] || die "--kind final takes --base, not --prompt"
  ext=md
  src=(--base "$base")
else
  [ -n "$prompt" ] || die "--kind $kind needs --prompt"
  [ -z "$base" ] || die "--kind $kind takes --prompt, not --base"
  [ -r "$prompt" ] || die "--prompt is not readable: $prompt"
  ext=json
  src=(--prompt "$prompt")
fi
[ -n "$cwd" ] && [ -d "$cwd" ] || die "--cwd must be a directory"
[ -n "$out_dir" ] || die "--out-dir is required"
mkdir -p "$out_dir" || die "cannot create --out-dir: $out_dir"
out_dir="$(cd "$out_dir" && pwd)"
if [ -n "${PANEL_BOUND_SECONDS:-}" ]; then
  [[ $PANEL_BOUND_SECONDS =~ ^[0-9]+$ ]] || die "PANEL_BOUND_SECONDS must be a whole number"
fi

start=$(date +%s)
ids=$(bash "$HERE/executors" ranked) || die "the executor registry could not be read"

seam() { # seam <id> <GATE|RUNNER>; prints the override path, if any
  local var
  var="PANEL_$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')_$2"
  printf '%s' "${!var:-}"
}

field() { sed -n "s/.* $1=\\([^ ]*\\).*/\\1/p" <<<" $2"; }

# Ladder rows are `model effort seconds`; a run starts on the first row.
first_secs() { # first_secs <block>
  awk -v tag='```'"$1" '
    $0 == tag { f = 1; next }
    f && $0 == "```" { exit }
    f && NF { print $3; exit }
  ' "$LADDER"
}

open_ids=() lines_by_id=()
bound=0
for id in $ids; do
  if (cd "$cwd" && bash "$HERE/auto-run" review-skipped "$id") >/dev/null 2>&1; then
    rm -f "$out_dir/$id.$ext"
    lines_by_id+=("$id|$id-judge none/none status=SKIPPED exit=0 out=- evidence=none reason=quota-skip")
    continue
  fi
  gate=$(seam "$id" GATE)
  if [ -z "$gate" ]; then
    gate=$(bash "$HERE/executors" path "$id" gate) || gate=""
  fi
  line=""
  [ -n "$gate" ] && line=$(bash "$gate" 2> "$out_dir/$id.gate.log" | tail -1 | tr -d '\r')
  if [[ " $line " == *" review=true "* ]]; then
    block=$(bash "$HERE/executors" get "$id" blocks.judge 2>/dev/null) || block="$id-judge"
    secs=$(first_secs "$block")
    if ! [[ $secs =~ ^[0-9]+$ ]]; then
      printf 'run-review-panel: no seconds for the %s block in %s\n' "$block" "$LADDER" > "$out_dir/$id.stderr"
      rm -f "$out_dir/$id.$ext"
      lines_by_id+=("$id|$id-judge none/none status=FAILED exit=0 out=- evidence=none reason=error")
      continue
    fi
    open_ids+=("$id")
    case "$id" in agy) grace=70 ;; *) grace=60 ;; esac
    [ $((secs + grace)) -gt "$bound" ] && bound=$((secs + grace))
    continue
  fi
  if [ "$(field usable "$line")" = true ]; then
    if [ -z "${CLAUDE_CODE_SESSION_ID:-}" ]; then reason=no-session-id; else reason=untrusted; fi
  else
    reason=$(field reason "$line")
    [ -n "$reason" ] || reason=gate
  fi
  rm -f "$out_dir/$id.$ext"
  lines_by_id+=("$id|$id-judge none/none status=SKIPPED exit=0 out=- evidence=none reason=$reason")
done
# The bound equals the caller's timeout, counted from panel start, so the
# watchdog fires 15 s early: the TERM-to-KILL grace, the poll and the printing
# must all finish before the caller kills the panel and its lists with it.
bound=$((bound + 120))
deadline=$((start + bound - 15))
[ -z "${PANEL_BOUND_SECONDS:-}" ] || deadline=$((start + PANEL_BOUND_SECONDS))
printf 'run-review-panel: bound %s s, watchdog at %s s\n' "$bound" "$((deadline - start))" >&2

have_setsid=false
command -v setsid >/dev/null 2>&1 && have_setsid=true
[ -z "${PANEL_NO_SETSID:-}" ] || have_setsid=false

pids=()
# A runner under setsid leads its own process group, so the whole group can be
# signalled. setsid only forks when its caller already leads a group, which a
# background job of a non-interactive shell never does, so the pid is the pgid.
# Every descendant stop_runner signalled without setsid, so the last pass can
# kill whatever outlived both signals after its parent had already died.
tree_pids=()
stop_runner() { # stop_runner <pid> <signal>
  local pid=$1 sig=$2 level k i tree=()
  if [ "$have_setsid" = true ]; then
    kill "-$sig" -- "-$pid" 2>/dev/null
    return
  fi
  # Without setsid the whole tree is listed before any of it is signalled: a
  # process that dies is reaped and its children reparented, and pgrep -P no
  # longer reaches them. They are then signalled deepest first.
  if command -v pgrep >/dev/null 2>&1; then
    level=$(pgrep -P "$pid" 2>/dev/null)
    while [ -n "$level" ]; do
      for k in $level; do tree+=("$k"); done
      level=$(for k in $level; do pgrep -P "$k" 2>/dev/null; done)
    done
  fi
  for ((i = ${#tree[@]} - 1; i >= 0; i--)); do kill "-$sig" "${tree[$i]}" 2>/dev/null; done
  tree_pids+=(${tree[@]+"${tree[@]}"})
  kill "-$sig" "$pid" 2>/dev/null
}
stop_all() { local p; for p in ${pids[@]+"${pids[@]}"}; do [ -z "$p" ] || stop_runner "$p" TERM; done; }
trap 'stop_all; exit 130' INT TERM

for id in ${open_ids[@]+"${open_ids[@]}"}; do
  runner=$(seam "$id" RUNNER)
  if [ -z "$runner" ]; then
    runner=$(bash "$HERE/executors" path "$id" runner) || runner=""
  fi
  rm -f "$out_dir/$id.$ext" "$out_dir/$id.status" "$out_dir/$id.timeout"
  args=(--kind "$kind" --cwd "$cwd" --out "$out_dir/$id.$ext" "${src[@]}")
  [ "$kind" = task ] && args+=(--tier "$tier")
  if [ -z "$runner" ]; then
    printf 'run-review-panel: no runner registered for %s\n' "$id" > "$out_dir/$id.stderr"
    pids+=("")
    continue
  fi
  if [ "$have_setsid" = true ]; then
    setsid bash "$runner" "${args[@]}" > "$out_dir/$id.status" 2> "$out_dir/$id.stderr" < /dev/null &
  else
    bash "$runner" "${args[@]}" > "$out_dir/$id.status" 2> "$out_dir/$id.stderr" < /dev/null &
  fi
  pids+=("$!")
done

alive() { kill -0 "$1" 2>/dev/null; }
any_alive() { local p; for p in ${pids[@]+"${pids[@]}"}; do [ -n "$p" ] && alive "$p" && return 0; done; return 1; }

while any_alive && [ "$(date +%s)" -lt "$deadline" ]; do sleep 0.5; done
timed_out=false
if any_alive; then
  timed_out=true
  for i in "${!pids[@]}"; do
    p=${pids[$i]}
    [ -n "$p" ] && alive "$p" || continue
    : > "$out_dir/${open_ids[$i]}.timeout"
    stop_runner "$p" TERM
  done
  # A runner that traps TERM gets five seconds before KILL.
  kill_at=$(( $(date +%s) + 5 ))
  while any_alive && [ "$(date +%s)" -lt "$kill_at" ]; do sleep 0.5; done
  for p in ${pids[@]+"${pids[@]}"}; do [ -n "$p" ] && alive "$p" && stop_runner "$p" KILL; done
  for p in ${tree_pids[@]+"${tree_pids[@]}"}; do alive "$p" && kill -KILL "$p" 2>/dev/null; done
fi
rcs=()
for p in ${pids[@]+"${pids[@]}"}; do
  rc=1
  if [ -n "$p" ]; then wait "$p" 2>/dev/null; rc=$?; fi
  rcs+=("$rc")
done
trap - INT TERM
# Checked once the runners are reaped: until then a killed runner is a zombie
# that kill -0 still finds.
if [ "$timed_out" = true ]; then
  survivors=()
  for p in ${pids[@]+"${pids[@]}"} ${tree_pids[@]+"${tree_pids[@]}"}; do [ -n "$p" ] && alive "$p" && survivors+=("$p"); done
  [ ${#survivors[@]} -eq 0 ] || printf 'run-review-panel: still alive after KILL: %s\n' "${survivors[*]}" >&2
  if [ "$have_setsid" = false ] && ! command -v pgrep >/dev/null 2>&1; then
    echo "run-review-panel: neither setsid nor pgrep is on PATH, so a timed-out runner's own children were not found or stopped" >&2
  fi
fi

for i in "${!open_ids[@]}"; do
  id=${open_ids[$i]}
  out="$out_dir/$id.$ext"
  if [ -e "$out_dir/$id.timeout" ]; then
    rm -f "$out_dir/$id.timeout"
    line="$id-judge none/none status=TIMEOUT exit=124 out=$out evidence=none reason=timeout"
  else
    line=$(tail -1 "$out_dir/$id.status" 2>/dev/null | tr -d '\r')
    # A runner that died without its status line still gets a line, so the
    # family is never silently missing from the panel.
    if [[ "$line" != "$id-judge "*" status="* ]]; then
      line="$id-judge none/none status=FAILED exit=${rcs[$i]} out=$out evidence=none reason=error"
    fi
  fi
  # A runner can leave a partial or empty out file behind, and the judges read
  # any file that exists as that reviewer's list.
  case "$line" in *" status=OK "*|*" status=FALLBACK "*) ;; *) rm -f "$out" ;; esac
  if [ "$(field reason "$line")" = quota ]; then
    model=$(awk '{ print $2 }' <<<"$line")
    if [ "$id" != agy ] || [[ "${model%%/*}" != claude-* ]]; then
      until=$(field until "$line")
      [[ $until =~ ^[0-9]+$ ]] || until=""
      (cd "$cwd" && bash "$HERE/auto-run" review-skip "$id" ${until:+--until "$until"}) >/dev/null 2>&1 || true
    fi
  fi
  lines_by_id+=("$id|$line")
done

lists=0 failures=0
for id in $ids; do
  for entry in ${lines_by_id[@]+"${lines_by_id[@]}"}; do
    [ "${entry%%|*}" = "$id" ] || continue
    line=${entry#*|}
    printf '%s\n' "$line"
    case "$line" in *" status=OK "*|*" status=FALLBACK "*) lists=$((lists + 1)) ;; esac
    case "$line" in *" status=FAILED "*|*" status=TIMEOUT "*|*" reason=denied"*) failures=$((failures + 1)) ;; esac
  done
done
if [ "$failures" -gt 0 ] && (cd "$cwd" && bash "$HERE/auto-run" pending) >/dev/null 2>&1; then
  for _ in $(seq "$failures"); do
    (cd "$cwd" && bash "$HERE/auto-run" total panelFailures) >/dev/null 2>&1 || true
  done
fi
printf 'panel tier=%s lists=%s\n' "$tier" "$lists"
