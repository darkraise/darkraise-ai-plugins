#!/usr/bin/env bash
# The finish action your human partner chose before execution started: what
# dforge:finishing-a-development-branch carries out, with no menu, as soon as
# the final review is clean (`wait` asks for the menu instead). The choice is
# asked once, before the first task, so a finished run never stops to ask.
#
# One JSON file holds it: `<workspace>/finish.json` beside a plan's ledger, or
# `.dforge/sdd/finish.json` for work done without a plan. Both are
# git-ignored; the cockpit Run card reads the file to show the choice.
#
# Usage: finish-choice <command> [--plan PLAN_FILE] [args]
#   set ACTION [--base BRANCH]  record the choice: merge | pr | keep | wait
#   get                         print the file; exit 3 when nothing is chosen.
#                               With nothing chosen, record first the plan's
#                               spec's `Finish:` line in ## Decisions (with
#                               --plan), else the finishAction setting when it
#                               is anything but ask.
#   answer ACTION               record that finishing acted on the choice, or
#                               that the menu was answered (merge | pr | keep |
#                               discard); an answered choice is never re-run.
#                               With nothing recorded, it creates the record.
#   clear                       forget the choice
#
# FINISH_CHOICE_NOW (epoch seconds) stands in for the clock in tests.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/dforge-dir.sh"
. "$HERE/lib/dforge-env.sh"
. "$HERE/lib/plan.sh"
. "$HERE/lib/lock.sh"

usage() { sed -n '/^# Usage:/,/^# FINISH_CHOICE_NOW/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
command -v jq >/dev/null 2>&1 || { echo "finish-choice needs jq" >&2; exit 2; }
[ $# -ge 1 ] || usage
cmd=$1; shift

plan=""
args=()
while [ $# -gt 0 ]; do
  case $1 in
    --plan) [ $# -ge 2 ] || usage; plan=$2; shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

if [ -n "$plan" ]; then
  dir=$(bash "$HERE/sdd-workspace" "$plan")
else
  root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "not inside a git repository" >&2; exit 2; }
  dir="$(dforge_dir state "$root")/sdd"
  mkdir -p "$dir"
  dforge_self_ignore "$dir"
fi
file="$dir/finish.json"
now=${FINISH_CHOICE_NOW:-$(date +%s)}

valid_action() {
  case $1 in merge|pr|keep|wait) return 0 ;; *) return 1 ;; esac
}
# write <jq filter> [jq args...]: replace the file with the filter's output
# over the current record ({} when it is empty). A temporary file and a rename,
# so a reader such as the cockpit never sees it truncated or half-written.
write() {
  local filter=$1 current='{}' tmp
  shift
  [ -s "$file" ] && current=$(cat "$file")
  tmp=$(mktemp "$file.XXXXXX") || return 1
  if jq "$@" "$filter" <<<"$current" > "$tmp" && mv -f "$tmp" "$file"; then return 0; fi
  rm -f "$tmp"
  return 1
}
need_file() { [ -s "$file" ] || { echo "no finish action chosen" >&2; exit 3; }; }
# With nothing chosen, the finishAction setting stands in for the answer
# (anything but ask). It is recorded like an answer, so the run keeps one
# choice even if the setting changes while it runs; the base branch is left
# for finishing to determine. It runs under the record's lock, so the empty
# test and the write see the same record.
from_setting() {
  [ ! -s "$file" ] || return 0
  local action
  action=$(dforge_setting finishAction ask)
  valid_action "$action" || return 0
  write '{action: $action, base: null, chosenAt: $now, source: "setting"}' \
    -n --arg action "$action" --argjson now "$now"
}

# The spec review records its answer as a `Finish: <merge|pr|keep>` line in the
# spec's ## Decisions; a list marker may precede it. Fenced lines, other
# sections and any other value are not read. With nothing chosen it stands in
# for the answer, ahead of the setting: the owner gave it for this plan. awk
# reads to the end after a match: an early exit would end tr with SIGPIPE,
# which pipefail turns into this script's exit.
spec_finish() { # spec_finish SPEC_FILE — the line's action, or nothing
  tr -d '\r' < "$1" | awk "$_PLAN_AWK"'
    in_fence($0) { next }
    /^## / { inside = ($0 ~ /^## Decisions[ \t]*$/); next }
    found { next }
    inside && $0 ~ /^([-*]|[0-9]+\.)?[ \t]*Finish:[ \t]*(merge|pr|keep)[ \t]*$/ {
      v = $0
      sub(/^([-*]|[0-9]+\.)?[ \t]*Finish:[ \t]*/, "", v)
      sub(/[ \t]+$/, "", v)
      print v
      found = 1
    }
  '
}
from_spec() {
  [ -n "$plan" ] && [ ! -s "$file" ] || return 0
  local located name spec action
  located=$(plan_locate "$plan")
  [ -f "$located" ] || return 0
  name=$(plan_header_line "$located" Spec | sed -E 's/^\*\*Spec:\*\*[ \t]*(`([^`]+)`|([^ \t]+)).*/\2\3/')
  [ -n "$name" ] || return 0
  spec=$(dforge_resolve "$name") || return 0
  [ -f "$spec" ] || return 0
  action=$(spec_finish "$spec")
  [ -n "$action" ] || return 0
  write '{action: $action, base: null, chosenAt: $now, source: "spec"}' \
    -n --arg action "$action" --argjson now "$now"
}

choose() { # choose ACTION BASE
  write '{action: $action, base: (if $base == "" then null else $base end), chosenAt: $now}' \
    -n --arg action "$1" --arg base "$2" --argjson now "$now" || return 1
  cat "$file"
}
show() {
  from_spec || return
  from_setting || return
  need_file
  cat "$file"
}
record_answer() { # record_answer ACTION
  if [ -s "$file" ]; then
    write '.answer = $answer | .answeredAt = $now' --arg answer "$1" --argjson now "$now"
  else
    write '{action: $answer, base: null, chosenAt: $now, source: "answer", answer: $answer, answeredAt: $now}' \
      -n --arg answer "$1" --argjson now "$now"
  fi
}

# The arguments are checked first; then the command runs under the record's
# lock, so two sessions on one record never interleave a read and a write.
case $cmd in
  set)
    [ $# -ge 1 ] && valid_action "$1" || { echo "set takes one of: merge pr keep wait" >&2; exit 2; }
    action=$1; shift
    base=""
    if [ $# -ge 2 ] && [ "$1" = "--base" ]; then base=$2; shift 2; fi
    [ $# -eq 0 ] || usage
    body=(choose "$action" "$base")
    ;;
  get)
    [ $# -eq 0 ] || usage
    body=(show)
    ;;
  answer)
    [ $# -eq 1 ] || usage
    case $1 in merge|pr|keep|discard) ;; *) echo "answer takes one of: merge pr keep discard" >&2; exit 2 ;; esac
    body=(record_answer "$1")
    ;;
  clear)
    [ $# -eq 0 ] || usage
    body=(rm -f "$file")
    ;;
  *) usage ;;
esac
lock=$(dr_lock_base "$file") || { echo "finish-choice: cannot name the lock for $file" >&2; exit 1; }
status=0
dr_locked "$lock" "${body[@]}" || status=$?
exit "$status"
