#!/usr/bin/env bash
# Stand-in for the Antigravity CLI. STUB_AGY_* variables choose what it does;
# STUB_AGY_ERROR must not contain a double quote or a backslash; STUB_AGY_TEXT
# is printed as it is; git-run evals STUB_AGY_GIT in the worktree.
set -u

if [ -n "${STUB_AGY_ARGS_LOG:-}" ]; then
  { for arg in "$@"; do printf '%s\n' "$arg"; done; printf '%s\n' '--'; } >> "$STUB_AGY_ARGS_LOG"
fi

if [ "${1:-}" = --version ]; then
  printf '%s\n' "${STUB_AGY_VERSION:-1.4.12}"
  exit 0
fi

if [ "${1:-}" = models ]; then
  case "${STUB_AGY_AUTH:-ok}" in
    logged-out) printf 'Please sign in: run agy to log in\n' >&2; exit 1 ;;
    broken) exit 3 ;;
  esac
  printf 'Fetching available models...\n'
  printf 'gemini-3.8-flash-medium\tGemini 3.8 Flash (Medium)\n'
  printf 'claude-sonnet-5-5-medium\tClaude Sonnet 5.5 (Medium)\n'
  exit 0
fi

print_mode=no
for arg in "$@"; do [ "$arg" = -p ] && print_mode=yes; done
[ "$print_mode" = yes ] || { printf 'stub-agy: unsupported call\n' >&2; exit 64; }

conv="${STUB_AGY_CONV:-conv-1}"
write_file() { printf 'stub\n' > "${STUB_AGY_WRITE:-out.txt}"; }
structured() { # structured <status> [questions as a JSON array]
  printf '{"status":"%s","summary":"stub summary","commit_subject":"feat(stub): add out","questions":%s,"discovered_issues":[],"assumptions":[]}' "$1" "${2:-[]}"
}
emit() { # emit <structured_output status | none> [questions as a JSON array]
  if [ "$1" = none ]; then
    printf '{"conversation_id":"%s","status":"SUCCESS","response":"ok","usage":{"total_tokens":10}}\n' "$conv"
  else
    printf '{"conversation_id":"%s","status":"SUCCESS","response":"ok","structured_output":%s,"usage":{"total_tokens":10}}\n' \
      "$conv" "$(structured "$1" "${2:-[]}")"
  fi
}

model=""; prev=""
for arg in "$@"; do [ "$prev" = --model ] && model="$arg"; [ "$prev" = --json-schema ] && [ -n "${STUB_AGY_SCHEMA_COPY:-}" ] && cp "$arg" "$STUB_AGY_SCHEMA_COPY"; prev="$arg"; done
if [ -n "${STUB_AGY_REFUSE_MODEL:-}" ] && [ "$model" = "$STUB_AGY_REFUSE_MODEL" ]; then
  printf '{"conversation_id":"","status":"ERROR","response":"","error":"unknown model: %s","finished_reason":"error"}\n' "$model"
  exit 1
fi
side() {
  case "${STUB_AGY_SIDE:-}" in
    write) write_file ;;
    commit) write_file; git add -A && git commit -qm stub ;;
    stash) write_file; git stash -q -u ;;
    modify) printf 'changed\n' >> tracked.txt ;;
    delete) rm -f tracked.txt ;;
    hook) mkdir -p "$(git rev-parse --git-path hooks)" && printf "${STUB_AGY_HOOK:-#!/bin/sh\\n}" > "$(git rev-parse --git-path hooks)/pre-commit" ;;
    hook-link) mkdir -p "$(git rev-parse --git-path hooks)" && ln -s "$PWD/tracked.txt" "$(git rev-parse --git-path hooks)/post-checkout" ;;
    config) git config dforge.stub yes ;;
    global) git config --global dforge.stub yes ;;
  esac
}
review_json() { printf '{"spec":%s,"scope":18,"verification":18,"quality":18,"spec_verdict":"%s","task_quality":"approved","findings":[%s],"cannot_verify":[]}' "${STUB_AGY_SCORE:-18}" "${STUB_AGY_VERDICT:-compliant}" "${STUB_AGY_FINDING:-}"; }

case "${STUB_AGY_MODE:-done}" in
  done) write_file; emit DONE ;;
  blocked) emit BLOCKED ;;
  needs-context) emit NEEDS_CONTEXT '["Which file holds the setting?"]' ;;
  no-schema) write_file; emit none ;;
  error)
    printf '{"conversation_id":"","status":"ERROR","response":"","error":"%s","finished_reason":"error"}\n' \
      "${STUB_AGY_ERROR:-something failed}"
    exit 1 ;;
  text) printf '%s\n' "${STUB_AGY_TEXT:-something failed}"; exit 1 ;;
  print-timeout)
    printf '{"conversation_id":"conv-1","status":"SUCCESS","response":"","finished_reason":"print_timeout"}\n'
    printf '[agy] print timeout after 5s with turn in progress; returning partial output\n' >&2 ;;
  hang) sleep 300 & sleep 300 ;;
  git-commit) write_file; git add -A && git commit -qm stub; emit DONE ;;
  git-stash) write_file; git stash -q -u; emit DONE ;;
  git-branch) write_file; git branch stub-branch; emit DONE ;;
  git-run) write_file; eval "$STUB_AGY_GIT"; emit DONE ;;
  outside-write) write_file; printf 'stub\n' > "$STUB_AGY_OUTSIDE"; emit DONE ;;
  review) side; printf '{"conversation_id":"c","status":"SUCCESS","response":"ok","structured_output":%s}\n' "$(review_json)" ;;
  plan-review) side; printf '{"conversation_id":"c","status":"SUCCESS","response":"ok","structured_output":{"executability":18,"coherence":18,"coverage":18,"assumptions":18,"findings":[]}}\n' ;;
  final-review) side; printf '{"conversation_id":"c","status":"SUCCESS","response":"ok","structured_output":{"review":%s}}\n' "${STUB_AGY_REVIEW_JSON:-\"No findings.\"}" ;;
  stderr-quota) printf '{"conversation_id":"","status":"ERROR","response":"","error":"","finished_reason":"error"}\n'; printf '429 Too Many Requests\n' >&2; exit 1 ;;
  *) printf 'stub-agy: unknown STUB_AGY_MODE\n' >&2; exit 64 ;;
esac
