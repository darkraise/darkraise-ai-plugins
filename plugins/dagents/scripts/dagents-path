#!/usr/bin/env bash
# dagents-path state [RELATIVE] | docs [RELATIVE] | ledger SLUG|PLAN_FILE | latest | handoff MODE-ARGS… | handoffs | name PATH
# Where this repository's dagents files live, all in the checkout: the state
# directory (.dagents/), the docs root, a plan's ledger directory and
# latest.md, the handoff a next-step call with the same mode arguments would
# write (`next-step --target`), every handoff file of every checkout, or the
# repository-relative name of a path.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/lib/roots.sh"
usage() { echo "usage: dagents-path state|docs [RELATIVE] | ledger SLUG|PLAN_FILE | latest | handoff MODE-ARGS… | handoffs | name PATH" >&2; exit 2; }
[ $# -ge 1 ] || usage
[ "$1" = state ] || dagents_stores_init
case $1 in
  state)
    [ $# -le 2 ] || usage
    dir=$(dagents_dir state "$(git rev-parse --show-toplevel 2>/dev/null || pwd)") || exit 2
    ;;
  docs) [ $# -le 2 ] || usage; dir=$(dagents_docs_root) ;;
  ledger)
    [ $# -eq 2 ] || usage
    # A plan path names the same ledger as its basename (sdd-workspace's rule).
    slug=${2//\\//}
    case $slug in */* | *.md) slug=$(basename "$slug" .md) ;; esac
    dagents_ledger_dir "$slug"
    exit 0
    ;;
  latest) [ $# -eq 1 ] || usage; dagents_latest_file; exit 0 ;;
  handoff) shift; bash "$HERE/next-step" --target "$@"; exit $? ;;
  handoffs) [ $# -eq 1 ] || usage; dagents_handoff_files; exit 0 ;;
  name) [ $# -eq 2 ] || usage; dagents_name "$2"; exit 0 ;;
  *) usage ;;
esac
if [ $# -eq 2 ]; then printf '%s/%s\n' "$dir" "$2"; else printf '%s\n' "$dir"; fi
