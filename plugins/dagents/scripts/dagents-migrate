#!/usr/bin/env bash
# dagents-migrate [--dry-run] [DIR] — move a repository from the older names
# to dagents', which reads only its own: dr-superpowers' (before 3.0),
# dr-forge's (3.x) and dforge 4.x's. For the repository at DIR (default: the
# working directory), its primary checkout and every linked worktree:
#   .dforge/, .superpowers/, .forge/          -> .dagents/      (plain rename)
#   docs/dforge/, docs/superpowers/ or docs/forge/ -> docs/dagents/ (git mv when tracked)
#   <git dir>/dforge/, <git dir>/dr-superpowers/, <git dir>/dr-forge/ -> <git dir>/dagents/
# then, once every move has succeeded, the lines of .gitignore, .gitattributes
# and the shared info/exclude that name an older directory; a line naming
# .dforge or docs/dforge is kept and gains its dagents twin, since dforge may
# still run in another checkout of the project. An active plan (one the
# completed.md beside it does not record) and the checkout's handoff note have
# their dr-superpowers:, dr-forge: and dforge: prefixes rewritten to dagents:,
# so they keep running, and every rewrite of a tracked file is staged. No other
# file's content changes: finished plans, specs, ledgers and registers keep
# the citations dagents translates when it reads them, and each other tracked
# file that names dforge is listed on a report: line. Last,
# scripts/lib/dagents-home-migrate.mjs moves the home (~/.dr-forge/ ->
# ~/.dagents/) when it is installed, and copies the dforge 4.x settings
# dagents defines; it lists the DFORGE_* and DR_* variables to rename. dagents
# keeps nothing in darkmem: no darkmem setting is carried over, and darkmem
# data is never moved, copied or deleted. Then every checkout's
# handoff/latest.md is renamed to the key its next-step marker gives
# (parallel-session handoff spec §8): the basename of the plan or draft its
# subject names, else adhoc-legacy-<marker at, else mtime>. An existing
# <key>.md is never overwritten: the pair is refused and latest.md stays. A
# later run moves a latest.md an older plugin writes after this one.
#
# dagents-migrate --legacy-handoffs writes nothing: it prints one
# "<path>\t<subject>" line per latest.md still in a checkout, which session
# start and repo-audit name as an older layout; <subject> is the marker's
# subject when it is a plain .md path, else -.
#
# A checkout holding an older state directory and .dagents/ is merged file by
# file: a file or empty directory only the old one has moves, an identical
# file is dropped, and a file that differs is refused and left. A checkout
# holding two docs trees, or an older docs tree with uncommitted changes, is
# refused and left as it is, and its plans are not rewritten. The rest still
# moves, and a second run finishes the job once the refusal is resolved. A
# checkout that was refused keeps its old ignore lines and gains the new ones
# beside them, so a moved directory is never left un-ignored.
#
# --dry-run writes nothing, in the checkouts or the homes: each line says what
# would move or be rewritten, and each refusal the files and git can foretell
# is printed. It treats a directory an earlier line would create as absent, so
# a second source into it is listed as a move rather than a merge.
#
# A project with an active dforge 5 plan (a docs/dforge plan with a task and
# no **Implementer:** line), or one a dforge run still holds (a lock under
# <git common dir>/dforge/locks/ owned by a live process on this host, or an
# auto run bound to a live session), is refused before anything moves, as is
# one whose documents or progress an older home keeps in darkmem
# (~/.dforge/stores.json's record for it, or any record in
# ~/.dr-forge/stores.json or ~/.dr-superpowers/stores.json): the refusal says
# to set that family back to local in dforge first.
#
# Exit: 0 done or nothing to do; 1 something was (or, dry, would be) refused;
# 2 usage or not inside a git repository.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/lib/native-path.sh"
. "$HERE/lib/dagents-dir.sh"
. "$HERE/lib/roots.sh"

usage() { echo "usage: dagents-migrate [--dry-run] [DIR] | dagents-migrate --legacy-handoffs" >&2; exit 2; }
dry=0 legacy_only=0
case ${1:-} in
  --dry-run) dry=1; shift ;;
  --legacy-handoffs) [ $# -eq 1 ] || usage; legacy_only=1; shift ;;
esac
[ $# -le 1 ] || usage
dir=${1:-$PWD}

if command -v timeout >/dev/null 2>&1; then g() { timeout 60 git "$@"; }; else g() { git "$@"; }; fi

root=$(g -C "$dir" rev-parse --show-toplevel 2>/dev/null) \
  || { echo "dagents-migrate: $dir is not inside a git repository" >&2; exit 2; }
common=$(g -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
  || { echo "dagents-migrate: cannot read the git directory of $root" >&2; exit 2; }

refused=0 moved=0 checkout_refused=0 docs_ok=1 docs_at=""
checkouts=()
clean=()
commit_notes=()
# In a dry run, each path a line says would move.
dry_moves=()

refuse() { printf 'dagents-migrate: refused: %s\n' "$1" >&2; refused=1; checkout_refused=1; }
done_move() {
  if [ "$dry" -eq 1 ]; then printf 'would move %s -> %s\n' "$1" "$2"; dry_moves+=("$1"); else printf 'moved %s -> %s\n' "$1" "$2"; fi
  moved=1
}

# would_move PATH — a dry run's line said PATH, or a directory holding it,
# would move.
would_move() {
  local from
  for from in "${dry_moves[@]+"${dry_moves[@]}"}"; do
    case $1 in "$from" | "$from"/*) return 0 ;; esac
  done
  return 1
}

# same_entry A B — whether two files, or two symlinks, hold the same thing.
same_entry() {
  if [ -L "$1" ] || [ -L "$2" ]; then
    [ -L "$1" ] && [ -L "$2" ] && [ "$(readlink -- "$1")" = "$(readlink -- "$2")" ]
  else
    [ -f "$1" ] && [ -f "$2" ] && cmp -s -- "$1" "$2"
  fi
}

# merge_into FROM TO — FROM's files into the existing directory TO: a file or
# empty directory TO lacks moves, an identical file is dropped, a differing
# one is refused and left.
merge_into() {
  local from=$1 to=$2 file rel conflicts=0 touched=0 dir_conflicts=0 listed=0
  if [ "$dry" -eq 1 ]; then
    while IFS= read -r -d '' file; do
      rel=${file#"$from"/}
      listed=1
      if [ ! -e "$to/$rel" ] && [ ! -L "$to/$rel" ]; then printf 'would move %s -> %s\n' "$file" "$to/$rel"; moved=1; dry_moves+=("$file")
      elif same_entry "$file" "$to/$rel"; then printf 'would drop %s, the same as %s\n' "$file" "$to/$rel"; moved=1
      else refuse "$file differs from $to/$rel; keep one by hand, then run dagents-migrate again"; fi
    done < <(find "$from" \( -type f -o -type l \) -print0)
    while IFS= read -r -d '' file; do
      rel=${file#"$from"/}
      if [ ! -e "$to/$rel" ] && [ ! -L "$to/$rel" ]; then printf 'would move %s -> %s\n' "$file" "$to/$rel"; moved=1 listed=1
      elif [ ! -d "$to/$rel" ]; then refuse "$file is a directory and $to/$rel is not; keep one by hand, then run dagents-migrate again"; listed=1; fi
    done < <(find "$from" -mindepth 1 -type d -empty -print0)
    # FROM holds nothing, or only directories TO already has: the real run
    # removes it and says it moved, so the dry run says so too.
    if [ "$listed" -eq 0 ] && [ -z "$(find "$from" -mindepth 1 ! -type d -print -quit 2>/dev/null)" ]; then done_move "$from" "$to"; fi
    return 0
  fi
  while IFS= read -r -d '' file; do
    rel=${file#"$from"/}
    if [ ! -e "$to/$rel" ] && [ ! -L "$to/$rel" ]; then
      if mkdir -p -- "$(dirname -- "$to/$rel")" && mv -- "$file" "$to/$rel"; then touched=1
      else refuse "could not move $file into $to"; conflicts=1; fi
    elif same_entry "$file" "$to/$rel"; then
      rm -f -- "$file" && touched=1
    else
      refuse "$file differs from $to/$rel; keep one by hand, then run dagents-migrate again"
      conflicts=1
    fi
  done < <(find "$from" \( -type f -o -type l \) -print0)
  # An empty directory can be a mkdir lock (<git dir>/dagents/run.lock), so
  # one TO lacks is made there before FROM's empty directories go.
  while IFS= read -r -d '' file; do
    rel=${file#"$from"/}
    [ ! -d "$to/$rel" ] || continue
    if [ ! -e "$to/$rel" ] && [ ! -L "$to/$rel" ] && mkdir -p -- "$to/$rel" 2>/dev/null; then touched=1
    else refuse "$file is a directory and $to/$rel is not; keep one by hand, then run dagents-migrate again"; conflicts=1 dir_conflicts=1; fi
  done < <(find "$from" -mindepth 1 -type d -empty -print0)
  [ "$dir_conflicts" -eq 1 ] || find "$from" -depth -type d -empty -delete 2>/dev/null
  if [ "$conflicts" -eq 0 ] && [ -e "$from" ]; then refuse "$from still holds entries that are not files; move them by hand, then run dagents-migrate again"; fi
  if [ ! -e "$from" ]; then done_move "$from" "$to"; elif [ "$touched" -eq 1 ]; then moved=1; fi
}

# dir_link_in DIR — DIR is or holds a symbolic link, so a merge into it could
# land outside the checkout: even a dangling link can resolve once the merge
# creates the directory it names. A search that fails part way counts as
# finding one: a link can sit where find could not look.
dir_link_in() {
  local found
  [ ! -L "$1" ] || return 0
  found=$(find "$1" -mindepth 1 -type l -print -quit 2>/dev/null) || return 0
  [ -z "$found" ] || return 0
  return 1
}

# mv_plain FROM TO — the rename; merged file by file when both exist. Status
# 1 when it refused outright; merge_into's per-file refusals leave it 0. A
# dangling link is present: as FROM it is refused, as TO it meets the link
# guard.
mv_plain() {
  [ -e "$1" ] || [ -L "$1" ] || return 0
  if [ ! -e "$1" ]; then refuse "$1 is a symbolic link to nothing; remove or fix it by hand, then run dagents-migrate again"; return 1; fi
  if [ -L "$(dirname -- "$1")" ] || [ -L "$(dirname -- "$2")" ]; then refuse "$1 or $2 lies in a linked directory; move it by hand, then run dagents-migrate again"; return 1; fi
  if [ -e "$2" ] || [ -L "$2" ]; then
    if [ -L "$1" ] || dir_link_in "$2"; then refuse "$1 or $2 is or holds a symbolic link; merge them by hand, then run dagents-migrate again"; return 1; fi
    if [ -d "$1" ] && [ -d "$2" ]; then merge_into "$1" "$2"; else refuse "$1 and $2 both exist and are not both directories; merge them by hand, then run dagents-migrate again"; return 1; fi
    return 0
  fi
  if [ "$dry" -eq 1 ] || mv -- "$1" "$2"; then done_move "$1" "$2"; else refuse "could not rename $1"; return 1; fi
}

# docs_trees CHECKOUT — each docs tree the checkout holds, one per line.
docs_trees() {
  local name
  for name in dforge superpowers forge dagents; do [ ! -e "$1/docs/$name" ] || printf '%s\n' "$1/docs/$name"; done
}

# migrate_docs CHECKOUT — the one docs tree to docs/dagents/. Sets docs_ok to 0
# when it refused, and docs_at to where the plans are once it is done: the new
# tree, or in a dry run the tree that would move.
migrate_docs() {
  local wt=$1 trees name old new="$1/docs/dagents" listed changes
  docs_ok=1 docs_at=""
  trees=$(docs_trees "$wt")
  [ -n "$trees" ] || return 0
  if [ "$(wc -l <<<"$trees")" -gt 1 ]; then
    refuse "$(paste -sd, - <<<"$trees" | sed 's/,/ and /g') all exist; merge them by hand, then run dagents-migrate again"
    docs_ok=0
    return 0
  fi
  docs_at=$new
  [ "$trees" != "$new" ] || return 0
  old=$trees name=${trees##*/}
  [ "$dry" -eq 0 ] || docs_at=$old
  # Read whole and checked: an empty answer from a git that failed would
  # read as untracked, or as clean.
  if ! listed=$(g -C "$wt" ls-files -- "docs/$name") \
    || ! changes=$(g --no-optional-locks -C "$wt" status --porcelain --untracked-files=all -- "docs/$name"); then
    refuse "could not read the git status of docs/$name in $wt"
    docs_ok=0
    return 0
  fi
  if [ -z "$listed" ]; then mv_plain "$old" "$new" || docs_ok=0; return 0; fi
  if [ -n "$changes" ]; then
    refuse "$old has uncommitted changes; commit or stash them, then run dagents-migrate again"
    docs_ok=0
    return 0
  fi
  if [ "$dry" -eq 1 ] || g -C "$wt" mv "docs/$name" docs/dagents; then
    done_move "$old" "$new"
    commit_notes+=("$wt: the staged rename docs/$name/ -> docs/dagents/")
  else
    refuse "git mv docs/$name docs/dagents failed in $wt"
    docs_ok=0
  fi
}

OLDER_NAMES_RE='(^|[/![:space:]])\.(superpowers|forge)([/[:space:]*]|$)|docs/(superpowers|forge)([/[:space:]*]|$)'
DFORGE_NAMES_RE='(^|[/![:space:]])\.dforge([/[:space:]*]|$)|docs/dforge([/[:space:]*]|$)'

# renamed_lines FILE MODE — what rewrite_names would leave in FILE. A line
# naming .dforge or docs/dforge always takes MODE add. A directory name starts
# a line or follows /, ! or whitespace: *.forge names files by extension and
# stays.
renamed_lines() {
  sed -E -e 's#(^|[/![:space:]])\.(superpowers|forge)([/[:space:]*]|$)#\1.dagents\3#g' \
         -e 's#docs/(superpowers|forge)([/[:space:]*]|$)#docs/dagents\2#g' "$1" \
    | awk -v mode="$2" '
      FILENAME == ARGV[1] { old[FNR] = $0; have[$0] = 1; n = FNR; next }
      FILENAME == ARGV[2] { twin[FNR] = $0; next }
      { new[FNR] = $0 }
      END {
        for (i = 1; i <= n; i++) {
          if (old[i] == new[i]) {
            print old[i]
            if (old[i] != twin[i] && old[i] !~ /^[[:space:]]*#/ && !(twin[i] in have)) { print twin[i]; have[twin[i]] = 1 }
            continue
          }
          if (mode == "add") {
            print old[i]
            if (old[i] !~ /^[[:space:]]*#/ && !(new[i] in have)) { print new[i]; have[new[i]] = 1 }
          } else if (!(new[i] in have)) { print new[i]; have[new[i]] = 1 }
        }
      }' "$1" <(sed -E -e 's#(^|[/![:space:]])\.dforge([/[:space:]*]|$)#\1.dagents\2#g' \
                       -e 's#docs/dforge([/[:space:]*]|$)#docs/dagents\1#g' "$1") -
}

# temp_beside FILE — a new temporary file beside FILE holding its bytes and
# mode, printed. mktemp creates the name exclusively, so a link planted at it
# is never written through; a rewrite written there is renamed over FILE in
# one step, so a kill leaves FILE whole, with its old text or its new.
temp_beside() {
  local tmp
  tmp=$(mktemp "$1.dagents-migrate.XXXXXX") || return 1
  cp -p -- "$1" "$tmp" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
  printf '%s\n' "$tmp"
}

# rewrite_names FILE MODE — the ignore and attribute lines that name an
# older directory. MODE replace renames them in place, dropping a renamed
# line the file already holds; MODE add keeps each line and puts the renamed
# one after it, skipping comments and lines already present. Status 1 when
# there is nothing to rewrite, 2 when the rewrite failed.
rewrite_names() {
  local file=$1 mode=$2 tmp
  [ -f "$file" ] && [ ! -L "$file" ] || return 1
  grep -qE "$OLDER_NAMES_RE|$DFORGE_NAMES_RE" "$file" || return 1
  if [ "$dry" -eq 1 ]; then
    # Piped into cmp, a failed rewrite would read as a difference; the real
    # run refuses it, so the dry run foretells that instead of listing it.
    renamed_lines "$file" "$mode" > /dev/null || return 2
    ! renamed_lines "$file" "$mode" | cmp -s -- - "$file" || return 1
    printf 'would rewrite the older names in %s\n' "$file"
    moved=1
    return 0
  fi
  tmp=$(temp_beside "$file") || return 2
  if ! renamed_lines "$file" "$mode" > "$tmp"; then rm -f -- "$tmp"; return 2; fi
  if cmp -s -- "$tmp" "$file"; then rm -f -- "$tmp"; return 1; fi
  mv -f -- "$tmp" "$file" || { rm -f -- "$tmp"; return 2; }
  printf 'rewrote the older names in %s\n' "$file"
  moved=1
}

# writable CHECKOUT FILE — FILE is no symbolic link and lies inside CHECKOUT
# once links are resolved: a cloned repository controls these names, so a
# rewrite must never land outside it.
writable() {
  local top real
  [ ! -L "$2" ] || return 1
  top=$(cd "$1" 2>/dev/null && pwd -P) && real=$(cd "$(dirname -- "$2")" 2>/dev/null && pwd -P) || return 1
  case $real/ in "$top"/*) return 0 ;; *) return 1 ;; esac
}

PREFIX_RE='(^|[^A-Za-z0-9_-])(dr-(superpowers|forge)|dforge):([a-z])'
# prefixes_renamed FILE — FILE with the older plugin prefixes outside fenced
# code blocks rewritten as dagents's own. A fence is quoted text, never rewritten.
prefixes_renamed() {
  # Git for Windows' gawk drops each carriage return unless BINMODE says
  # binary; any other awk takes it as a plain variable.
  awk -v BINMODE=3 '
    function rename(line,   out, prev) {
      out = ""
      while (match(line, /(dr-(superpowers|forge)|dforge):[a-z]/)) {
        prev = RSTART > 1 ? substr(line, RSTART - 1, 1) : substr(out, length(out), 1)
        if (prev == "" || prev !~ /[A-Za-z0-9_-]/) {
          out = out substr(line, 1, RSTART - 1) "dagents:"
          line = substr(line, RSTART + RLENGTH - 1)
        } else {
          out = out substr(line, 1, RSTART)
          line = substr(line, RSTART + 1)
        }
      }
      return out line
    }
    fence == "" && match($0, /^ ? ? ?(```+|~~~+)/) {
      opener = substr($0, RSTART, RLENGTH); sub(/^ +/, "", opener)
      # A backtick fence takes no backtick in its info string: ```x``` is a code span.
      if (!(substr(opener, 1, 1) == "`" && substr($0, RSTART + RLENGTH) ~ /`/)) { fence = opener; print; next }
    }
    fence == "" { print rename($0); next }
    match($0, /^ ? ? ?(```+|~~~+)[ \t\r]*$/) {
      f = $0; sub(/^ +/, "", f); sub(/[ \t\r]+$/, "", f)
      if (substr(f, 1, 1) == substr(fence, 1, 1) && length(f) >= length(fence)) fence = ""
    }
    { print }
  ' "$1"
}

# rewrite_prefixes FILE CHECKOUT — the older plugin prefixes before a skill or
# agent name, as dagents's own. Status 1 when FILE names none outside a fenced
# block, or is not writable in CHECKOUT.
rewrite_prefixes() {
  local file=$1 tmp
  writable "$2" "$file" || return 1
  grep -qE "$PREFIX_RE" "$file" 2>/dev/null || return 1
  if [ "$dry" -eq 1 ]; then
    if ! prefixes_renamed "$file" > /dev/null; then refuse "could not rewrite the plugin prefixes in $file"; return 1; fi
    ! prefixes_renamed "$file" | cmp -s -- - "$file" || return 1
    printf 'would rewrite the plugin prefixes in %s\n' "$file"
    moved=1
    return 0
  fi
  tmp=$(temp_beside "$file") || { refuse "could not rewrite the plugin prefixes in $file"; return 1; }
  if ! prefixes_renamed "$file" > "$tmp"; then
    rm -f -- "$tmp"
    refuse "could not rewrite the plugin prefixes in $file"
    return 1
  fi
  # Every prefix sat inside a fenced block: nothing to rewrite.
  if cmp -s -- "$tmp" "$file"; then
    rm -f -- "$tmp"
    return 1
  fi
  if mv -f -- "$tmp" "$file"; then
    printf 'rewrote the plugin prefixes in %s\n' "$file"
    moved=1
    return 0
  fi
  rm -f -- "$tmp"
  refuse "could not rewrite the plugin prefixes in $file"
  return 1
}

# plan_done DOCS REL — the completed.md beside the plan DOCS/REL records it,
# under any of the four docs spellings, as next-step's plan_finished reads it.
plan_done() {
  local f="$1/$(dirname -- "$2")/completed.md" spelling
  [ -f "$f" ] || return 1
  for spelling in dagents dforge forge superpowers; do
    grep -qF "\`docs/$spelling/$2\`" "$f" && return 0
  done
  return 1
}

# rewrite_active_plans CHECKOUT DOCS — every plan under DOCS/plans/ that is
# still active, and the checkout's handoff note.
rewrite_active_plans() {
  local wt=$1 docs=$2 plan rel state note
  if [ -n "$docs" ] && [ -d "$docs/plans" ]; then
    while IFS= read -r -d '' plan; do
      rel=${plan#"$docs"/}
      [ "${rel##*/}" != completed.md ] || continue
      plan_done "$docs" "$rel" && continue
      if rewrite_prefixes "$plan" "$wt" && g -C "$wt" ls-files --error-unmatch -- "${docs#"$wt"/}/$rel" >/dev/null 2>&1; then
        stage "$wt" "${docs#"$wt"/}/$rel"
        commit_notes+=("$wt: docs/dagents/$rel")
      fi
    done < <(find "$docs/plans" -type f -name '*.md' -print0)
  fi
  # A real run rewrites only .dagents/'s note: one still under an old state
  # directory was left there by a refused merge. A dry run moved nothing, so
  # it also lists an old directory's note that a line above would move.
  [ ! -f "$wt/.dagents/handoff/latest.md" ] || rewrite_prefixes "$wt/.dagents/handoff/latest.md" "$wt" || true
  [ "$dry" -eq 1 ] || return 0
  for state in .dforge .forge .superpowers; do
    note="$wt/$state/handoff/latest.md"
    [ ! -f "$note" ] || ! would_move "$note" || rewrite_prefixes "$note" "$wt" || true
  done
}

# stage CHECKOUT REL — a real run stages its rewrite of the tracked file REL,
# so a moved and rewritten plan shows as one rename.
stage() {
  [ "$dry" -eq 0 ] || return 0
  g -C "$1" add -- "$2" || refuse "git add $2 failed in $1; stage it by hand"
}

# dforge_live CHECKOUT — what of a dforge run still holds the project: a lock
# directory under the common git dir's dforge/locks/ whose host is this one
# and whose pid runs, or the checkout's auto run, bound to a session whose
# cockpit beat within three minutes or, with no beat, whose transcript was
# written within the hour (dforge 4.x's own stale rules). Status 1 when none.
dforge_live() {
  local lock pid host state sid beat file
  for lock in "$common"/dforge/locks/*/; do
    [ -d "$lock" ] || continue
    pid=$(tr -dc '0-9' 2>/dev/null < "$lock/pid") host=$(tr -d '\r\n' 2>/dev/null < "$lock/host")
    [ -n "$pid" ] && [ "$host" = "$(uname -n)" ] || continue
    if kill -0 "$pid" 2>/dev/null || ps -p "$pid" >/dev/null 2>&1; then printf 'the lock %s\n' "${lock%/}"; return 0; fi
  done
  state="$1/.dforge/sdd/auto-run.json"
  [ -f "$state" ] || return 1
  if ! command -v jq >/dev/null 2>&1; then
    grep -qE '"active"[[:space:]]*:[[:space:]]*true' "$state" || return 1
    printf 'the auto run in %s (jq is not on PATH to read its session)\n' "$state"
    return 0
  fi
  if ! sid=$(jq -r 'select(.active == true) | .session // empty' < "$state" 2>/dev/null); then
    printf 'the auto run in %s, which jq could not read\n' "$state"
    return 0
  fi
  sid=$(tr -d '\r' <<<"$sid")
  [ -n "$sid" ] || return 1
  file="${HOME:-}/.claude/dforge/sessions/cockpit/$(printf '%s' "$sid" | tr -c 'A-Za-z0-9' '-')"
  if [ -f "$file" ]; then
    beat=$(head -n 1 "$file" | tr -dc '0-9')
    [ -n "$beat" ] && [ $(( $(date +%s) - beat )) -le 180 ] || return 1
  else
    [ -n "$(find "${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}"/projects/*/"$sid".jsonl -mmin -60 2>/dev/null | head -n 1)" ] || return 1
  fi
  printf 'the auto run of session %s\n' "$sid"
}

# report_dforge CHECKOUT — note each tracked file outside the docs tree, the
# state directories and the ignore files that still names dforge, under its
# repository path, for one report: line per path however many checkouts hold
# it. Migrate leaves their text as it is.
reported_paths=()
reported_in=()
report_dforge() {
  local file i listed status
  listed=$(g -C "$1" grep -I -l -E -e 'docs/dforge|(^|[^A-Za-z0-9_-])\.dforge|(^|[^A-Za-z0-9_-])dforge:[a-z]' -- . \
    ':(exclude)docs/dagents' ':(exclude)docs/dforge' ':(exclude).dagents' ':(exclude).dforge' ':(exclude).gitignore' ':(exclude).gitattributes' 2>/dev/null)
  status=$?
  # 1 is "no match"; anything else means the search did not finish.
  if [ "$status" -gt 1 ]; then
    printf 'report: %s could not be searched for files that name dforge (git grep exited %s)\n' "$1" "$status"
    return 0
  fi
  [ "$status" -eq 0 ] || return 0
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    for i in "${!reported_paths[@]}"; do [ "${reported_paths[$i]}" != "$file" ] || break; done
    if [ "${#reported_paths[@]}" -gt 0 ] && [ "${reported_paths[$i]}" = "$file" ]; then reported_in[$i]="${reported_in[$i]}, $1"
    else reported_paths+=("$file"); reported_in+=("$1"); fi
  done <<<"$listed"
}

# legacy_handoffs — every checkout's latest.md, named here rather than
# through roots' handoff listing, which stops listing latest.md once every
# reader is keyed. It runs in a subshell: roots.sh exits on a settings error,
# which must not end a migration part-way.
legacy_handoffs() {
  (
    dagents_stores_init "$root" || exit 2
    while IFS= read -r wt; do
      f="$(dagents_dir state "$(_dagents_path "$wt")")/handoff/latest.md"
      if [ -f "$f" ] || [ -L "$f" ]; then printf '%s\n' "$f"; fi
    done < <(g -C "$root" worktree list --porcelain 2>/dev/null | tr -d '\r' | sed -n 's/^worktree //p')
  )
}

# marker_of FILE — FILE's last next-step marker line, or nothing.
marker_of() { grep -a '^<!-- next-step: ' -- "$1" 2>/dev/null | tr -d '\r' | grep ' -->$' | tail -n 1; }
subject_of() { sed -n 's/.* subject=\(.*\) at=-\{0,1\}[0-9][0-9]* -->$/\1/p' <<<"$1"; }

# older_spellings FILE — FILE, a latest.md, then the path it had under each
# older state directory, one per line: an older plugin wrote the handoff
# there, naming itself by that path.
older_spellings() {
  local f=$1 base
  printf '%s\n' "$f"
  case $f in
    */.dagents/handoff/latest.md)
      base=${f%/.dagents/handoff/latest.md}
      printf '%s\n' "$base/.dforge/handoff/latest.md" "$base/.forge/handoff/latest.md" "$base/.superpowers/handoff/latest.md" ;;
  esac
}

# rewrite_moved FILE OLD — FILE, a handoff just renamed from OLD (paths, one
# per line), made to name itself: each OLD in its text becomes FILE, and a
# first prompt without a claim step gets the one next-step writes now. A
# draft, adhoc or kept handoff's stored block is replayed as it stands, so
# its prompt would otherwise send the next session to OLD with nothing to
# claim.
rewrite_moved() {
  local file=$1 old=$2 key clause="" tmp
  key=${file##*/}; key=${key%.md}
  case " $(marker_of "$file") " in
    *" host=codex "*) case $key in adhoc-*) clause="When you hand off, pass \`--key $key\` to next-step. " ;; esac ;;
    *) clause="Before anything else, claim it with dagents' \`scripts/handoff claim\` on that file. " ;;
  esac
  tmp=$(mktemp "$file.dagents-migrate.XXXXXX") || return 1
  OLD=$old NEW=$file CLAUSE=$clause awk '
    BEGIN { n = split(ENVIRON["OLD"], olds, "\n") }
    {
      for (k = 1; k <= n; k++) {
        if (olds[k] == "") continue
        out = ""; s = $0
        while ((i = index(s, olds[k])) > 0) { out = out substr(s, 1, i - 1) ENVIRON["NEW"]; s = substr(s, i + length(olds[k])) }
        $0 = out s
      }
    }
    /^Start in `/ && ENVIRON["CLAUSE"] != "" && index($0, "scripts/handoff claim") == 0 && index($0, "--key ") == 0 {
      i = index($0, "enter it first. ")
      if (i > 0) $0 = substr($0, 1, i + 15) ENVIRON["CLAUSE"] substr($0, i + 16)
    }
    { print }' "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  if cmp -s "$tmp" "$file"; then rm -f "$tmp"; else mv -- "$tmp" "$file"; fi
}

# migrate_latest FILE [AS] — FILE (a latest.md) renamed to the key its marker
# gives, as next-step keys a handoff: the plan's or draft's basename from its
# subject, else adhoc-legacy-<marker at, else mtime>. AS, in a dry run, is the
# path FILE takes once its state directory moves; the lines name it.
migrate_latest() {
  local f=$1 as=${2:-$1} m kind subject at key target word
  m=$(marker_of "$f")
  kind=""
  # Words are read by name (C9), never by position; set -f keeps them unglobbed.
  set -f
  for word in ${m%% subject=*}; do case $word in kind=*) kind=${word#kind=} ;; esac; done
  set +f
  subject=$(subject_of "$m")
  at=$(sed -n 's/.* at=\(-\{0,1\}[0-9][0-9]*\) -->$/\1/p' <<<"$m")
  key=""
  if [ -n "$subject" ] && [ "$subject" != - ]; then
    key=${subject//\\//}; key=${key##*/}; key=${key%.md}
    [ "$kind" = draft ] || kind=plan
    if [[ ! $key =~ ^[A-Za-z0-9._-]+$ ]] || ! dagents_handoff_key_check "$kind" "$key"; then
      printf 'dagents-migrate: %s names %s, which is no usable handoff key; migrated as unplanned\n' "$as" "$subject"
      key=""
    fi
  fi
  if [ -z "$key" ]; then
    [ -n "$at" ] || at=$(stat -c %Y -- "$f" 2>/dev/null || stat -f %m -- "$f" 2>/dev/null) \
      || { refuse "could not read the modification time of $f"; return; }
    key="adhoc-legacy-$at"
  fi
  target=${as%/*}/$key.md
  # FILE is <checkout>/<state>/handoff/latest.md: nothing is renamed through
  # a link out of its checkout.
  if ! writable "${f%/*/*/*}" "$f"; then
    refuse "$f is reached through a symbolic link; rename it to $key.md by hand"
  elif [ -e "$target" ] || [ -L "$target" ] \
    || { [ "$as" != "$f" ] && { [ -e "${f%/*}/$key.md" ] || [ -L "${f%/*}/$key.md" ]; }; }; then
    refuse "$as is the handoff for $key, and $target already exists; keep one by hand, then run dagents-migrate again"
  # A hard link fails on an existing name, so a <key>.md another session
  # writes after the test above is never replaced, as mv would replace it.
  elif [ "$dry" -eq 0 ] && ! ln -- "$f" "$target" 2>/dev/null; then
    if [ -e "$target" ] || [ -L "$target" ]; then
      refuse "$as is the handoff for $key, and $target already exists; keep one by hand, then run dagents-migrate again"
    else
      refuse "could not move $f to $target"
    fi
  elif [ "$dry" -eq 0 ] && ! rm -f -- "$f"; then
    refuse "could not remove $f once it was linked to $target; remove it by hand"
  else
    done_move "$as" "$target"
    [ "$dry" -eq 1 ] || rewrite_moved "$target" "$(older_spellings "$f")" \
      || printf 'dagents-migrate: %s could not be rewritten to name itself; its first prompt still names %s\n' "$target" "$f"
  fi
}

if [ "$legacy_only" -eq 1 ]; then
  legacy=$(legacy_handoffs) || exit 2
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    subject=$(subject_of "$(marker_of "$f")")
    # Session start puts the line in the model's context: a subject that is
    # not a plain .md path, which a repository file could fake, is withheld.
    [[ $subject =~ ^[A-Za-z0-9._/-]+\.md$ ]] && [ "${#subject}" -le 200 ] || subject=-
    printf '%s\t%s\n' "$f" "$subject"
  done <<<"$legacy"
  exit 0
fi

while IFS= read -r wt; do
  [ -n "$wt" ] && [ -d "$wt" ] && checkouts+=("$wt")
done < <(g -C "$root" worktree list --porcelain 2>/dev/null | tr -d '\r' | sed -n 's/^worktree //p')
[ ${#checkouts[@]} -gt 0 ] || checkouts=("$root")

# A dforge 5 plan, or a dforge run still holding the project, stops the whole
# run before anything moves.
blocked=0 dforge_found=()
for wt in "${checkouts[@]}"; do
  if plan5=$(dagents_dforge5_plan "$wt"); then refuse "dforge 5 layout: not migratable ($plan5)"; blocked=1; fi
  if holder=$(dforge_live "$wt"); then refuse "a dforge run still holds $wt ($holder); let it finish or stop it, then run dagents-migrate again"; blocked=1; fi
  found=0
  gitdir=$(g -C "$wt" rev-parse --absolute-git-dir 2>/dev/null) || gitdir=""
  if [ -e "$wt/.dforge" ] || [ -e "$wt/docs/dforge" ] || { [ -n "$gitdir" ] && [ -e "$gitdir/dforge" ]; }; then found=1; fi
  dforge_found+=("$found")
done
if [ -f "$HERE/lib/dagents-home-migrate.mjs" ]; then
  if command -v node >/dev/null 2>&1; then
    held=$(cd "$root" && node "$(dr_native_path "$HERE/lib/dagents-home-migrate.mjs")" --check)
    case $? in
      0) ;;
      1)
        while IFS= read -r line; do
          case $line in 'dagents-home-migrate: refused: '*) refuse "${line#dagents-home-migrate: refused: }" ;; esac
        done <<<"$held"
        blocked=1 ;;
      *)
        [ -z "$held" ] || printf '%s\n' "$held"
        refuse "scripts/lib/dagents-home-migrate.mjs did not finish its darkmem check; see its output above"
        blocked=1 ;;
    esac
  else
    for stores in "${HOME:-}/.dr-forge/stores.json" "${HOME:-}/.dr-superpowers/stores.json" "${HOME:-}/.dforge/stores.json"; do
      if grep -qs '"darkmem"' "$stores"; then
        refuse "node is not on PATH, so whether $stores keeps a family of this repository in darkmem cannot be read; install node, then run dagents-migrate again"
        blocked=1
      fi
    done
  fi
fi
[ "$blocked" -eq 0 ] || exit 1

for wt in "${checkouts[@]}"; do
  checkout_refused=0
  for old in .dforge .superpowers .forge; do
    tracked=0
    if [ -e "$wt/$old" ] && [ -n "$(g -C "$wt" ls-files -- "$old" | head -n 1)" ]; then tracked=1; fi
    mv_plain "$wt/$old" "$wt/.dagents"
    if [ "$tracked" -eq 1 ] && [ ! -e "$wt/$old" ] && [ ! -L "$wt/$old" ]; then
      commit_notes+=("$wt: the rename $old/ -> .dagents/ (git add -A $old .dagents)")
    fi
  done
  migrate_docs "$wt"
  [ "$docs_ok" -eq 0 ] || rewrite_active_plans "$wt" "$docs_at"
  if gitdir=$(g -C "$wt" rev-parse --absolute-git-dir 2>/dev/null); then
    for old in dforge dr-superpowers dr-forge; do mv_plain "$gitdir/$old" "$gitdir/dagents"; done
  else
    refuse "cannot read the git directory of $wt"
  fi
  clean+=("$checkout_refused")
done

# A checkout that moved completely has its lines renamed; one that was refused
# keeps the old line and gains the new one, so nothing it moved is exposed.
# The shared info/exclude is renamed only when every checkout moved.
for i in "${!checkouts[@]}"; do
  wt=${checkouts[$i]} mode=replace
  [ "${clean[$i]}" -eq 0 ] || mode=add
  for name in .gitignore .gitattributes; do
    rewrite_names "$wt/$name" "$mode"; status=$?
    if [ "$status" -eq 2 ]; then
      refuse "could not rewrite the older names in $wt/$name"
    elif [ "$status" -eq 0 ] && g -C "$wt" ls-files --error-unmatch -- "$name" >/dev/null 2>&1; then
      stage "$wt" "$name"
      commit_notes+=("$wt: $name")
    fi
  done
  [ "${dforge_found[$i]}" -eq 0 ] || report_dforge "$wt"
done
mode=replace
[ "$refused" -eq 0 ] || mode=add
rewrite_names "$common/info/exclude" "$mode"
[ $? -ne 2 ] || refuse "could not rewrite the older names in $common/info/exclude"

if [ -f "$HERE/lib/dagents-home-migrate.mjs" ]; then
  if ! command -v node >/dev/null 2>&1; then
    if [ -e "${HOME:-}/.dr-forge" ] || [ -e "${HOME:-}/.dforge/config.json" ]; then
      refuse "node is not on PATH, so the homes (~/.dr-forge/, ~/.dforge/) were not migrated"
    fi
  else
    home_args=()
    [ "$dry" -eq 0 ] || home_args=(--dry-run)
    for found in "${dforge_found[@]+"${dforge_found[@]}"}"; do
      [ "$found" -eq 0 ] || { home_args+=(--dforge-layout); break; }
    done
    home_out=$(cd "$root" && node "$(dr_native_path "$HERE/lib/dagents-home-migrate.mjs")" "${home_args[@]+"${home_args[@]}"}")
    home_status=$?
    if [ -n "$home_out" ]; then
      printf '%s\n' "$home_out"
      # Refusals, the variables to rename and what stays for darkmem are no
      # action; the "left ... in place" note prints on every run while
      # ~/.dr-forge keeps its mirror or stores.json.
      if grep -qvE '^dagents-home-migrate: (refused: |left .* in place; |[A-Z0-9_]+ is set in .*; dagents reads )' <<<"$home_out"; then moved=1; fi
    fi
    if [ "$home_status" -ne 0 ]; then
      # A dry run's refusals are foretold, not a failure to finish; a non-zero
      # exit with no refused: line is a crash in either mode.
      if [ "$dry" -eq 1 ] && grep -q '^dagents-home-migrate: refused: ' <<<"$home_out"; then
        refuse "foretold refusals in the home; see above"
      else
        refuse "scripts/lib/dagents-home-migrate.mjs did not finish; see its output above"
      fi
    fi
  fi
fi

# After the home moved, so the settings are read from ~/.dagents.
if legacy=$(legacy_handoffs); then
  while IFS= read -r f; do
    [ -z "$f" ] || migrate_latest "$f"
  done <<<"$legacy"
else
  refuse "the handoff files could not be listed, so no latest.md was renamed; run dagents-migrate again once dagents-config reads the settings"
fi

# A dry run moved no state directory: an older one's latest.md is listed at
# the path the state move gives it.
if [ "$dry" -eq 1 ]; then
  for wt in "${checkouts[@]}"; do
    [ ! -e "$wt/.dagents/handoff/latest.md" ] && [ ! -L "$wt/.dagents/handoff/latest.md" ] || continue
    for old in .dforge .superpowers .forge; do
      note="$wt/$old/handoff/latest.md"
      if [ -f "$note" ] && would_move "$note"; then migrate_latest "$note" "$wt/.dagents/handoff/latest.md"; break; fi
    done
  done
fi

for i in "${!reported_paths[@]}"; do
  printf 'report: %s names dforge (docs/dforge, .dforge or a dforge: prefix) in %s; dagents left it as it is\n' "${reported_paths[$i]}" "${reported_in[$i]}"
done
[ "$dry" -eq 1 ] || for note in "${commit_notes[@]+"${commit_notes[@]}"}"; do printf 'commit: %s\n' "$note"; done
[ "$moved" -eq 1 ] || [ "$refused" -eq 1 ] || echo "dagents-migrate: nothing to migrate in $root"
exit "$refused"
