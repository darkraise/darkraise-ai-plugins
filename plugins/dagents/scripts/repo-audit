#!/usr/bin/env bash
# Print an orientation snapshot for a session that picks up work, so it costs
# one command instead of the five to eight a fresh session otherwise spends on
# git status, logs, worktrees, ledgers and the handoff files. It deletes the
# handoffs whose recompute finds nothing left to resume (see ## Handoff) and
# writes nothing else.
#
# Usage: repo-audit
# Exit: 0 ok; 2 usage or not inside a git repository.
set -uo pipefail

[ $# -eq 0 ] || { echo "usage: repo-audit" >&2; exit 2; }
here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib/plan.sh"
. "$here/lib/roadmap.sh"
. "$here/lib/lock.sh"
. "$here/lib/session-live.sh"

root=$(git rev-parse --show-toplevel 2>/dev/null) \
  || { echo "repo-audit: not inside a git repository" >&2; exit 2; }
primary=$(plan_primary_root "$root")
dagents_stores_init "$root"

branch=$(git symbolic-ref --short -q HEAD || echo "(detached)")
head=$(git log -1 --format='%h %s' 2>/dev/null || echo "(no commits)")
tracking=""
if up=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
  read -r ahead behind < <(git rev-list --left-right --count "HEAD...$up")
  tracking=" — $ahead ahead, $behind behind \`$up\`"
fi

echo "# Repo audit"
echo
echo "- Root: \`$root\`"
[ "$root" = "$primary" ] || echo "- Primary checkout: \`$primary\`"
echo "- Branch: \`$branch\` at $head$tracking"
echo "- $("$here/context-size" 2>/dev/null)"
legacy=$( { dagents_legacy_layout "$root"; [ "$root" = "$primary" ] || dagents_legacy_layout "$primary"; } | sort -u | paste -sd, - | sed 's/,/, /g')
[ -z "$legacy" ] || echo "- dagents: this repository still uses an older layout ($legacy); run the dagents:migrate skill (/dagents:migrate)"
(cd "$root" && bash "$here/dagents-migrate" --legacy-handoffs 2>/dev/null) | tr -d '\r' | while IFS=$'\t' read -r lh_path lh_subject; do
  [ -z "$lh_path" ] || echo "- dagents: $lh_path is a handoff in an older layout (subject $lh_subject); run the dagents:migrate skill (/dagents:migrate)"
done
if dagents_dforge4_layout "$root" || { [ "$root" != "$primary" ] && dagents_dforge4_layout "$primary"; }; then
  echo "- dagents: dforge 4.x layout found (docs/dforge or .dforge); run the dagents:migrate skill (/dagents:migrate) to move it to dagents' names"
fi

echo
echo "## Worktrees"
git worktree list --porcelain | tr -d '\r' | awk '
  /^worktree / { if (line != "") print line; line = "- `" substr($0, 10) "`"; next }
  /^HEAD /     { line = line " " substr($0, 6, 7); next }
  /^branch /   { b = substr($0, 8); sub(/^refs\/heads\//, "", b); line = line " [" b "]"; next }
  /^detached/  { line = line " (detached)"; next }
  /^prunable/  { line = line " — prunable"; next }
  END { if (line != "") print line }
'

dirty=$(git status --short)
count=$(printf '%s' "$dirty" | grep -c . || true)
echo
echo "## Dirty files ($count)"
[ "$count" -eq 0 ] || printf '%s\n' "$dirty" | head -n 20 | sed 's/^/    /'

echo
echo "## Plans in flight"
found=0
while IFS=$'\t' read -r ledger wt; do
  [ -n "$ledger" ] || continue
  found=1
  plan_rel=$(ledger_plan "$ledger")
  place="\`$wt\`" base=$wt
  total="?"
  if [ -n "$plan_rel" ]; then
    plan_file=$(dagents_resolve "$plan_rel" "$base")
    [ ! -f "$plan_file" ] || total=$(plan_tasks "$plan_file" | grep -c . || true)
    [ "$total" != 0 ] || [ -z "$(plan_lettered "$plan_file")" ] || total="?"
  fi
  done_n=$(ledger_done "$ledger" | grep -c . || true)
  last=$(tr -d '\r' < "$ledger" | grep -v '^[[:space:]]*$' | tail -n 1 | cut -c1-160)
  has_handoff=no
  [ -f "$(dirname "$ledger")/handoff.md" ] && has_handoff=yes
  echo "- \`${plan_rel:-unknown plan}\` in $place: $done_n of $total tasks complete; handoff.md: $has_handoff"
  echo "  - last ledger line: $last"
done < <(dagents_ledger_files "$root")
[ "$found" -eq 1 ] || echo "- none"

echo
echo "## Item registers"
reg_found=0
while IFS= read -r reg_file; do
  [ -n "$reg_file" ] || continue
  reg_found=1
  reg_rel=$(dagents_name "$reg_file")
  reg_total=$(register_rows "$reg_file" | grep -c . || true)
  reg_open=$(register_open "$reg_file" | grep -c . || true)
  reg_verify=$(register_open "$reg_file" | awk -F'\t' '$5 == "verify"' | grep -c . || true)
  echo "- \`$reg_rel\` — $reg_open open ($reg_verify awaiting your check) of $reg_total rows"
done < <(register_files "$root")
[ "$reg_found" -eq 1 ] || echo "- none"

echo
echo "## Roadmap"
if [ -n "$(roadmap_file "$root")" ]; then
  bash "$here/roadmap" status --root "$root" 2>/dev/null | sed 's/^/- /'
else
  echo "- none"
fi

echo
echo "## Handoff"
# Every handoff of every checkout (scripts/handoff list), this
# session's own first: the newest one it claims or whose marker names it. The
# stored lines are a claim about the repository at writing time, so this
# session's handoff and every plan, draft, complete or kept one are recomputed
# from their own checkout. A recompute that
# finds nothing left to resume (exit 6) deletes the handoff, unless a live
# session other than this one claims it; adhoc handoffs are only listed.
sid=${CLAUDE_CODE_SESSION_ID:-}
claims="$(dagents_dir state "$(dr_native_path "$primary")")/handoff/claims"
listed=0 stale=""

claim_session() { [ -f "$claims/$1" ] && tr -d '\r' < "$claims/$1" | sed -n 's/^session=//p' | head -n 1; }

marker_session() { # FILE — the session= word of FILE's marker, read by name
  local m word words
  m=$(tr -d '\r' < "$1" | grep -E '^<!-- next-step: .* -->$' | tail -n 1) || return 0
  m=${m#<!-- next-step: }
  read -ra words <<<"${m%% subject=*}"
  for word in "${words[@]}"; do
    case $word in session=*) printf '%s\n' "${word#session=}"; return 0 ;; esac
  done
}

handoff_checkout() { # FILE — the checkout whose next-step recomputes FILE
  local dir top
  dir=$(_dagents_path "$(dirname "$1")")
  top=$(git -C "$(dr_native_path "$dir")" rev-parse --show-toplevel 2>/dev/null | tr -d '\r')
  [ -n "$top" ] || return 1
  _dagents_path "$top"
}

mtime_of() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }
# A whole-second mtime misses a rewrite in the second it was read; the
# checksum catches that one.
digest_of() { printf '%s ' "$(mtime_of "$1")"; cksum 2>/dev/null < "$1"; }

# remove_finished FILE KEY DIGEST — run under the claims lock, so a claim taken
# or a block written since the recompute counts: status 3 when a live session
# other than this one holds KEY, 4 when FILE changed since it read DIGEST, else
# rm's. The claim goes too once no listed copy of KEY is left, so a claim this
# session took never makes another session's next-step refuse the key.
remove_finished() {
  local held f key kind age claim
  held=$(claim_session "$2")
  if [ -n "$held" ] && [ "$held" != "$sid" ] && ! session_gone "$held"; then return 3; fi
  [ "$(digest_of "$1")" = "$3" ] || return 4
  rm -f -- "$1" || return 1
  while IFS=$'\t' read -r f key kind age claim; do
    [ "$key" = "$2" ] && [ -e "$f" ] && return 0
  done <<<"$handoffs"
  [ ! -f "$claims/$2" ] || rm -f -- "$claims/$2"
}

status_lines() { tr -d '\r' | grep -E '^\*\*(Status|Next):\*\*' | sed 's/^/- /'; }
stored_lines() { status_lines 2>/dev/null < "$1"; }
note_stale() { [ "$2" -le 1209600 ] || stale+="- $(session_age_text "$2") \`$1\`"$'\n'; }

# show_handoff FILE KEY KIND AGE CLAIM MINE — one handoff's lines; FILE goes
# on the stale list when it stays and is older than 14 days.
show_handoff() {
  local f=$1 key=$2 kind=$3 age=$4 claim=$5 mine=$6 line co out rc=0 rrc=0 reason first mtime since before
  listed=1
  line="- \`$f\` — key $key, kind $kind, $(session_age_text "$age") old, $claim"
  [ "$mine" -eq 0 ] || line="$line (this session's)"
  case $kind in
    plan|draft|complete|kept) ;;
    *)
      if [ "$mine" -eq 0 ]; then
        echo "$line"
        echo "- stored (kind $kind is not recomputed)"
        stored_lines "$f"
        note_stale "$f" "$age"
        return
      fi ;;
  esac
  before=$(digest_of "$f")
  if co=$(handoff_checkout "$f"); then
    # 60 s: a 1,000-row register fixture takes 24-27 s on Windows CI.
    out=$(cd "$co" && bash "$here/with-timeout" 60 bash "$here/next-step" --print --handoff "$f" 2>&1 </dev/null) || rc=$?
  else
    out="repo-audit: $f is in no checkout" rc=1
  fi
  case $rc in
    0)
      echo "$line"
      echo "- recomputed from the repository"
      status_lines <<<"$out"
      ;;
    6)
      reason=$(grep -m 1 '^next-step: ' <<<"$out" | sed 's/^next-step: //')
      reason=${reason:-nothing to resume}
      case $kind in
        plan|draft|complete|kept)
          if [ -d "$claims" ]; then dr_locked "$claims/" remove_finished "$f" "$key" "$before" || rrc=$?
          else remove_finished "$f" "$key" "$before" || rrc=$?; fi
          case $rrc in
            0) echo "- removed finished handoff $f — $reason"; return ;;
            3) echo "$line"; echo "- finished, kept while a live session claims it: $reason" ;;
            4) echo "$line"; echo "- finished, kept: it was rewritten during this audit ($reason)" ;;
            *) echo "$line"; echo "- finished, but it could not be removed: $reason" ;;
          esac
          stored_lines "$f" ;;
        *) echo "$line"; echo "- nothing to resume: $reason" ;;
      esac
      ;;
    *)
      first=$(grep -m 1 . <<<"$out")
      echo "$line"
      echo "- stored, not recomputed: ${first:-next-step exited $rc}"
      stored_lines "$f"
      ;;
  esac
  if [ "$mine" -eq 1 ]; then
    mtime=$(mtime_of "$f")
    since=$(git -C "$root" log -n 500 --format=%ct HEAD 2>/dev/null | awk -v t="$mtime" '$1 > t' | grep -c . || true)
    echo "- Commits on this checkout's HEAD since it was written: $since"
  fi
  note_stale "$f" "$age"
}

# A listing that fails or hangs is named, never read as "no handoffs".
list_rc=0
listing=$(bash "$here/with-timeout" 20 bash "$here/handoff" list "$root" 2>&1 </dev/null | tr -d '\r') || list_rc=$?
handoffs=$(grep $'\t' <<<"$listing")
if [ "$list_rc" -ne 0 ]; then
  listed=1
  first=$(grep -v $'\t' <<<"$listing" | grep -m 1 .)
  echo "- handoff list failed (exit $list_rc): ${first:-no message}; the handoffs below may be incomplete"
fi
own=""
if [ -n "$sid" ]; then
  own=$(while IFS=$'\t' read -r f key kind age claim; do
          [ -n "$f" ] || continue
          if [ "$(claim_session "$key")" = "$sid" ] || [ "$(marker_session "$f")" = "$sid" ]; then
            printf '%s\t%s\n' "$age" "$f"
          fi
        done <<<"$handoffs" | sort -n | head -n 1 | cut -f2-)
fi
if [ -n "$own" ]; then
  while IFS=$'\t' read -r f key kind age claim; do
    [ "$f" = "$own" ] && show_handoff "$f" "$key" "$kind" "$age" "$claim" 1
  done <<<"$handoffs"
fi
while IFS=$'\t' read -r f key kind age claim; do
  [ -n "$f" ] && [ "$f" != "$own" ] || continue
  show_handoff "$f" "$key" "$kind" "$age" "$claim" 0
done <<<"$handoffs"
while IFS=$'\t' read -r wt wprune; do
  wt=$(_dagents_path "$wt")
  [ -z "$wprune" ] && [ -d "$wt" ] || echo "- skipped \`$wt\`: prunable or missing"
done < <(git -C "$(dr_native_path "$root")" worktree list --porcelain 2>/dev/null | tr -d '\r' | awk '
  /^worktree / { if (p != "") print p "\t" pr; p = substr($0, 10); pr = ""; next }
  /^prunable/  { pr = "prunable"; next }
  END { if (p != "") print p "\t" pr }
')
[ "$listed" -eq 1 ] || echo "- none"

echo
echo "## Stale handoffs"
if [ -n "$stale" ]; then printf '%s' "$stale"; else echo "- none"; fi

echo
echo "## Compaction"
if [ -f "$root/CLAUDE.md" ] && grep -qiE '^#+[[:space:]]*compact instructions' < <(tr -d '\r' < "$root/CLAUDE.md"); then
  echo "- CLAUDE.md has a Compact Instructions section"
else
  echo "- CLAUDE.md has no Compact Instructions section — see reference/session-budget.md"
fi

echo
echo "## Recent commits"
git log -5 --oneline 2>/dev/null | sed 's/^/- /'
