#!/usr/bin/env bash
# Print the one next action — for a plan: start, resume, final review,
# finishing, next program sub-project, or nothing; for a design draft: its
# next step — as a "## Next session" block, and write the same block into the
# primary checkout's .superpowers/handoff/latest.md.
#
# Sessions end by pasting this block verbatim, so what comes next is computed
# here rather than remembered by the model: small executors reliably forget to
# say it, and a hand-written handoff goes stale the moment work moves on.
#
# Usage: next-step [--host claude|codex] [--complete] PLAN_FILE
#        next-step [--host claude|codex] --draft DRAFT_FILE --next ACTION
#        next-step [--host claude|codex] --adhoc --phase design|build --next ACTION
#   --complete  the plan is finished and its branch integrated; the ledger may
#               already be deleted. Replaces latest.md wholesale.
#   --draft     a design phase (brainstorming, a spec, a plan being written) is
#               handing off; DRAFT_FILE is the authority and ACTION names the
#               next step and its skill.
#   --adhoc     unplanned work (a chat-approved change or a punch list, with no
#               plan or draft file) is handing off; the notes in latest.md are
#               the authority. --phase design launches the planning model,
#               --phase build the execution model.
#   --host      which client the next session launches; default claude. A plan
#               states its own host in its header, so the flag serves the paths
#               that have no plan to read.
# Exit: 0 ok; 2 usage or missing file; 3 plan has no tasks; 4 block printed but
#       latest.md could not be written.
set -euo pipefail

# Failures print on stdout as well as stderr. A session that surfaces only
# stdout would otherwise get an empty result from the one script whose whole
# job is saying what happens next.
fail() { # fail EXIT MESSAGE
  printf 'next-step: %s\n' "$2"
  printf 'next-step: %s\n' "$2" >&2
  exit "$1"
}

usage() { fail 2 "usage: next-step [--host claude|codex] [--complete] PLAN_FILE | next-step [--host claude|codex] --draft DRAFT_FILE --next ACTION | next-step [--host claude|codex] --adhoc --phase design|build --next ACTION"; }
. "$(cd "$(dirname "$0")" && pwd)/lib/plan.sh"

# --host is pulled out wherever it sits so the remaining arguments keep their
# strict positional contract.
host=claude
hostless=()
while [ $# -gt 0 ]; do
  case $1 in
    --host)
      [ $# -ge 2 ] || usage
      case $2 in claude|codex) host=$2 ;; *) usage ;; esac
      shift 2
      ;;
    *) hostless+=("$1"); shift ;;
  esac
done
set -- ${hostless[@]+"${hostless[@]}"}

# The design tier writes specs and plans; the build tier executes them. Claude's
# pairs are its ladder's top execution rung and the subagent Execution default.
# The Codex pairs are the tiers this plugin's own policy already names: Astra
# high is where reference/codex-routing.json floors judges, and Sol high tops
# the execution policy in reference/ladder.md.
launch_for() { # launch_for design|build
  case $host:$1 in
    codex:design)  printf 'codex -m gpt-6-astra -c model_reasoning_effort=high' ;;
    codex:*)       printf 'codex -m gpt-5.6-sol -c model_reasoning_effort=high' ;;
    *:design)      printf 'claude --model opus --effort high' ;;
    *)             printf 'claude --model sonnet --effort high' ;;
  esac
}

complete=0 draft=0 adhoc=0 phase="" next_action=""
case "${1:-}" in
  --complete) complete=1; shift ;;
  --draft)
    draft=1; shift
    { [ $# -eq 3 ] && [ "$2" = "--next" ] && [ -n "$3" ]; } || usage
    next_action=$3
    set -- "$1"
    ;;
  --adhoc)
    adhoc=1; shift
    { [ $# -eq 4 ] && [ "$1" = "--phase" ] && [ "$3" = "--next" ] && [ -n "$4" ]; } || usage
    case $2 in design|build) phase=$2 ;; *) usage ;; esac
    next_action=$4
    ;;
esac

status_line="" next_line="" prompt="" launch=1 launch_cmd="" escalated_at=""

if [ "$adhoc" -eq 1 ]; then
  root=$(git rev-parse --show-toplevel 2>/dev/null) || fail 2 "not inside a git repository"
  primary=$(plan_primary_root "$root")
  dir=$primary
else
  [ $# -eq 1 ] || usage
  plan=$1
  [ -f "$plan" ] || fail 2 "no such file: $plan — run it from the repository root, or check the plan path"
  repo_err=$(plan_require_same_repo "$plan" 2>&1) || fail 2 "${repo_err#next-step: }"

  root=$(git rev-parse --show-toplevel 2>/dev/null) || fail 2 "not inside a git repository"
  primary=$(plan_primary_root "$root")
  dir=$primary

  plan_canon=$(plan_repo_canon "$plan") || fail 2 "not inside a git repository"
  rel=${plan_canon#"$root"/}
  slug=$(basename "$plan" .md)
fi

if [ "$adhoc" -eq 1 ]; then
  case $next_action in *[.!?]) ;; *) next_action="$next_action." ;; esac
  status_line="Unplanned work: the notes in \`.superpowers/handoff/latest.md\` are the authority."
  next_line=$next_action
  launch_cmd=$(launch_for "$phase")
  prompt="Continue the unplanned work recorded in \`.superpowers/handoff/latest.md\`: $next_action"
  if [ "$root" != "$primary" ]; then
    prompt="$prompt First enter the existing worktree \`$root\`."
  fi
elif [ "$draft" -eq 1 ]; then
  case $next_action in *[.!?]) ;; *) next_action="$next_action." ;; esac
  status_line="Design in progress: \`$rel\` is the authority."
  next_line=$next_action
  launch_cmd=$(launch_for design)
  prompt="Continue from \`$rel\` (the authority): $next_action Read \`.superpowers/handoff/latest.md\` first."
else
  tasks=$(plan_tasks "$plan")
  [ -n "$tasks" ] || fail 3 "no tasks in ${plan} (no heading matching 'Task N')"
  total=$(wc -l <<<"$tasks" | tr -d ' ')

  execution=$(plan_header_line "$plan" Execution)
  program=$(plan_header_line "$plan" Program)

  # A Codex plan states its host in the header and its native pair on the
  # Execution line; the flag is for the paths with no plan to read.
  if grep -qE '^(\*\*)?Host:(\*\*)?[ \t]+codex[ \t]*$' <<<"$(plan_header "$plan")"; then host=codex; fi

  launch_cmd=$(grep -oE 'claude --model [^ `]+ --effort [^ `]+' <<<"$execution" | head -n 1 || true)
  if [ -z "$launch_cmd" ]; then
    pair=$(grep -oE 'codex [a-z0-9.-]+ / [a-z]+' <<<"$execution" | head -n 1 || true)
    [ -z "$pair" ] || launch_cmd="codex -m $(awk '{ print $2 }' <<<"$pair") -c model_reasoning_effort=$(awk '{ print $4 }' <<<"$pair")"
  fi
  skill=subagent-driven-development
  if grep -qE '^\*\*Execution:\*\*[ \t]*`?inline' <<<"$execution"; then skill=executing-plans; fi

  ledger_file="$root/.superpowers/sdd/$slug/progress.md"
  ledger_note="no ledger at \`$ledger_file\`"
  ledger_text=""
  done_tasks=""
  blocked_tasks=""
  has_ledger=0
  if [ "$complete" -eq 0 ] && [ -f "$ledger_file" ]; then
    ledger_text=$(tr -d '\r' < "$ledger_file")
    # The identity line may carry the path as given on the command line: relative
    # to the checkout, absolute, or in Windows form. Compare resolved paths.
    ledger_plan_path=$(ledger_plan "$ledger_file")
    if command -v cygpath >/dev/null 2>&1 && [ -n "$ledger_plan_path" ]; then
      ledger_plan_path=$(cygpath -u "$ledger_plan_path" 2>/dev/null || printf '%s' "$ledger_plan_path")
    fi
    case $ledger_plan_path in /*) ;; *) ledger_plan_path="$root/$ledger_plan_path" ;; esac
    if [ "$(plan_repo_canon "$ledger_plan_path" 2>/dev/null)" = "$plan_canon" ]; then
      has_ledger=1
      ledger_note="ledger \`$ledger_file\`"
      done_tasks=$(ledger_done "$ledger_file")
      blocked_tasks=$(ledger_blocked "$ledger_file")
      # A ledger outranks the Execution line on which mode the run is in: a
      # switch is recorded there and the plan is never edited. The escalation
      # holds until a later inline assignment shows the plan came back.
      escalated_at=$(ledger_left_inline "$ledger_file")
    else
      ledger_note="the ledger at \`$ledger_file\` belongs to another plan and is ignored"
    fi
  fi

  if [ "$complete" -eq 1 ]; then
    spec=$(sed -E 's/^\*\*Program:\*\*[ \t]*`?([^` \t]+)`?.*/\1/' <<<"$program")
    k=$(grep -oE 'sub-project [0-9]+ of [0-9]+' <<<"$program" | head -n 1 | awk '{print $2}' || true)
    n=$(grep -oE 'sub-project [0-9]+ of [0-9]+' <<<"$program" | head -n 1 | awk '{print $4}' || true)
    next_title=$(sed -nE 's/.*( — | – | - | -- )next:[ \t]*(.*[^ \t])[ \t]*$/\2/p' <<<"$program")
    launch=0
    if [ -z "$program" ]; then
      status_line="Plan \`$rel\` is complete."
      next_line="Nothing — the plan records no follow-on work."
    elif grep -qE '( — | – | - | -- )last[ \t]*$' <<<"$program" || { [ -n "$k" ] && [ "$k" -ge "$n" ]; }; then
      status_line="Plan \`$rel\` is complete${k:+; sub-project $k of $n is done}."
      next_line="Nothing — every sub-project of \`$spec\` is done."
    elif [ -n "$next_title" ] && [ -n "$k" ]; then
      k1=$((k + 1))
      status_line="Plan \`$rel\` is complete; sub-project $k of $n is done."
      next_line="Sub-project $k1 ($next_title): write its spec in a fresh session."
      launch_cmd=$(launch_for design)
      prompt="Start sub-project $k1 ($next_title) of the program in \`$spec\`: use dr-superpowers:brainstorming to write its spec."
      launch=1
    else
      status_line="Plan \`$rel\` is complete."
      next_line="Read \`$spec\` for the sub-project after ${k:-this one} — the plan's Program line names no next step."
    fi
  else
    first_open="" open_title="" done_count=0
    while IFS=$'\t' read -r num title; do
      if grep -qx "$num" <<<"$done_tasks"; then
        done_count=$((done_count + 1))
      elif [ -z "$first_open" ]; then
        first_open=$num open_title=$title
      fi
    done <<<"$tasks"

    blocked_num=$(head -n 1 <<<"$blocked_tasks")
    if [ -n "$blocked_num" ]; then
      # BLOCKED is terminal: the next session must not be told to start the
      # task. The line's last dash-separated field names what a human must
      # decide (`BLOCKED — <who> — <decision>`).
      blocked_why=$(grep -E "^Task ${blocked_num}: BLOCKED" <<<"$ledger_text" | tail -n 1 \
        | awk -F' (—|-) ' '{ sub(/[ \t]+$/, "", $NF); print $NF }')
      status_line="Plan \`$rel\`: $done_count of $total tasks complete; Task $blocked_num is BLOCKED ($ledger_note)."
      next_line="Your human partner decides: ${blocked_why:-see the BLOCKED line in the ledger}. Record the ruling in the ledger, then run next-step again."
      launch=0
    elif [ -z "$first_open" ]; then
      if [ "$has_ledger" -eq 1 ] && grep -q '^Final review: clean' <<<"$ledger_text"; then
        status_line="Plan \`$rel\`: all $total tasks complete; the final review is clean."
        next_line="Run dr-superpowers:finishing-a-development-branch."
      else
        status_line="Plan \`$rel\`: all $total tasks complete."
        next_line="Run the final whole-branch review, then dr-superpowers:finishing-a-development-branch."
      fi
    elif [ "$done_count" -eq 0 ]; then
      status_line="Plan \`$rel\`: 0 of $total tasks complete ($ledger_note)."
      next_line="Start at Task $first_open ($open_title)."
    else
      status_line="Plan \`$rel\`: $done_count of $total tasks complete ($ledger_note)."
      next_line="Resume at Task $first_open ($open_title)."
    fi

    if [ -n "$escalated_at" ] && [ "$launch" -eq 1 ]; then
      launch_cmd=$(launch_for build)
      next_line="$next_line This plan escalated to subagent mode at Task $escalated_at."
    fi

    # With a ledger there is state to verify before continuing, which is
    # resume-execution's job; without one the plan simply starts.
    if [ "$launch" -eq 0 ]; then
      prompt=""
    elif [ "$has_ledger" -eq 1 ]; then
      prompt="Resume \`$rel\` with dr-superpowers:resume-execution. $next_line"
    else
      prompt="Continue \`$rel\` with dr-superpowers:$skill. $next_line"
    fi
    if [ "$root" != "$primary" ]; then
      prompt="$prompt First enter the existing worktree \`$root\`."
    fi
    if [ "$has_ledger" -eq 1 ]; then
      prompt="$prompt Progress ledger: \`$ledger_file\` — trust its \`Task N: complete\` lines."
    fi
  fi
fi

block=$(
  printf '## Next session\n\n**Status:** %s\n**Next:** %s\n' "$status_line" "$next_line"
  if [ "$launch" -eq 1 ]; then
    if [ -n "$launch_cmd" ]; then
      printf '\nLaunch in `%s`:\n\n```\n%s\n```\n' "$dir" "$launch_cmd"
    else
      printf '\nLaunch: see the **Execution:** line in `%s`.\n' "$rel"
    fi
    printf '\nPaste as the first prompt:\n\n```\n%s\n```\n' "$prompt"
  fi
)
printf '%s\n' "$block"

handoff="$primary/.superpowers/handoff/latest.md"
today=$(date -u +%Y-%m-%d)
write_handoff() {
  mkdir -p "$(dirname "$handoff")" || return 1
  if [ "$complete" -eq 1 ] || [ ! -f "$handoff" ]; then
    printf '# Handoff — %s\n\n%s\n' "$today" "$block" > "$handoff.tmp" || return 1
  else
    # Replace only the Next session section; the rest is the session's own notes.
    BLOCK="$block" awk '
      /^## Next session[ \t\r]*$/ { print ENVIRON["BLOCK"]; skip = 1; found = 1; next }
      skip && /^## / { skip = 0; print "" }
      !skip { print }
      END { if (!found) { print ""; print ENVIRON["BLOCK"] } }
    ' "$handoff" > "$handoff.tmp" || return 1
  fi
  mv "$handoff.tmp" "$handoff"
}
if ! write_handoff 2>/dev/null; then
  rm -f "$handoff.tmp" 2>/dev/null || true
  fail 4 "could not write $handoff — copy the block above into it by hand"
fi
