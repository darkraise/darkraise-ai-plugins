#!/usr/bin/env bash
# Summarise where a test suite spends its time, from the JUnit XML reports its
# runners already emit, so dr-superpowers:test-simplifier reads a short table
# instead of the raw reports.
#
# Usage: test-profile [--top N] [--layer NAME=ERE]... [--brief] <report.xml|dir>...
# Exit: 0 ok; 2 usage, or no test case found in the reports.
#   --top N           rows in the slowest-files and slowest-tests tables (default 15).
#   --layer NAME=ERE  classify a test into NAME when its lowercased file or class
#                     path matches ERE. Repeatable, tried in order; unmatched
#                     tests are `other`. Without it: e2e, integration, unit.
#   --brief           print one line of totals, for a before/after ledger row.
# A directory is searched recursively for *.xml.
set -uo pipefail

usage() { echo "usage: test-profile [--top N] [--layer NAME=ERE]... [--brief] <report.xml|dir>..." >&2; exit 2; }

top=15 brief=0 layers="" inputs=()
while [ $# -gt 0 ]; do
  case "$1" in
    --top) [ $# -ge 2 ] && [[ "$2" =~ ^[1-9][0-9]*$ ]] || usage; top=$2; shift 2 ;;
    --layer) [ $# -ge 2 ] && [[ "$2" == ?*=?* ]] || usage; layers+="$2"$'\n'; shift 2 ;;
    --brief) brief=1; shift ;;
    -*) usage ;;
    *) inputs+=("$1"); shift ;;
  esac
done
[ ${#inputs[@]} -gt 0 ] || usage

files=()
for p in "${inputs[@]}"; do
  if [ -d "$p" ]; then
    while IFS= read -r f; do files+=("$f"); done < <(find "$p" -type f -name '*.xml' | LC_ALL=C sort)
  elif [ -f "$p" ]; then files+=("$p")
  else echo "test-profile: no such file or directory: $p" >&2; exit 2
  fi
done
[ ${#files[@]} -gt 0 ] || { echo "test-profile: no *.xml report found" >&2; exit 2; }

rows=$(mktemp) || exit 2
trap 'rm -f "$rows"' EXIT

# Pass 1: one TSV row per test case — case, seconds, status, flaky, layer, file, id —
# plus one `overhead` row per leaf suite whose own time exceeds its cases' sum
# (suite-level setup and teardown that no test case is charged for).
LAYERS="$layers" awk -v RS='<' '
function attr(tag, n,   v) {
  if (match(tag, "[ \t\r\n]" n "=\"[^\"]*\"")) { v = substr(tag, RSTART + length(n) + 3, RLENGTH - length(n) - 4) }
  else if (match(tag, "[ \t\r\n]" n "='"'"'[^'"'"']*'"'"'")) { v = substr(tag, RSTART + length(n) + 3, RLENGTH - length(n) - 4) }
  else return ""
  gsub(/&lt;/, "<", v); gsub(/&gt;/, ">", v); gsub(/&quot;/, "\"", v); gsub(/&apos;/, "'"'"'", v); gsub(/&amp;/, "\\&", v)
  gsub(/[\t\r\n]/, " ", v)
  return v
}
function num(v) { return (v ~ /^[0-9]*\.?[0-9]+([eE][-+]?[0-9]+)?$/) ? v + 0 : 0 }
function layer(path,   p, i) {
  p = tolower(path)
  if (nl > 0) { for (i = 1; i <= nl; i++) if (p ~ lre[i]) return lname[i]; return "other" }
  if (p ~ /(^|[\/._-])(e2e|end-to-end|endtoend|acceptance|playwright|cypress|ui-?tests?)([\/._-]|$)/) return "e2e"
  if (p ~ /(^|[\/._-])(integration|integ|it|functional|api-?tests?)([\/._-]|$)/) return "integration"
  return "unit"
}
function emit() {
  print "case\t" ct "\t" cs "\t" cf "\t" layer(cp) "\t" cp "\t" cid
  if (d > 0) { sum[d] += ct; has[d] = 1 }
  open = 0
}
BEGIN {
  n = split(ENVIRON["LAYERS"], spec, "\n"); nl = 0
  for (i = 1; i <= n; i++) if (spec[i] != "") { j = index(spec[i], "="); nl++; lname[nl] = substr(spec[i], 1, j - 1); lre[nl] = substr(spec[i], j + 1) }
}
{
  e = index($0, ">"); if (e == 0) next
  tag = substr($0, 1, e - 1)
  self = (substr(tag, length(tag), 1) == "/")
  split(tag, w, /[ \t\r\n\/]/); name = w[1]
  if (name == "" && substr(tag, 1, 1) == "/") { split(substr(tag, 2), w, /[ \t\r\n]/); name = "/" w[1] }
  if (name == "testsuite") {
    if (open) emit()
    d++; st[d] = num(attr(tag, "time")); sum[d] = 0; has[d] = 0
    if (self) d--
  } else if (name == "/testsuite") {
    if (open) emit()
    if (d > 0) { if (has[d] && st[d] > sum[d]) printf "overhead\t%.6f\n", st[d] - sum[d]; d-- }
  } else if (name == "testcase") {
    if (open) emit()
    cn = attr(tag, "name"); cc = attr(tag, "classname"); fl = attr(tag, "file")
    cp = (fl != "") ? fl : cc
    if (fl == "" && cc !~ /\//) gsub(/\./, "/", cp)
    cid = (cc != "" ? cc : fl) "::" cn
    ct = num(attr(tag, "time")); cs = "pass"; cf = 0; open = 1
    if (self) emit()
  } else if (open && (name == "failure" || name == "error")) { cs = "fail" }
  else if (open && name == "skipped") { if (cs == "pass") cs = "skip" }
  else if (open && name ~ /^(flaky|rerun)(Failure|Error)$|^rerun$/) { cf = 1 }
  else if (name == "/testcase") { if (open) emit() }
}
END { if (open) emit() }
' "${files[@]}" > "$rows"

grep -q '^case' "$rows" || { echo "test-profile: no <testcase> found in ${#files[@]} report(s)" >&2; exit 2; }

# Pass 2: summarise.
LC_ALL=C sort -t $'\t' -k1,1 -k2,2gr "$rows" | awk -F '\t' -v top="$top" -v brief="$brief" -v nfiles="${#files[@]}" '
function dur(s,   h, m) {
  if (s < 60) return sprintf("%.1fs", s)
  h = int(s / 3600); m = int((s - h * 3600) / 60)
  return (h > 0) ? sprintf("%dh %02dm %02ds", h, m, int(s - h * 3600 - m * 60)) : sprintf("%dm %02ds", m, int(s - m * 60))
}
function pct(a, b) { return (b > 0) ? sprintf("%d%%", a * 100 / b + 0.5) : "0%" }
function cell(s) { gsub(/\|/, "\\|", s); return s }
$1 == "overhead" { over += $2; next }
$1 == "case" {
  n++; t = $2; total += t; time[n] = t
  if ($3 == "fail") fails++; else if ($3 == "skip") skips++
  if ($4 == 1) flaky++
  if (seen[$7]++ == 1) reran++
  if (!($5 in lt)) lorder[++nlay] = $5
  lc[$5]++; lt[$5] += t
  if (!($6 in ft)) forder[++nfile] = $6
  fc[$6]++; ft[$6] += t
  if (n <= top) { tid[n] = $7; tlay[n] = $5; tt[n] = t }
}
END {
  k = int(n / 10); if (k < 1) k = 1
  for (i = 1; i <= k; i++) slow += time[i]
  if (brief) {
    printf "tests=%d time=%.1fs overhead=%.1fs slowest10pct=%s fail=%d skip=%d flaky=%d reran=%d\n", n, total, over, pct(slow, total), fails, skips, flaky, reran
    exit
  }
  print "# Test profile"
  print ""
  printf "- Reports: %d; test cases: %d\n", nfiles, n
  printf "- Time in test cases: %s; suite time outside any case (setup, teardown): %s\n", dur(total), dur(over)
  printf "- The slowest 10%% of cases (%d) take %s of case time\n", k, pct(slow, total)
  printf "- Failed %d, skipped %d, flaky or retried %d, ran more than once %d\n", fails, skips, flaky, reran
  print ""
  print "## By layer"
  print ""
  print "| Layer | Tests | Time | Share |"
  print "|---|---:|---:|---:|"
  for (i = 1; i <= nlay; i++) { l = lorder[i]; printf "| %s | %d | %s | %s |\n", l, lc[l], dur(lt[l]), pct(lt[l], total) }
  # Files, slowest first: selection by repeated max is fine at top <= a few dozen.
  print ""
  printf "## Slowest files (top %d of %d)\n\n", (top < nfile ? top : nfile), nfile
  print "| File | Tests | Time | Share |"
  print "|---|---:|---:|---:|"
  for (r = 1; r <= top && r <= nfile; r++) {
    best = 0
    for (i = 1; i <= nfile; i++) if (!(forder[i] in done) && (best == 0 || ft[forder[i]] > ft[forder[best]])) best = i
    f = forder[best]; done[f] = 1
    printf "| %s | %d | %s | %s |\n", cell(f), fc[f], dur(ft[f]), pct(ft[f], total)
  }
  print ""
  printf "## Slowest tests (top %d)\n\n", (top < n ? top : n)
  print "| Test | Layer | Time |"
  print "|---|---|---:|"
  for (i = 1; i <= top && i <= n; i++) printf "| %s | %s | %s |\n", cell(tid[i]), tlay[i], dur(tt[i])
}
'
