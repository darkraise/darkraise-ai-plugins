{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "task_id", "root", "gitdir", "repository", "initial_base", "expected_head", "write_set", "model", "effort", "thread", "attempts", "review_rounds", "processes", "phase", "prior_phase", "history", "pending", "candidate", "artifacts"],
  "properties": {
    "version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "root": {"type": "string", "minLength": 1},
    "gitdir": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "initial_base": {"type": "string", "minLength": 1},
    "expected_head": {"type": "string", "minLength": 1},
    "write_set": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "model": {"type": ["string", "null"]},
    "effort": {"type": ["string", "null"]},
    "thread": {"type": ["string", "null"]},
    "attempts": {"type": "array", "items": {"type": "object"}},
    "review_rounds": {"type": "integer", "minimum": 0},
    "processes": {"type": "array", "items": {"type": "object"}},
    "phase": {"enum": ["ready", "running", "pending", "committing", "complete", "handed-back", "blocked"]},
    "prior_phase": {"type": ["string", "null"]},
    "history": {"type": "array", "items": {"type": "object"}},
    "pending": {"type": ["object", "null"]},
    "candidate": {"type": ["object", "null"]},
    "artifacts": {"type": "object"}
  }
}
